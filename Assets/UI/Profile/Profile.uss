/* ============================================================
   Profile — landscape three-region redesign (identity / capability radar /
   current journey), sharing the app's top nav visual system (".map-topbar",
   see Map/Map.uss, linked into this screen in MikeyApp.uxml) instead of its
   own bottom dock. Read-only frontend mock data throughout — every number
   here is centralized in ProfileController, not computed (see that file's
   header comment for the exact REAL vs PLACEHOLDER split).
   ============================================================ */

/* ---------- full-bleed background ----------
   The supplied final art (profile_background.jpg) IS the background now —
   no generated decorative glow/enso shapes. background-color is only a
   fallback in case the image fails to load; -unity-background-scale-mode
   "scale-and-crop" is a cover-fit (fills the box, preserves aspect ratio,
   never stretches), matching every other full-bleed media surface in this
   app (see theme.uss ".bg-media"). */
.profile-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    background-image: url("/Assets/UI/Media/Images/Profile/profile_background.jpg");
    -unity-background-scale-mode: scale-and-crop;
}
/* Subtle legibility scrim — the source art is already mostly near-black in
   the center where content sits, so this only needs to be light. */
.profile-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 12, 0.3);
}

/* ---------- three-region layout ----------
   Top offset clears the shared ".map-topbar" (Map.uss, ~84px) the same way
   Techniques' own layout does. Lots of intentional dark space between
   columns rather than a grid of small cards. */
.profile-layout {
    flex-grow: 1;
    width: 100%;
    max-width: 1680px;
    align-self: center;
    flex-direction: row;
    align-items: stretch;
    padding-top: 108px;
}
.profile-column {
    flex-direction: column;
    min-width: 0;
}
.profile-column--identity {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 420px;
    justify-content: center;
    padding-right: 36px;
}
.profile-column--radar {
    flex-grow: 2;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
}
.profile-column--journey {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 420px;
    justify-content: center;
    padding-left: 36px;
    border-left-width: 1px;
    border-left-color: rgba(237, 230, 216, 0.1);
}

/* ---------- LEFT: identity / progression ---------- */
.profile-kicker {
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--crimson);
}
.profile-name {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--bone);
    margin-top: 4px;
    white-space: normal;
}
.profile-role-row {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 10px;
}
.profile-role {
    font-size: 22px;
    color: var(--muted);
}
.profile-role-level {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: var(--crimson);
}

.profile-xp-bar {
    height: 14px;
    border-radius: 7px;
    background-color: rgba(15, 10, 10, 0.4);
    border-width: 1px;
    border-color: var(--line);
    margin-top: 16px;
    overflow: hidden;
}
.profile-xp-bar__fill {
    width: 64%;
    height: 100%;
    border-radius: 7px;
    background-color: var(--crimson-deep);
}
.profile-xp-label {
    font-size: 18px;
    color: var(--muted);
    margin-top: 8px;
    align-self: flex-end;
}

.profile-identity-facts {
    flex-direction: column;
    margin-top: 28px;
}
.profile-identity-fact {
    padding: 12px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(237, 230, 216, 0.1);
}
.profile-identity-fact__text {
    font-size: 20px;
    color: rgba(237, 230, 216, 0.85);
    white-space: normal;
}

/* ---------- CENTER: capability radar (hero element) ---------- */
.profile-radar-mount {
    width: 100%;
    height: 100%;
    min-width: 440px;
    min-height: 440px;
    max-width: 620px;
    max-height: 620px;
    align-self: center;
}

/* Applied by ProfileRadarChart to the five Label vertices it positions
   itself (absolute, centered on each computed vertex anchor point). Clean,
   flat off-white text — no text-shadow/glow and no bold weight, so these
   never read as "neon"; the only glow in this region belongs to the red
   polygon itself (see ProfileRadarChart's Glow* colors). */
.profile-radar-label {
    position: absolute;
    font-size: 20px;
    -unity-font-style: normal;
    letter-spacing: 0.5px;
    color: var(--bone);
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.profile-radar-label--value {
    font-size: 15px;
    -unity-font-style: normal;
    color: var(--muted);
}

/* ---------- RIGHT: current journey ---------- */
.profile-section-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--bone);
    white-space: normal;
}
.profile-section-title--spaced {
    margin-top: 30px;
}
.profile-section-title--muted {
    color: var(--muted);
    font-size: 22px;
}

.profile-journey-kicker {
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 10px;
}
.profile-journey-row {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 4px;
}
.profile-journey-value {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--bone);
}
.profile-journey-meta {
    font-size: 16px;
    color: var(--muted);
}
.profile-journey-bar {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(15, 10, 10, 0.4);
    border-width: 1px;
    border-color: var(--line);
    margin-top: 12px;
    overflow: hidden;
}
.profile-journey-bar__fill {
    width: 16%;
    height: 100%;
    border-radius: 4px;
    background-color: var(--crimson);
}

.profile-training-list {
    flex-direction: column;
    margin-top: 12px;
}
.profile-training-item {
    font-size: 19px;
    color: rgba(237, 230, 216, 0.85);
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(237, 230, 216, 0.08);
    white-space: normal;
}

.profile-milestone-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--jade);
    margin-top: 6px;
    white-space: normal;
}

/* ---------- attribute guide ----------
   Compact explanation of the five radar metrics — a single wrapping row of
   short name/description pairs beneath the three-region layout, not five
   separate cards. */
.profile-attribute-guide {
    width: 100%;
    max-width: 1680px;
    align-self: center;
    padding-top: 16px;
    margin-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(237, 230, 216, 0.1);
}
.profile-attribute-guide__title {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--muted);
}
.profile-attribute-guide__list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}
.profile-attribute-guide__item {
    flex-direction: row;
    align-items: baseline;
    flex-grow: 1;
    flex-basis: 300px;
    min-width: 0;
    padding: 3px 18px 3px 0;
}
.profile-attribute-guide__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--crimson);
    margin-right: 8px;
    flex-shrink: 0;
}
.profile-attribute-guide__desc {
    font-size: 14px;
    color: var(--muted);
    white-space: normal;
    flex-shrink: 1;
    min-width: 0;
}
