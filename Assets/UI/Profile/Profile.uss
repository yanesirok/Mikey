/* ============================================================
   Profile — landscape three-region redesign (identity / capability radar /
   current journey), sharing the app's top nav visual system (".map-topbar",
   see Map/Map.uss, linked into this screen in MikeyApp.uxml) instead of its
   own bottom dock. Read-only frontend mock data throughout — every number
   here is centralized in ProfileController, not computed (see that file's
   header comment for the exact REAL vs PLACEHOLDER split).
   ============================================================ */

/* ---------- full-bleed background ----------
   The supplied final art (profile_background.jpg) IS the background now —
   no generated decorative glow/enso shapes. background-color is only a
   fallback in case the image fails to load; -unity-background-scale-mode
   "scale-and-crop" is a cover-fit (fills the box, preserves aspect ratio,
   never stretches), matching every other full-bleed media surface in this
   app (see theme.uss ".bg-media"). */
.profile-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    background-image: url("/Assets/UI/Media/Images/Profile/profile_background.jpg");
    -unity-background-scale-mode: scale-and-crop;
}
/* Subtle legibility scrim — the source art is already mostly near-black in
   the center where content sits, so this only needs to be light. */
.profile-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 12, 0.3);
}

/* ---------- three-region layout ----------
   Top offset clears the shared ".map-topbar" (Map.uss, ~84px) the same way
   Techniques' own layout does. Lots of intentional dark space between
   columns rather than a grid of small cards. */
.profile-layout {
    flex-grow: 1;
    width: 100%;
    max-width: 1680px;
    align-self: center;
    flex-direction: row;
    align-items: stretch;
    padding-top: 108px;
}
.profile-column {
    flex-direction: column;
    min-width: 0;
}
.profile-column--identity {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 420px;
    justify-content: center;
    padding-right: 36px;
}
.profile-column--radar {
    flex-grow: 2;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
}
.profile-column--journey {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 420px;
    justify-content: center;
    padding-left: 36px;
    border-left-width: 1px;
    border-left-color: rgba(237, 230, 216, 0.1);
}

/* ---------- LEFT: identity / progression ---------- */
.profile-kicker {
    font-size: 22px;
    letter-spacing: 3px;
    color: var(--crimson);
}
.profile-name-row {
    flex-direction: row;
    align-items: center;
}
.profile-name {
    font-size: 49px;
    -unity-font-style: bold;
    color: var(--bone);
    margin-top: 4px;
    white-space: normal;
}
/* Edit affordance next to the username — reuses the supplied edit_icon.png
   as-is (pencil is already crimson in the source art; its clipboard body is
   pure black and simply reads as invisible against the dark HUD, which is
   fine — the pencil alone is a standard, recognizable "edit" glyph). Button
   box is a full ".tap-target" (>=48px) even though the visible icon is much
   smaller, so it never dominates the identity area. */
.profile-name-edit-btn {
    margin-left: 8px;
    margin-top: 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}
.profile-name-edit-icon {
    width: 22px;
    height: 22px;
    background-image: url("/Assets/UI/Media/Images/edit_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}
.profile-name-edit-btn:hover .profile-name-edit-icon {
    opacity: 0.75;
}
.profile-role-row {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 10px;
}
.profile-role {
    font-size: 24px;
    color: var(--muted);
}
.profile-role-level {
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: var(--crimson);
}

.profile-xp-bar {
    height: 14px;
    border-radius: 7px;
    background-color: rgba(15, 10, 10, 0.4);
    border-width: 1px;
    border-color: var(--line);
    margin-top: 16px;
    overflow: hidden;
}
.profile-xp-bar__fill {
    width: 64%;
    height: 100%;
    border-radius: 7px;
    background-color: var(--crimson-deep);
}
.profile-xp-label {
    font-size: 20px;
    color: var(--muted);
    margin-top: 8px;
    align-self: flex-end;
}

.profile-identity-facts {
    flex-direction: column;
    margin-top: 28px;
}
.profile-identity-fact {
    padding: 12px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(237, 230, 216, 0.1);
}
.profile-identity-fact__text {
    font-size: 22px;
    color: rgba(237, 230, 216, 0.85);
    white-space: normal;
}

/* ---------- CENTER: capability radar (hero element) ---------- */
.profile-radar-mount {
    width: 100%;
    height: 100%;
    min-width: 440px;
    min-height: 440px;
    max-width: 620px;
    max-height: 620px;
    align-self: center;
}

/* Applied by ProfileRadarChart to the five Label vertices it positions
   itself (absolute, centered on each computed vertex anchor point). Clean,
   flat off-white text — no text-shadow/glow and no bold weight, so these
   never read as "neon"; the only glow in this region belongs to the red
   polygon itself (see ProfileRadarChart's Glow* colors). */
.profile-radar-label {
    position: absolute;
    font-size: 22px;
    -unity-font-style: normal;
    letter-spacing: 0.5px;
    color: var(--bone);
    -unity-text-align: middle-center;
    white-space: nowrap;
}
/* Made noticeably stronger than the axis names (24px vs 22px, off-white
   vs off-white but bold vs normal) since these numbers were reading as too
   secondary — still zero glow/shadow, matching the axis labels above. */
.profile-radar-label--value {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--bone);
}

/* ---------- RIGHT: current journey ---------- */
.profile-section-title {
    font-size: 29px;
    -unity-font-style: bold;
    color: var(--bone);
    white-space: normal;
}
.profile-section-title--spaced {
    margin-top: 30px;
}
.profile-section-title--muted {
    color: var(--muted);
    font-size: 24px;
}

.profile-journey-kicker {
    font-size: 20px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 10px;
}
.profile-journey-row {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 4px;
}
.profile-journey-value {
    font-size: 31px;
    -unity-font-style: bold;
    color: var(--bone);
}
.profile-journey-meta {
    font-size: 18px;
    color: var(--muted);
}
.profile-journey-bar {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(15, 10, 10, 0.4);
    border-width: 1px;
    border-color: var(--line);
    margin-top: 12px;
    overflow: hidden;
}
.profile-journey-bar__fill {
    width: 16%;
    height: 100%;
    border-radius: 4px;
    background-color: var(--crimson);
}

.profile-training-list {
    flex-direction: column;
    margin-top: 12px;
}
.profile-training-item {
    font-size: 21px;
    color: rgba(237, 230, 216, 0.85);
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(237, 230, 216, 0.08);
    white-space: normal;
}

.profile-milestone-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--jade);
    margin-top: 6px;
    white-space: normal;
}

/* ---------- shared Profile-local popup shell ----------
   Used by both the Attribute Details popup and the Username edit popup —
   neither is a new screen id (see ProfileController): a full-screen overlay
   toggled by ".profile-popup--open", scrim declared before the card so a tap
   lands on the card when over it and the scrim everywhere else (same
   technique as Map's ".map-outside-catcher"). Heavily-tinted dark glass with
   a subtle crimson edge — never a generic white card, never five separate
   cards for the attribute list. */
.profile-popup {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}
.profile-popup--open {
    display: flex;
}
.profile-popup__scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
}
.profile-popup__card {
    background-color: rgba(7, 7, 9, 0.97);
    border-width: 1px;
    border-color: rgba(198, 40, 40, 0.4);
    border-radius: 18px;
    padding: 40px 44px;
}
.profile-popup__card--wide {
    width: 78%;
    max-width: 980px;
}
.profile-popup__card--narrow {
    width: 50%;
    min-width: 380px;
    max-width: 520px;
}
.profile-popup__title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
    text-shadow: 0 0 12px rgba(198, 40, 40, 0.35);
    margin-bottom: 24px;
}
.profile-popup__title--compact {
    font-size: 26px;
    margin-bottom: 18px;
    text-shadow: none;
}
.profile-popup__close,
.profile-popup__primary-btn,
.profile-popup__secondary-btn {
    align-self: center;
    min-width: 160px;
    height: 54px;
    padding: 0 28px;
    border-radius: 8px;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
}
.profile-popup__close {
    margin-top: 28px;
    border-width: 1px;
    border-color: rgba(237, 230, 216, 0.25);
    background-color: rgba(237, 230, 216, 0.06);
    color: var(--bone);
}
.profile-popup__close:hover {
    border-color: var(--bone);
    background-color: rgba(237, 230, 216, 0.12);
}
.profile-popup__secondary-btn {
    border-width: 1px;
    border-color: rgba(237, 230, 216, 0.25);
    background-color: rgba(237, 230, 216, 0.06);
    color: var(--bone);
    margin-right: 16px;
}
.profile-popup__secondary-btn:hover {
    border-color: var(--bone);
    background-color: rgba(237, 230, 216, 0.12);
}
.profile-popup__primary-btn {
    border-width: 1px;
    border-color: var(--crimson);
    background-color: var(--crimson);
    color: var(--bone);
}
.profile-popup__primary-btn:hover {
    background-color: var(--crimson-deep);
}

/* ---------- attribute details popup content ---------- */
.profile-attribute-popup__grid {
    flex-direction: row;
    flex-wrap: wrap;
}
.profile-attribute-popup__entry {
    flex-basis: 45%;
    flex-grow: 1;
    min-width: 320px;
    padding: 10px 20px 10px 0;
}
.profile-attribute-popup__name {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--crimson);
    margin-bottom: 4px;
}
.profile-attribute-popup__desc {
    font-size: 18px;
    color: rgba(237, 230, 216, 0.85);
    white-space: normal;
}

/* ---------- username edit popup content ---------- */
.profile-username-edit__field {
    margin-top: 6px;
    font-size: 22px;
}
.profile-username-edit__field .unity-base-field__input {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(237, 230, 216, 0.2);
    border-radius: 8px;
    padding: 10px 14px;
    color: var(--bone);
}
.profile-username-edit__error {
    display: none;
    font-size: 15px;
    color: var(--crimson);
    margin-top: 8px;
}
.profile-username-edit__error--visible {
    display: flex;
}
.profile-username-edit__actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 24px;
}
