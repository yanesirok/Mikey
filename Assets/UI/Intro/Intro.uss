/* ============================================================
   Lore — landscape cold-open ("intro" screen) styles.
   Palette custom properties (--ember, --bone, --base, --muted, --line …)
   cascade in from .mikey-app in theme.uss; this file only adds Intro-specific
   structure so the screen stays modular (same pattern as Home/Home.uss and
   Combine/Combine.uss). Linked from the intro screen in MikeyApp.uxml.

   Temporary text-only cinematic: the old comic/silhouette placeholder cast is
   retired. Nearly black, lots of negative space, a short sequence of lines
   building from an opening statement to a closing beat, then CONTINUE. When
   the full lore cinematic video exists, most of .intro-copy's content is
   replaced by a full-screen video target; the .intro-bg / .intro-layout /
   .intro-skip / .intro-primary structure below does not need to change.
   ============================================================ */

/* ---------- full-bleed background ----------
   Lives OUTSIDE .safe-area-content so it bleeds under device insets, like
   .cam-feed / .title-bg / .combine-bg / .home-bg on the other screens. Solid
   near-black base + a barely-there centered glow — atmosphere, not artwork. */
.intro-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #08090B;
    align-items: center;
    justify-content: center;
}
.intro-glow {
    position: absolute;
    top: -120px;
    width: 900px;
    height: 760px;
    border-radius: 380px;
    background-color: rgba(255, 90, 31, 0.04);
}

/* ---------- foreground layout ----------
   One full-height column inside the safe area: skip pinned top-right, the
   copy sequence centered with generous negative space, CONTINUE anchored
   toward the bottom. align-items:center keeps the capped-width copy centered
   on ultra-wide displays without a narrow portrait column. */
.intro-layout {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* ---------- copy sequence ----------
   A short, honest sequence of beats — no cards, no artwork, no silhouettes.
   Generous vertical spacing between groups is the "lots of negative space"
   the temporary screen calls for. */
.intro-copy {
    width: 100%;
    max-width: 720px;
    align-items: center;
}
.intro-copy__group {
    align-items: center;
    margin-top: 34px;
}
.intro-line {
    font-size: 16px;
    color: var(--muted);
    -unity-text-align: middle-center;
    white-space: normal;
}
.intro-line--open {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--bone);
}
.intro-line--support {
    font-size: 16px;
    color: var(--muted);
    margin-top: 6px;
}
.intro-line--close {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--bone);
    margin-top: 6px;
}

/* ---------- actions ---------- */
/* Shared minimum touch target: >= 48x48 logical, never shrinks below tappable.
   Scoped to this screen's stylesheet (same definition/intent as the Home and
   Combine touch-target kits). */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
}

/* Visible action icon (arrow). Sizes the rendered glyph independently of the
   button hit area; flex-shrink:0 stops flex collapsing the artwork; centered
   so it stays large/recognizable at phone-landscape scale. */
.intro-icon {
    flex-shrink: 0;
    align-self: center;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}
.intro-icon--cta {
    font-size: 30px;
    margin-left: 10px;
}
.intro-icon--skip {
    font-size: 22px;
    margin-left: 8px;
}

/* primary CTA: width-capped, ember, icon + label in a centered row */
.intro-cta {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 260px;
    max-width: 360px;
    margin-top: 46px;
    padding: 16px 28px;
}
.intro-cta__text {
    -unity-font-style: bold;
    font-size: 18px;
}

/* skip pill, top-right. Builds on the base .skip (theme.uss) but enlarges it to
   a real tappable control and lays out the label + arrow in a row. */
.intro-skip {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    top: 14px;
    right: 14px;
    padding: 0 18px;
    border-radius: 24px;
    border-color: rgba(237, 230, 216, 0.35);
    background-color: rgba(11, 14, 17, 0.5);
    color: var(--bone);
    font-size: 15px;
    -unity-font-style: normal;
}
.intro-skip__text {
    font-size: 15px;
}

/* ---------- intentional interaction states ---------- */
.intro-cta:hover {
    border-color: var(--bone);
}
.intro-cta:active {
    scale: 0.98 0.98;
}
.intro-skip:hover {
    border-color: var(--bone);
    color: var(--bone);
}
.intro-skip:active {
    scale: 0.96 0.96;
}
.intro-cta:disabled,
.intro-skip:disabled {
    opacity: 0.4;
}
.intro-cta:focus,
.intro-skip:focus {
    border-color: var(--ember);
}
