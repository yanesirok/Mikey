/* ============================================================
   Lore — landscape cold-open ("intro" screen) styles.
   Palette custom properties (--ember, --bone, --base, --muted, --seal, --line …)
   cascade in from .mikey-app in theme.uss; this file only adds Intro-specific
   structure so the screen stays modular (same pattern as Home/Home.uss and
   Combine/Combine.uss). Linked from the intro screen in MikeyApp.uxml.

   Minimal premium placeholder until the real Lore cinematic exists: the
   earlier multi-beat text sequence is retired in favor of a near-empty pure
   black screen with a single honest "not ready yet" statement, matching
   Mikey's black/off-white/restrained-red identity rather than reading as an
   app screen. When the full lore cinematic video exists, this whole
   .intro-copy/.intro-note block is replaced by a full-screen video target;
   the .intro-bg / .intro-layout / .intro-skip / .intro-primary structure
   below does not need to change.
   ============================================================ */

/* ---------- full-bleed background ----------
   Lives OUTSIDE .safe-area-content so it bleeds under device insets, like
   .cam-feed / .title-bg / .combine-bg / .home-bg on the other screens. Uses
   the approved shared dark background (also used by Profile — intentionally
   the SAME asset on both screens, see Profile/Profile.uss), cover-fit so it
   never stretches; background-color stays the fallback black in case the
   image fails to load, keeping this screen's near-empty, unlit feel either way. */
.intro-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #000000;
    background-image: url("/Assets/UI/Media/Images/Shared/shared_dark_background.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* ---------- foreground layout ----------
   One full-height column inside the safe area: skip pinned top-right, the
   copy sequence centered with generous negative space, CONTINUE anchored
   toward the bottom. align-items:center keeps the capped-width copy centered
   on ultra-wide displays without a narrow portrait column. */
.intro-layout {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* ---------- placeholder copy ----------
   One honest statement, not a scripted narrative sequence — no cards, no
   artwork, lots of negative space. A single thin red ink line (the only
   accent color on this screen besides the tiny Continue arrow) separates
   the primary line from the dimmer supporting line beneath it. */
.intro-copy {
    width: 100%;
    max-width: 720px;
    align-items: center;
}
.intro-line {
    -unity-text-align: middle-center;
    white-space: normal;
}
.intro-line--open {
    font-size: 48px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: var(--bone);
}
.intro-rule {
    width: 64px;
    height: 2px;
    margin-top: 22px;
    margin-bottom: 22px;
    background-color: var(--seal);
    opacity: 0.6;
}
.intro-line--support {
    font-size: 24px;
    color: rgba(237, 230, 216, 0.62);
}

/* Small supporting note near the bottom of the composition — deliberately
   its own (smaller, dimmer) class, not part of the .intro-line sequence. */
.intro-note {
    font-size: 19px;
    color: var(--muted);
    margin-top: 40px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- actions ---------- */
/* Shared minimum touch target: >= 48x48 logical, never shrinks below tappable.
   Scoped to this screen's stylesheet (same definition/intent as the Home and
   Combine touch-target kits). */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
}

/* Visible action icon (arrow). Sizes the rendered glyph independently of the
   button hit area; flex-shrink:0 stops flex collapsing the artwork; centered
   so it stays large/recognizable at phone-landscape scale. */
.intro-icon {
    flex-shrink: 0;
    align-self: center;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}
/* The tiny arrow beside CONTINUE is this screen's one deliberate red accent
   (see spec: "tiny accent beside Continue") — restrained, not a filled
   button. */
.intro-icon--cta {
    font-size: 26px;
    margin-left: 10px;
    color: var(--seal);
}
.intro-icon--skip {
    font-size: 22px;
    margin-left: 8px;
}

/* primary CTA: a quiet bordered control, not a solid filled ember pill —
   this screen deliberately opts out of the shared .btn.primary treatment
   (theme.uss) so black/off-white/red stays the only palette in view. */
.intro-cta {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 220px;
    max-width: 360px;
    margin-top: 40px;
    padding: 14px 30px;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(237, 230, 216, 0.28);
    background-color: rgba(237, 230, 216, 0.05);
}
.intro-cta__text {
    -unity-font-style: bold;
    font-size: 26px;
    letter-spacing: 1px;
    color: var(--bone);
}

/* skip pill, top-right. Builds on the base .skip (theme.uss) but enlarges it to
   a real tappable control and lays out the label + arrow in a row. */
.intro-skip {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    top: 14px;
    right: 14px;
    padding: 0 18px;
    border-radius: 24px;
    border-color: rgba(237, 230, 216, 0.35);
    background-color: rgba(11, 14, 17, 0.5);
    color: var(--bone);
    font-size: 15px;
    -unity-font-style: normal;
}
.intro-skip__text {
    font-size: 15px;
}

/* ---------- intentional interaction states ---------- */
.intro-cta:hover {
    border-color: var(--bone);
}
.intro-cta:active {
    scale: 0.98 0.98;
}
.intro-skip:hover {
    border-color: var(--bone);
    color: var(--bone);
}
.intro-skip:active {
    scale: 0.96 0.96;
}
.intro-cta:disabled,
.intro-skip:disabled {
    opacity: 0.4;
}
.intro-cta:focus,
.intro-skip:focus {
    border-color: var(--seal);
}
