<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="app" class="mikey-app">
        <Style src="theme.uss" />

        <!-- 1 - TITLE / ENTRANCE (single production entry screen) -->
        <ui:VisualElement name="title" class="screen title-screen">
            <Style src="Title/Title.uss" />
            <!-- full-bleed ink/dojo art, OUTSIDE the safe-area wrapper -->
            <ui:VisualElement class="title-bg">
                <ui:VisualElement class="title-glow" picking-mode="Ignore" />
                <ui:VisualElement class="title-sun" picking-mode="Ignore" />
                <ui:VisualElement class="title-scrim" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content sa-bottom-center">
            <ui:VisualElement class="title-block">
                <ui:Label text="忍" class="title-kanji" />
                <ui:Label text="SHINOBU" class="title-name" />
                <ui:VisualElement class="title-rule" />
                <ui:Label text="TRAIN FOR REAL  ·  FIGHT WITHIN" class="title-tag" />
                <!-- one obvious primary CTA → intro (semantic name go-intro) -->
                <ui:Button name="go-intro" class="btn primary title-cta tap-target">
                    <ui:Label text="Begin your path" class="title-cta__text" picking-mode="Ignore" />
                    <ui:Label text="›" class="title-icon title-icon--cta" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 2 - INTRO (landscape cold-open) -->
        <ui:VisualElement name="intro" class="screen intro-screen">
            <Style src="Intro/Intro.uss" />
            <!-- full-bleed cold-open wash, OUTSIDE the safe-area wrapper -->
            <ui:VisualElement class="intro-bg">
                <ui:VisualElement class="intro-glow" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="intro-layout">

                <!-- Skip → Home (semantic class intro-skip; arrow is a sized, non-shrinking icon) -->
                <ui:Button name="go-menu" class="skip intro-skip tap-target">
                    <ui:Label text="Skip" class="intro-skip__text" picking-mode="Ignore" />
                    <ui:Label text="▸" class="intro-icon intro-icon--skip" picking-mode="Ignore" />
                </ui:Button>

                <!-- cinematic stage: silhouettes stepping into frame (honest placeholder) -->
                <ui:VisualElement class="intro-stage">
                    <ui:VisualElement class="intro-cast" picking-mode="Ignore">
                        <ui:VisualElement class="intro-figure" picking-mode="Ignore">
                            <ui:VisualElement class="intro-figure__head" picking-mode="Ignore" />
                            <ui:VisualElement class="intro-figure__body" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="intro-figure intro-figure--lead" picking-mode="Ignore">
                            <ui:VisualElement class="intro-figure__head" picking-mode="Ignore" />
                            <ui:VisualElement class="intro-figure__body" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="intro-figure" picking-mode="Ignore">
                            <ui:VisualElement class="intro-figure__head" picking-mode="Ignore" />
                            <ui:VisualElement class="intro-figure__body" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Label text="COLD OPEN" class="intro-kicker" />
                    <ui:Label text="稽古" class="intro-kanji" />
                    <ui:Label text="The form was lost. You will restore it." class="intro-headline" />
                    <ui:Label text="Step into the dojo and begin your path." class="intro-sub" />

                    <!-- subtle progress / timeline (static, honest placeholder) -->
                    <ui:VisualElement class="intro-timeline">
                        <ui:VisualElement class="intro-timeline__track">
                            <ui:VisualElement class="intro-timeline__progress" />
                        </ui:VisualElement>
                        <ui:Label text="ANIMATED INTRO · PLACEHOLDER" class="intro-caption" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- primary CTA → Home (semantic class intro-primary) -->
                <ui:Button name="go-menu" class="btn primary intro-primary intro-cta tap-target">
                    <ui:Label text="Enter the Dojo" class="intro-cta__text" picking-mode="Ignore" />
                    <ui:Label text="›" class="intro-icon intro-icon--cta" picking-mode="Ignore" />
                </ui:Button>

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 3 - HOME HUB (landscape) -->
        <ui:VisualElement name="menu" class="screen home">
            <Style src="Home/Home.uss" />
            <!-- full-bleed Home background, OUTSIDE the safe-area wrapper -->
            <ui:VisualElement class="home-bg">
                <ui:VisualElement class="home-glow" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="home-layout">

                <!-- top profile / stat ribbon (mock values) -->
                <ui:VisualElement class="home-ribbon">
                    <ui:VisualElement class="home-belt">
                        <ui:VisualElement class="home-belt__swatch" />
                        <ui:VisualElement>
                            <ui:Label text="White Belt" class="home-belt__rank" />
                            <ui:Label text="LEVEL 1" class="home-belt__level" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="home-stats">
                        <ui:VisualElement class="home-chip">
                            <ui:Label text="火" class="home-chip__glyph home-icon home-icon--ribbon" />
                            <ui:Label text="1-day streak" class="home-chip__text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="home-chip">
                            <ui:Label text="金" class="home-chip__glyph home-icon home-icon--ribbon" />
                            <ui:Label text="$10.00" class="home-chip__text home-chip__text--coin" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- hero / current journey -->
                <ui:VisualElement class="home-hero">
                    <ui:VisualElement class="home-hero__card">
                        <ui:VisualElement class="home-ring">
                            <ui:Label text="0" class="home-ring__value" />
                            <ui:Label text="/1 SESSION" class="home-ring__label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="home-hero__body">
                            <ui:Label text="稽古 · TODAY'S TRAINING" class="kicker home-hero__kicker" />
                            <ui:Label text="Earn your day" class="title home-hero__title" />
                            <ui:Label text="One real session keeps your fighter sharp. Begin the Combine to measure your baseline." class="lead home-hero__lead" />
                            <ui:Button name="go-combineIntro" class="btn primary tap-target home-hero__cta">
                                <ui:Label text="Begin the Combine" class="home-cta__text" picking-mode="Ignore" />
                                <ui:Label text="›" class="home-icon home-icon--cta home-cta__arrow" picking-mode="Ignore" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- power ribbon (mock attributes) -->
                    <ui:VisualElement class="home-power">
                        <ui:VisualElement class="home-power__cell">
                            <ui:Label text="STR" class="home-power__key" />
                            <ui:Label text="12" class="home-power__val" />
                        </ui:VisualElement>
                        <ui:VisualElement class="home-power__cell">
                            <ui:Label text="SPD" class="home-power__key" />
                            <ui:Label text="9" class="home-power__val" />
                        </ui:VisualElement>
                        <ui:VisualElement class="home-power__cell">
                            <ui:Label text="AGI" class="home-power__key" />
                            <ui:Label text="11" class="home-power__val" />
                        </ui:VisualElement>
                        <ui:VisualElement class="home-power__cell">
                            <ui:Label text="END" class="home-power__key" />
                            <ui:Label text="8" class="home-power__val" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- persistent landscape bottom navigation dock -->
                <ui:VisualElement class="home-dock">
                    <ui:VisualElement name="nav-home" class="home-tab home-tab--active tap-target-lg">
                        <ui:Label text="家" class="home-tab__glyph home-icon home-icon--nav" />
                        <ui:Label text="Home" class="home-tab__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="nav-map" class="home-tab home-tab--locked tap-target-lg">
                        <ui:Label text="地" class="home-tab__glyph home-icon home-icon--nav" />
                        <ui:Label text="Map" class="home-tab__label" />
                        <ui:Label text="SOON" class="home-tab__badge" />
                    </ui:VisualElement>
                    <ui:VisualElement name="nav-techniques" class="home-tab home-tab--locked tap-target-lg">
                        <ui:Label text="技" class="home-tab__glyph home-icon home-icon--nav" />
                        <ui:Label text="Techniques" class="home-tab__label" />
                        <ui:Label text="SOON" class="home-tab__badge" />
                    </ui:VisualElement>
                    <ui:VisualElement name="nav-profile" class="home-tab home-tab--locked tap-target-lg">
                        <ui:Label text="人" class="home-tab__glyph home-icon home-icon--nav" />
                        <ui:Label text="Profile" class="home-tab__label" />
                        <ui:Label text="SOON" class="home-tab__badge" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 4 - COMBINE INTRO -->
        <ui:VisualElement name="combineIntro" class="screen">
            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="content">
                <ui:Label text="LEVEL 0 · THE COMBINE" class="kicker" />
                <ui:Label text="Measure your baseline" class="title" />
                <ui:Label text="Four tests, camera on. We score your body so your fighter starts honest. No technique yet — that's earned next." class="lead" />
                <ui:VisualElement class="statlist">
                    <ui:VisualElement class="stat">
                        <ui:VisualElement class="sh">
                            <ui:Label text="1 · Push-ups" class="sh-name" />
                            <ui:Label text="Power · upper" class="sh-meta" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="stat">
                        <ui:VisualElement class="sh">
                            <ui:Label text="2 · Squats" class="sh-name" />
                            <ui:Label text="Power · lower" class="sh-meta" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="stat">
                        <ui:VisualElement class="sh">
                            <ui:Label text="3 · Wall-sit" class="sh-name" />
                            <ui:Label text="Endurance" class="sh-meta" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="stat">
                        <ui:VisualElement class="sh">
                            <ui:Label text="4 · Yoko-geri ladder" class="sh-name" />
                            <ui:Label text="Control" class="sh-meta" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="spacer" />
                <ui:Button name="go-camTest" text="Begin · camera on" class="btn primary" />
            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 5 - CAMERA TEST (live feed, no painted background) -->
        <ui:VisualElement name="camTest" class="screen camera">
            <ui:VisualElement class="cam-feed" />
            <ui:VisualElement class="safe-area-content sa-top-center">
            <ui:VisualElement class="live">
                <ui:VisualElement class="dot" />
                <ui:Label text="LIVE · pose detection" />
            </ui:VisualElement>
            <ui:Label text="Push-ups" class="testname" />
            <ui:VisualElement class="counter">
                <ui:Label text="0" class="big" />
                <ui:Label text="REPS" class="lbl" />
            </ui:VisualElement>
            <ui:Label text="Good form" class="callout good" />
            <ui:VisualElement class="pose-box" />
            <ui:Label text="Live camera feed — no painted background here" class="cam-note" />
            <ui:VisualElement class="spacer" />
            <ui:VisualElement class="cam-actions">
                <ui:Button text="+ simulate reps" class="btn sm" />
                <ui:Button name="go-combine" text="Done ▸" class="btn sm primary" />
            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 6 - COMBINE (vertical slice: mock loading / empty / ready / error) -->
        <ui:VisualElement name="combine" class="screen">
            <Style src="Combine/Combine.uss" />
            <!-- full-bleed background, outside the safe-area wrapper -->
            <ui:VisualElement class="combine-bg" />
            <ui:VisualElement class="safe-area-content sa-center">
                <ui:VisualElement class="content combine-content">
                    <ui:Label text="測定 · THE COMBINE" class="kicker combine-kicker" />
                    <ui:Label text="Your baseline" class="title" />

                    <!-- LOADING -->
                    <ui:VisualElement name="combine-loading" class="combine-state">
                        <ui:VisualElement class="combine-spinner" />
                        <ui:Label text="Measuring your baseline…" class="lead combine-msg" />
                    </ui:VisualElement>

                    <!-- EMPTY / no selected items -->
                    <ui:VisualElement name="combine-empty" class="combine-state">
                        <ui:Label text="No tests selected yet" class="combine-state-title" />
                        <ui:Label text="Pick your Combine tests to build a baseline." class="lead combine-msg" />
                    </ui:VisualElement>

                    <!-- READY / success with mock selected items -->
                    <ui:VisualElement name="combine-ready" class="combine-state">
                        <ui:VisualElement name="combine-items" class="combine-items" />
                        <ui:Label text="Four honest numbers. Your fighter starts here." class="lead combine-msg" />
                        <!-- production exit: returns to the Home hub (ScreenManager wires go-menu -> menu) -->
                        <ui:Button name="go-menu" text="Return Home" class="btn primary combine-home icon-btn" />
                    </ui:VisualElement>

                    <!-- ERROR -->
                    <ui:VisualElement name="combine-error" class="combine-state">
                        <ui:Label text="Couldn't load your baseline" class="combine-state-title combine-error-title" />
                        <ui:Label text="Something went wrong. Please try again." class="lead combine-msg" />
                        <ui:Button name="combine-retry" text="Retry" class="btn combine-retry icon-btn" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- development-only state switcher (hidden outside Editor / dev build) -->
                <ui:VisualElement name="combine-devbar" class="combine-devbar">
                    <ui:Label text="DEV · STATE" class="combine-devbar__label" />
                    <ui:Button name="combine-dev-loading" text="Loading" class="combine-devbtn icon-btn icon-24" />
                    <ui:Button name="combine-dev-empty" text="Empty" class="combine-devbtn icon-btn icon-24" />
                    <ui:Button name="combine-dev-ready" text="Ready" class="combine-devbtn icon-btn icon-24" />
                    <ui:Button name="combine-dev-error" text="Error" class="combine-devbtn icon-btn icon-24" />
                    <ui:Button name="combine-dev-cycle" text="Cycle ▸" class="combine-devbtn icon-btn icon-24" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
