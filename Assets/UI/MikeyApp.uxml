<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="app" class="mikey-app">
        <Style src="theme.uss" />

        <!-- 1 - LOGO INTRO (startup/logo screen; single production entry screen).
             Full-bleed final logo animation (logo_intro.mp4) on a near-black
             backdrop, nothing else. TitleController plays it once, then — once
             the shell is ready — advances to Sign In with a cinematic fade (never
             a hard cut), triggered by natural completion, a tap/click anywhere
             (no CTA button — this is not a ScreenManager "go-" navigator), or
             the video error fallback. -->
        <ui:VisualElement name="title" class="screen title-screen">
            <Style src="Title/Title.uss" />
            <!-- full-bleed near-black backdrop + logo video target, OUTSIDE the safe-area wrapper.
                 TitleController freezes on this SAME video's own final frame while
                 waiting for the shell (Sign In's video) to be ready — never a
                 separate static logo image. -->
            <ui:VisualElement class="title-bg" picking-mode="Ignore">
                <ui:VisualElement name="title-video" picking-mode="Ignore" class="title-video" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content" />
        </ui:VisualElement>

        <!-- 2 - LORE (landscape temporary placeholder; full lore cinematic lands later).
             First launch only: HomeController opens this straight after Sign In
             while tutorial progression is still below IntroCompleted, and goes
             straight to the Map on every launch after that.
             Exiting Lore (Skip or Continue) is driven by LoreExitController, NOT
             ScreenManager's "go-" auto-wiring: both actions are named "lore-skip"/
             "lore-continue" (deliberately not "go-map") so LoreExitController can
             darken Lore to black through the shared transition overlay BEFORE
             swapping to the Map, then fade the Map in — never a hard cut. This
             is also where a future real Lore image/video/animation slots in later:
             only the placeholder content below (.intro-copy / .intro-note) changes,
             the launch transition sequence around it does not. -->
        <ui:VisualElement name="intro" class="screen intro-screen">
            <Style src="Intro/Intro.uss" />
            <!-- full-bleed pure-black wash, OUTSIDE the safe-area wrapper -->
            <ui:VisualElement class="intro-bg" picking-mode="Ignore" />

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="intro-layout">

                <!-- Skip → Map (semantic class intro-skip; kept visually subtle, arrow is a sized, non-shrinking icon) -->
                <ui:Button name="lore-skip" class="skip intro-skip tap-target sfx-click">
                    <ui:Label text="Skip" class="intro-skip__text" picking-mode="Ignore" />
                    <ui:Label text="▸" class="intro-icon intro-icon--skip" picking-mode="Ignore" />
                </ui:Button>

                <!-- minimal premium placeholder (honest "not ready yet" statement for
                     the future full lore cinematic): near-empty pure-black screen, one
                     thin red ink rule as the only accent between the two lines. -->
                <ui:VisualElement class="intro-copy">
                    <ui:Label text="The story is still being written." class="intro-line intro-line--open" />
                    <ui:VisualElement class="intro-rule" picking-mode="Ignore" />
                    <ui:Label text="Every path begins before the first step." class="intro-line intro-line--support" />
                </ui:VisualElement>

                <ui:Label text="Lore cinematic coming soon." class="intro-note" />

                <!-- primary CTA → Map (semantic class intro-primary) -->
                <ui:Button name="lore-continue" class="intro-primary intro-cta tap-target sfx-click">
                    <ui:Label text="Continue" class="intro-cta__text" picking-mode="Ignore" />
                    <ui:Label text="›" class="intro-icon intro-icon--cta" picking-mode="Ignore" />
                </ui:Button>

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 3 - SIGN IN (landscape cinematic launch screen).
             The app's one authentication gate, shown over the same full-bleed
             Main Menu video the old PLAY/VOW/SETTINGS/QUIT menu used. Exactly two
             icon-only actions: the Google mark (Mikey.Backend.SyncService) and a
             quiet guest glyph for anyone who does not want an account.
             Neither is a ScreenManager "go-" navigator: HomeController drives both,
             darkening this screen to black through the shared transition overlay
             before opening Lore on a first launch, or the Map hub on every launch
             after that (see HomeController.NextScreenAfterAuth). Nothing in the app
             navigates back here — the Map top bar is the hub from here on. Only an
             existing session skips this screen; everyone else sees it, and the
             guest action is always the way through. -->
        <ui:VisualElement name="menu" class="screen home">
            <Style src="Home/Home.uss" />
            <!-- full-bleed Sign In background video, OUTSIDE the safe-area wrapper -->
            <ui:VisualElement class="home-bg">
                <ui:VisualElement name="home-bg-media" picking-mode="Ignore" class="bg-media" />
                <ui:VisualElement class="home-scrim" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="home-layout">

                <!-- upper-left brand mark -->
                <ui:VisualElement class="home-logo" picking-mode="Ignore" />

                <!-- bottom-centered account row, the PUBG/CoD-Mobile shape:
                     round icon-only buttons, no worded menu. The Google mark and
                     the guest glyph ARE the labels (see the Home.uss icon
                     modifiers for google and guest); the only text on this
                     screen is the status line below, and it stays empty until
                     there is something honest to say. -->
                <ui:VisualElement class="home-auth">
                    <ui:VisualElement class="home-auth__row">
                        <!-- Primary: Google sign-in. HomeController disables it while
                             the system account dialog is up and re-enables it if the
                             attempt does not end in a session. -->
                        <ui:Button name="menu-google-signin" class="home-auth__btn tap-target-lg sfx-click">
                            <ui:VisualElement class="home-auth__icon home-auth__icon--google" picking-mode="Ignore" />
                        </ui:Button>
                        <!-- Secondary: continue without an account. Never hidden —
                             progress simply stays on the device. -->
                        <ui:Button name="menu-guest-continue" class="home-auth__btn home-auth__btn--guest tap-target-lg sfx-click">
                            <ui:VisualElement class="home-auth__icon home-auth__icon--guest" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <!-- One inline status line: "Signing in..." while the dialog is
                         up, an honest retry notice if it comes back empty. Never a
                         modal, never a fake success. -->
                    <ui:Label name="menu-auth-status" text="" class="home-auth__status" picking-mode="Ignore" />
                </ui:VisualElement>

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 4 - COMBINE INTRO (landscape LVL0 briefing) -->
        <ui:VisualElement name="combineIntro" class="screen combine-intro">
            <Style src="CombineIntro/CombineIntro.uss" />
            <!-- full-bleed briefing background, OUTSIDE the safe-area wrapper -->
            <ui:VisualElement class="ci-bg" picking-mode="Ignore">
                <ui:VisualElement class="ci-glow" picking-mode="Ignore" />
                <ui:VisualElement class="ci-kanji-wash" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="ci-layout">

                <!-- LEFT BAND: LVL0 / baseline hierarchy, explanation, status, actions -->
                <ui:VisualElement class="ci-brief">
                    <ui:VisualElement class="ci-headline">
                        <ui:Label text="測" class="ci-icon ci-icon--mark" picking-mode="Ignore" />
                        <ui:VisualElement class="ci-headline__text">
                            <ui:Label text="LEVEL 0 · THE COMBINE" class="kicker ci-kicker" />
                            <ui:Label text="Measure your baseline" class="title ci-title" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Label text="The Combine scores your real body so your fighter starts honest — upper-body power, core, control and endurance. No technique yet; that's earned next." class="lead ci-lead" />

                    <!-- preparation / status area (honest about the mock camera flow) -->
                    <ui:VisualElement class="ci-status">
                        <ui:VisualElement class="ci-status__dot" picking-mode="Ignore" />
                        <ui:VisualElement class="ci-status__text">
                            <ui:Label text="READY · 6 TESTS · CAMERA ON" class="ci-status__head" picking-mode="Ignore" />
                            <ui:Label text="Phone side-on, whole body in frame — head to feet." class="ci-status__sub" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- responsive action bar: width-capped, wraps on narrow landscape -->
                    <ui:VisualElement class="ci-actionbar">
                        <!-- primary (dominant) → existing Camera Test screen -->
                        <ui:Button name="go-camTest" class="ci-btn ci-btn--primary ci-tap-target-lg">
                            <ui:Label text="Begin Camera Test" class="ci-btn__text" picking-mode="Ignore" />
                            <ui:Label text="›" class="ci-icon ci-icon--action ci-btn__icon" picking-mode="Ignore" />
                        </ui:Button>
                        <!-- secondary → the Map hub -->
                        <ui:Button name="go-map" class="ci-btn ci-btn--ghost ci-tap-target-lg">
                            <ui:Label text="‹" class="ci-icon ci-icon--action ci-btn__icon ci-btn__icon--lead" picking-mode="Ignore" />
                            <ui:Label text="Return to Map" class="ci-btn__text" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- RIGHT BAND: the six-test list with large readable glyphs. Order and
                     names mirror Level0SessionController.ExerciseIds exactly — the briefing
                     must promise what the station actually runs. -->
                <ui:VisualElement class="ci-tests">
                    <ui:VisualElement class="ci-test">
                        <ui:Label text="腕" class="ci-icon ci-icon--test ci-test__glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="ci-test__body">
                            <ui:Label text="1 · Push-ups" class="ci-test__name" />
                            <ui:Label text="Power · upper" class="ci-test__meta" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="ci-test">
                        <ui:Label text="脚" class="ci-icon ci-icon--test ci-test__glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="ci-test__body">
                            <ui:Label text="2 · Squats" class="ci-test__name" />
                            <ui:Label text="Power · legs" class="ci-test__meta" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="ci-test">
                        <ui:Label text="耐" class="ci-icon ci-icon--test ci-test__glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="ci-test__body">
                            <ui:Label text="3 · Wall-sit" class="ci-test__name" />
                            <ui:Label text="Endurance" class="ci-test__meta" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="ci-test">
                        <ui:Label text="下" class="ci-icon ci-icon--test ci-test__glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="ci-test__body">
                            <ui:Label text="4 · Yoko geri gedan" class="ci-test__name" />
                            <ui:Label text="Control · low" class="ci-test__meta" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="ci-test">
                        <ui:Label text="中" class="ci-icon ci-icon--test ci-test__glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="ci-test__body">
                            <ui:Label text="5 · Yoko geri chudan" class="ci-test__name" />
                            <ui:Label text="Control · mid" class="ci-test__meta" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="ci-test">
                        <ui:Label text="柔" class="ci-icon ci-icon--test ci-test__glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="ci-test__body">
                            <ui:Label text="6 · Yoko geri jodan" class="ci-test__name" />
                            <ui:Label text="Flexibility · high" class="ci-test__meta" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 5 - CAMERA TEST (landscape camera HUD; live pose via Level0SessionController) -->
        <ui:VisualElement name="camTest" class="screen camera">
            <Style src="CameraTest/CameraTest.uss" />
            <!-- full-bleed camera feed, OUTSIDE the safe-area wrapper; the live camera
                 image is assigned to this element's background by the controller -->
            <ui:VisualElement name="camera-bg" class="cam-feed" picking-mode="Ignore">
                <ui:VisualElement class="cam-feed__glow" picking-mode="Ignore" />
                <ui:VisualElement class="cam-feed__vignette" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="cam-hud">

                <!-- top bar: live/mock detection badge (left) + exercise title (right) -->
                <ui:VisualElement class="cam-topbar">
                    <ui:VisualElement class="cam-live">
                        <ui:VisualElement class="cam-live__dot cam-icon" picking-mode="Ignore" />
                        <ui:Label text="LIVE · POSE" class="cam-live__text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cam-titlewrap">
                        <ui:Label name="camera-exercise-step" text="LEVEL 0 · 1 / 6" class="kicker cam-kicker" />
                        <ui:Label name="camera-exercise-name" text="Push-ups" class="testname cam-title" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- center stage: large pose focal region + big rep readout -->
                <ui:VisualElement class="cam-stage">
                    <ui:VisualElement class="cam-pose">
                        <ui:VisualElement class="cam-pose__bracket cam-pose__bracket--tl" picking-mode="Ignore" />
                        <ui:VisualElement class="cam-pose__bracket cam-pose__bracket--tr" picking-mode="Ignore" />
                        <ui:VisualElement class="cam-pose__bracket cam-pose__bracket--bl" picking-mode="Ignore" />
                        <ui:VisualElement class="cam-pose__bracket cam-pose__bracket--br" picking-mode="Ignore" />
                        <ui:VisualElement class="cam-figure" picking-mode="Ignore">
                            <ui:VisualElement class="cam-figure__head" picking-mode="Ignore" />
                            <ui:VisualElement class="cam-figure__body" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <!-- live coaching cue: the one prioritized correction, or the
                             exercise's framing hint when form is clean -->
                        <ui:Label name="camera-cue" text="Боком к камере, всё тело в кадр" class="cam-pose__note" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="cam-readout">
                        <ui:VisualElement class="cam-counter">
                            <ui:Label name="camera-rep-count" text="0" class="cam-count" />
                            <ui:Label text="REPS" class="cam-count__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="camera-form-pill" class="cam-status cam-status--ready">
                            <ui:Label name="camera-form-glyph" text="構" class="cam-status__glyph cam-icon cam-icon-36" picking-mode="Ignore" />
                            <ui:Label name="camera-form-status" text="Align in frame" class="cam-status__text" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- responsive bottom action bar: width-capped, centered, wraps on narrow widths -->
                <ui:VisualElement class="cam-actionbar">
                    <!-- banks this set and moves to the next level-0 exercise (NOT a go-
                         navigator: the controller owns the sequence, ScreenManager must not
                         treat it as a screen jump) -->
                    <ui:Button name="camera-next-exercise" class="cam-btn cam-btn--ghost tap-target-lg">
                        <ui:Label text="▸" class="cam-icon cam-icon-32 cam-btn__icon" picking-mode="Ignore" />
                        <ui:Label name="camera-next-text" text="Next" class="cam-btn__text" picking-mode="Ignore" />
                    </ui:Button>
                    <!-- leave the assessment early → modern Combine screen -->
                    <ui:Button name="go-combine" class="cam-btn cam-btn--primary tap-target-lg">
                        <ui:Label text="Done" class="cam-btn__text" picking-mode="Ignore" />
                        <ui:Label text="▸" class="cam-icon cam-icon-32 cam-btn__icon" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 6 - COMBINE (vertical slice: mock loading / empty / ready / error) -->
        <ui:VisualElement name="combine" class="screen">
            <Style src="Combine/Combine.uss" />
            <!-- full-bleed background, outside the safe-area wrapper -->
            <ui:VisualElement class="combine-bg">
                <ui:VisualElement name="combine-bg-media" picking-mode="Ignore" class="bg-media" />
                <ui:VisualElement class="combine-scrim" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="safe-area-content sa-center">
                <ui:VisualElement class="content combine-content">
                    <ui:Label text="測定 · THE COMBINE" class="kicker combine-kicker" />
                    <ui:Label text="Your baseline" class="title" />

                    <!-- LOADING -->
                    <ui:VisualElement name="combine-loading" class="combine-state">
                        <ui:VisualElement class="combine-spinner" />
                        <ui:Label text="Measuring your baseline…" class="lead combine-msg" />
                    </ui:VisualElement>

                    <!-- EMPTY / no selected items -->
                    <ui:VisualElement name="combine-empty" class="combine-state">
                        <ui:Label text="No tests selected yet" class="combine-state-title" />
                        <ui:Label text="Pick your Combine tests to build a baseline." class="lead combine-msg" />
                    </ui:VisualElement>

                    <!-- READY / success with mock selected items -->
                    <ui:VisualElement name="combine-ready" class="combine-state">
                        <ui:VisualElement name="combine-items" class="combine-items" />
                        <ui:Label text="Four honest numbers. Your fighter starts here." class="lead combine-msg" />
                        <!-- Progression forward action (NOT a "go-" navigator):
                             CombineScreenController marks CombineCompleted, unlocks
                             Level1Unlocked, then routes to Map. -->
                        <ui:Button name="combine-start-lvl1" text="START LVL 1" class="btn primary combine-home icon-btn" />
                        <!-- Progression reset action (NOT a "go-" navigator): resets only
                             the Combine (LVL0) portion of progress, then returns to the
                             Combine briefing to redo it. -->
                        <ui:Button name="combine-retry-assessment" text="Retry Assessment" class="btn combine-retry icon-btn" />
                        <!-- production exit: returns to the Map hub (ScreenManager wires go-map -> map) -->
                        <ui:Button name="go-map" text="Return to Map" class="btn combine-home icon-btn" />
                    </ui:VisualElement>

                    <!-- ERROR -->
                    <ui:VisualElement name="combine-error" class="combine-state">
                        <ui:Label text="Couldn't load your baseline" class="combine-state-title combine-error-title" />
                        <ui:Label text="Something went wrong. Please try again." class="lead combine-msg" />
                        <ui:Button name="combine-retry" text="Retry" class="btn combine-retry icon-btn" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- development-only state switcher (hidden outside Editor / dev build) -->
                <ui:VisualElement name="combine-devbar" class="combine-devbar">
                    <ui:Label text="DEV · STATE" class="combine-devbar__label" />
                    <ui:Button name="combine-dev-loading" text="Loading" class="combine-devbtn icon-btn icon-24" />
                    <ui:Button name="combine-dev-empty" text="Empty" class="combine-devbtn icon-btn icon-24" />
                    <ui:Button name="combine-dev-ready" text="Ready" class="combine-devbtn icon-btn icon-24" />
                    <ui:Button name="combine-dev-error" text="Error" class="combine-devbtn icon-btn icon-24" />
                    <ui:Button name="combine-dev-cycle" text="Cycle ▸" class="combine-devbtn icon-btn icon-24" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 7 - TECHNIQUES / LESSONS (landscape lesson hub) -->
        <ui:VisualElement name="techniques" class="screen techniques-screen">
            <Style src="Techniques/Techniques.uss" />
            <!-- shared top-nav visual system (".map-topbar", see Map/Map.uss) is
                 reused here exactly as-is, the same way the Japan and Okinawa map
                 screens already both link Map.uss for it — no duplicated
                 stylesheet, no renamed classes. -->
            <Style src="Map/Map.uss" />
            <!-- full-bleed lesson-hub background, OUTSIDE the safe-area wrapper -->
            <ui:VisualElement class="tq-bg" picking-mode="Ignore">
                <ui:VisualElement class="tq-glow" picking-mode="Ignore" />
                <ui:VisualElement class="tq-kanji-wash" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="tq-layout">

                <!-- LEFT BAND: Techniques/Lessons hierarchy + rank/progress + Home/Back -->
                <ui:VisualElement class="tq-hub">
                    <ui:VisualElement class="tq-headline">
                        <ui:Label text="技" class="tq-icon tq-icon--hub tq-headline__mark" picking-mode="Ignore" />
                        <ui:VisualElement class="tq-headline__text">
                            <ui:Label text="KARATE · LESSONS" class="kicker tq-kicker" />
                            <ui:Label text="Techniques" class="title tq-title" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Label text="Choose an element. Mikey demonstrates, then watches you attempt it. Earn the first form to open the path." class="lead tq-lead" />

                    <!-- rank / progress summary (mock local data) -->
                    <ui:VisualElement class="tq-progress">
                        <ui:VisualElement class="tq-belt">
                            <ui:VisualElement class="tq-belt__swatch" picking-mode="Ignore" />
                            <ui:VisualElement class="tq-belt__text">
                                <ui:Label text="White Belt" class="tq-belt__rank" />
                                <ui:Label text="HEIAN · DAY 1" class="tq-belt__sub" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="tq-progress__bar">
                            <ui:VisualElement class="tq-progress__fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label text="1 / 4 ELEMENTS" class="tq-progress__count" />
                    </ui:VisualElement>

                    <!-- Back action to the Map hub (semantic name go-map) -->
                    <ui:VisualElement class="tq-actionbar tq-actionbar--hub">
                        <ui:Button name="go-map" class="tq-btn tq-btn--ghost tap-target-lg">
                            <ui:Label text="‹" class="tq-icon tq-icon--action tq-btn__icon tq-btn__icon--lead" picking-mode="Ignore" />
                            <ui:Label text="Map" class="tq-btn__text" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- RIGHT BAND: responsive lesson list -->
                <ui:VisualElement class="tq-lessons">
                    <!-- 1 · AVAILABLE — the first reference lesson (Front Stance / Zenkutsu-dachi).
                         A real first-lesson navigator (go-practice), visually distinct as available. -->
                    <ui:Button name="go-practice" class="tq-lesson tq-lesson--available tap-target-lg">
                        <ui:Label text="前" class="tq-icon tq-icon--lesson tq-lesson__glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="tq-lesson__body">
                            <ui:Label text="1 · Front Stance" class="tq-lesson__name" picking-mode="Ignore" />
                            <ui:Label text="Zenkutsu-dachi · 前屈" class="tq-lesson__romaji" picking-mode="Ignore" />
                            <ui:Label text="FOUNDATION FORM · NOT YET ATTEMPTED" class="tq-lesson__meta" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label text="›" class="tq-icon tq-icon--action tq-lesson__go" picking-mode="Ignore" />
                    </ui:Button>

                    <!-- 2-4 · LOCKED — honest coming-soon state, NOT a navigator (no go- name),
                         non-interactive (picking ignored), but readable with a clear lock state. -->
                    <ui:VisualElement class="tq-lesson tq-lesson--locked" picking-mode="Ignore">
                        <ui:Label text="鍵" class="tq-icon tq-icon--lesson tq-lesson__glyph tq-lesson__glyph--locked" />
                        <ui:VisualElement class="tq-lesson__body">
                            <ui:Label text="2 · Low Block" class="tq-lesson__name" />
                            <ui:Label text="Gedan-barai · 下段" class="tq-lesson__romaji" />
                            <ui:Label text="DEFENSIVE ELEMENT · COMING SOON" class="tq-lesson__meta tq-lesson__meta--locked" />
                        </ui:VisualElement>
                        <ui:Label text="SOON" class="tq-lesson__badge" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tq-lesson tq-lesson--locked" picking-mode="Ignore">
                        <ui:Label text="鍵" class="tq-icon tq-icon--lesson tq-lesson__glyph tq-lesson__glyph--locked" />
                        <ui:VisualElement class="tq-lesson__body">
                            <ui:Label text="3 · Front Kick" class="tq-lesson__name" />
                            <ui:Label text="Mae-geri · 前蹴" class="tq-lesson__romaji" />
                            <ui:Label text="STRIKING ELEMENT · COMING SOON" class="tq-lesson__meta tq-lesson__meta--locked" />
                        </ui:VisualElement>
                        <ui:Label text="SOON" class="tq-lesson__badge" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tq-lesson tq-lesson--locked" picking-mode="Ignore">
                        <ui:Label text="鍵" class="tq-icon tq-icon--lesson tq-lesson__glyph tq-lesson__glyph--locked" />
                        <ui:VisualElement class="tq-lesson__body">
                            <ui:Label text="4 · Heian Shodan" class="tq-lesson__name" />
                            <ui:Label text="First Kata · 平安" class="tq-lesson__romaji" />
                            <ui:Label text="SEQUENCE · TEMPO · COMING SOON" class="tq-lesson__meta tq-lesson__meta--locked" />
                        </ui:VisualElement>
                        <ui:Label text="SOON" class="tq-lesson__badge" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- shared top quick-access HUD (see Map/Map.uss ".map-topbar" and the
                 "map"/"mapOkinawa" screens' own copies for the full explanation) —
                 declared last so it paints above ".tq-layout"; ".tq-layout" gains a
                 top offset (Techniques.uss) so its own heading is never covered.
                 "Techniques" carries the active-section accent. Map/Profile are
                 plain "go-" navigators (see ScreenManager): reaching Techniques
                 already implies Map is unlocked at the same TutorialProgressState
                 threshold, and Profile is never gated anywhere else in the app
                 either, so no controller/gating code is needed for either link. -->
            <ui:VisualElement class="map-topbar">
                <ui:VisualElement class="map-topbar__nav">
                    <ui:Button name="go-map" class="map-topbar__nav-btn tap-target">
                        <ui:Label text="Map" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:VisualElement class="map-topbar__nav-btn map-topbar__nav-btn--active tap-target" picking-mode="Ignore">
                        <ui:VisualElement class="map-topbar__nav-btn-halo map-topbar__nav-btn-halo--techniques" picking-mode="Ignore">
                            <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--outer" picking-mode="Ignore" />
                            <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--middle" picking-mode="Ignore" />
                            <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--inner" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label text="Techniques" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                        <ui:VisualElement class="map-topbar__nav-btn-underline map-topbar__nav-btn-underline--techniques" picking-mode="Ignore">
                            <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--a" picking-mode="Ignore" />
                            <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--b" picking-mode="Ignore" />
                            <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--c" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="go-profile" class="map-topbar__nav-btn tap-target">
                        <ui:Label text="Profile" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="techniques-topbar-settings" class="map-topbar__nav-btn tap-target">
                        <ui:Label text="Settings" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="map-topbar__right">
                    <ui:VisualElement class="map-topbar__status">
                        <ui:Label name="techniques-topbar-level" text="LVL 1" class="map-topbar__level" />
                        <ui:Label name="techniques-topbar-xp" text="320 / 500 XP" class="map-topbar__xp" />
                        <ui:VisualElement class="map-topbar__xp-bar" picking-mode="Ignore">
                            <ui:VisualElement class="map-topbar__xp-bar__fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 8 - PRACTICE (frontend-only mock training slice for the first lesson) -->
        <ui:VisualElement name="practice" class="screen practice-screen">
            <Style src="Practice/Practice.uss" />
            <!-- full-bleed mock training feed, OUTSIDE the safe-area wrapper -->
            <ui:VisualElement class="pr-feed" picking-mode="Ignore">
                <ui:VisualElement class="pr-feed__glow" picking-mode="Ignore" />
                <ui:VisualElement class="pr-feed__vignette" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="pr-hud">

                <!-- top bar: mock live marker (left) + lesson name & objective (right) -->
                <ui:VisualElement class="pr-topbar">
                    <ui:VisualElement class="pr-live">
                        <ui:VisualElement class="pr-live__dot pr-icon" picking-mode="Ignore" />
                        <ui:Label text="LIVE · MOCK POSE" class="pr-live__text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pr-titlewrap">
                        <ui:Label text="KARATE · ELEMENT 1 / 4" class="kicker pr-kicker" />
                        <ui:Label text="Zenkutsu-dachi · 前屈" class="title pr-title" />
                        <ui:Label text="Front Stance — sink low, hips square, spine tall." class="pr-objective" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- center stage: large readable pose focal graphic + score / cue readout -->
                <ui:VisualElement class="pr-stage">
                    <ui:VisualElement class="pr-pose">
                        <ui:VisualElement class="pr-pose__bracket pr-pose__bracket--tl" picking-mode="Ignore" />
                        <ui:VisualElement class="pr-pose__bracket pr-pose__bracket--tr" picking-mode="Ignore" />
                        <ui:VisualElement class="pr-pose__bracket pr-pose__bracket--bl" picking-mode="Ignore" />
                        <ui:VisualElement class="pr-pose__bracket pr-pose__bracket--br" picking-mode="Ignore" />
                        <ui:VisualElement class="pr-figure" picking-mode="Ignore">
                            <ui:VisualElement class="pr-figure__head" picking-mode="Ignore" />
                            <ui:VisualElement class="pr-figure__body" picking-mode="Ignore" />
                            <ui:VisualElement class="pr-figure__stance" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label text="MOCK CAMERA · FRONT-STANCE PLACEHOLDER" class="pr-pose__note" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="pr-readout">
                        <ui:VisualElement class="pr-counter">
                            <ui:Label name="practice-score" text="41" class="pr-score" />
                            <ui:Label text="FORM" class="pr-score__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="practice-cue-pill" class="pr-cue pr-cue--ready">
                            <ui:Label name="practice-cue-glyph" text="構" class="pr-cue__glyph pr-icon pr-icon--hud" picking-mode="Ignore" />
                            <ui:Label name="practice-cue-text" text="Press Begin to start." class="pr-cue__text" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- progress indicator: kata keyframe pips, driven by the mock controller -->
                <ui:VisualElement class="pr-progress">
                    <ui:Label text="KATA" class="pr-progress__label" picking-mode="Ignore" />
                    <ui:VisualElement name="practice-progress" class="pr-progress__pips">
                        <ui:VisualElement class="pr-pip" picking-mode="Ignore" />
                        <ui:VisualElement class="pr-pip" picking-mode="Ignore" />
                        <ui:VisualElement class="pr-pip" picking-mode="Ignore" />
                        <ui:VisualElement class="pr-pip" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- responsive bottom action bar: width-capped, centered, wraps on narrow widths -->
                <ui:VisualElement class="pr-actionbar">
                    <!-- exit / back to the Lessons hub -->
                    <ui:Button name="go-techniques" class="pr-btn pr-btn--ghost tap-target-lg">
                        <ui:Label text="‹" class="pr-icon pr-icon--action pr-btn__icon pr-btn__icon--lead" picking-mode="Ignore" />
                        <ui:Label text="Lessons" class="pr-btn__text" picking-mode="Ignore" />
                    </ui:Button>
                    <!-- local mock action (NOT a go- navigator); controller-bound name -->
                    <ui:Button name="practice-action" class="pr-btn pr-btn--primary tap-target-lg">
                        <ui:Label text="Begin" class="pr-btn__text" picking-mode="Ignore" />
                        <ui:Label text="▸" class="pr-icon pr-icon--action pr-btn__icon" picking-mode="Ignore" />
                    </ui:Button>
                    <!-- completion route → Lessons. Controller enables this only at completion. -->
                    <ui:Button name="practice-complete" class="pr-btn pr-btn--complete tap-target-lg">
                        <ui:Label text="Complete" class="pr-btn__text" picking-mode="Ignore" />
                        <ui:Label text="✓" class="pr-icon pr-icon--action pr-btn__icon" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 9 - MAP (full-viewport cinematic Map presentation rebuilt from the
             approved reference: checkpoints drawn directly over the map; Okinawa
             is the only playable destination for this MVP, so its docked,
             full-height right-side cinematic preview panel is already open and
             its preview already selected the moment the screen is entered —
             title/description/stats/CTA laid directly over the video itself) -->
        <ui:VisualElement name="map" class="screen map-screen">
            <Style src="Map/Map.uss" />
            <!-- full-bleed background layer, OUTSIDE the safe-area wrapper —
                 same shared shape as every other screen with bound media
                 (see BackgroundMediaUxmlTests). map-bg-media is disabled here
                 (Map.uss "#map-bg-media") since the pan/zoom canvas art below
                 is the only visible map image; the element + its
                 BackgroundMediaController binding are kept so the shared
                 background-media wiring stays untouched for Title/Home/Combine. -->
            <ui:VisualElement class="map-bg" picking-mode="Ignore">
                <ui:VisualElement name="map-bg-media" picking-mode="Ignore" class="bg-media" />
                <ui:VisualElement class="map-scrim" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="map-root">

                <!-- Japan world map: full-bleed pannable/zoomable canvas
                     (japan_map_final.jpg) with real UI Toolkit chapter/city
                     marker buttons — never baked into the art, never a
                     permanently reserved side column. See
                     MapPanZoomController(screenId="map", viewport="map-stage",
                     canvas="map-canvas") and JapanMapController. -->
                <ui:VisualElement name="map-stage" class="pan-stage">
                    <ui:VisualElement name="map-canvas" class="pan-canvas">
                        <ui:VisualElement class="map-canvas-art" picking-mode="Ignore" />
                        <ui:VisualElement class="pan-canvas-scrim" picking-mode="Ignore" />

                        <!-- Плывущий слой: семь облаков на трёх полосах
                             глубины, см. MapWindLayout. Объявлен здесь, а не
                             рядом со слоем рамки внизу, намеренно: тут он
                             красится над артом карты, но ПОД маркерами.
                             Размер и высоту пишет MapWindLayout.Apply при
                             показе и на смене размера; путь, крен, набухание и
                             прозрачность считает MapWindLayer.Tick. Классы
                             текстур переиспользуют те же четыре PNG, что и
                             рамка. -->
                        <ui:VisualElement name="map-wind-layer" class="map-wind-layer" picking-mode="Ignore">
                            <ui:VisualElement name="map-wind-0" class="map-wind map-wind--left-01" picking-mode="Ignore" />
                            <ui:VisualElement name="map-wind-1" class="map-wind map-wind--right-01" picking-mode="Ignore" />
                            <ui:VisualElement name="map-wind-2" class="map-wind map-wind--left-02" picking-mode="Ignore" />
                            <ui:VisualElement name="map-wind-3" class="map-wind map-wind--right-01" picking-mode="Ignore" />
                            <ui:VisualElement name="map-wind-4" class="map-wind map-wind--left-01" picking-mode="Ignore" />
                            <ui:VisualElement name="map-wind-5" class="map-wind map-wind--bottom-01" picking-mode="Ignore" />
                            <ui:VisualElement name="map-wind-6" class="map-wind map-wind--left-01" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- Chapter 0: unlocked, current starting chapter. Position
                             (style.left/top, percent) is applied at bind time by
                             JapanMapController from MapMarkerLayout.Chapters — not
                             hardcoded here or in Map.uss. Icon is the final supplied
                             chapter_okinawa.png marker (its own emblem baked in, no
                             extra circle/backing plate). Label comes BEFORE the icon
                             in markup (rendered above it) so the node's own bottom
                             edge is the icon's bottom edge — MapMarkerLayout's
                             coordinates are the pin's bottom TIP, and ".chapter-node"
                             anchors via "translate: -50% -100%" in Map.uss. -->
                        <ui:Button name="chapter-node-okinawa" class="chapter-node chapter-node--okinawa tap-target-lg">
                            <!-- Тень объявлена первой, чтобы красилась под всем
                                 остальным. Она absolute, поэтому колоночную
                                 раскладку узла не трогает и привязка кончика
                                 пина остаётся прежней. -->
                            <ui:VisualElement class="chapter-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="OKINAWA" class="chapter-node__label" picking-mode="Ignore" />
                            <!-- Обёртка дыхания: ambient пишет scale ИМЕННО ей,
                                 а состояние выбора живёт на самой иконке. Два
                                 вложенных transform перемножаются сами, и
                                 инлайн-стиль ambient не затирает USS выбора. -->
                            <ui:VisualElement class="chapter-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="chapter-node__icon chapter-node__icon--okinawa" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <!-- Волна от тапа объявлена ПОСЛЕДНЕЙ, чтобы красилась
                                 поверх иконки — как и тень, absolute и не трогает
                                 колоночную раскладку/привязку кончика пина. -->
                            <ui:VisualElement class="chapter-node__ripple" picking-mode="Ignore" />
                        </ui:Button>

                        <!-- Chapter 1: visible, tappable, locked for now. -->
                        <ui:Button name="chapter-node-fukuoka" class="chapter-node chapter-node--fukuoka chapter-node--locked tap-target-lg">
                            <ui:VisualElement class="chapter-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="FUKUOKA" class="chapter-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="chapter-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="chapter-node__icon chapter-node__icon--fukuoka" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="chapter-node__ripple" picking-mode="Ignore" />
                        </ui:Button>

                        <!-- Chapter 2: visible, tappable, locked for now. -->
                        <ui:Button name="chapter-node-hiroshima" class="chapter-node chapter-node--hiroshima chapter-node--locked tap-target-lg">
                            <ui:VisualElement class="chapter-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="HIROSHIMA" class="chapter-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="chapter-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="chapter-node__icon chapter-node__icon--hiroshima" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="chapter-node__ripple" picking-mode="Ignore" />
                        </ui:Button>

                        <!-- Map Pass 3B decorative cloud overlay (corrected
                             architecture): a child of THIS "pan-canvas", the same
                             transformed map-artboard the art and markers above
                             live in — so clouds pan/zoom together with the map,
                             never fixed to the viewport. Declared LAST so it
                             paints above the map art/markers (picking-mode:Ignore
                             at rest still lets taps reach markers underneath).
                             Rests at MapCloudLayout.JapanRest, positioned as a
                             source-image-normalized rectangle converted through
                             the same cover-fit crop as marker coordinates (see
                             MapCloudLayout.Apply/MapCoordinateMapping.SourceRectToViewport).
                             MapCloudTransitionController animates it during a
                             Japan<->Okinawa chapter transition. The layer's own
                             picking-mode is the input-lock switch during a
                             transition (Position while locked, Ignore at rest) —
                             the four cloud sprites themselves always stay
                             non-picking; pan/wheel/pinch are separately guarded
                             in MapPanZoomController. -->
                        <ui:VisualElement name="map-cloud-layer" class="map-cloud-layer" picking-mode="Ignore">
                            <ui:VisualElement name="map-cloud-right-01" class="map-cloud map-cloud--right-01" picking-mode="Ignore" />
                            <ui:VisualElement name="map-cloud-left-01" class="map-cloud map-cloud--left-01" picking-mode="Ignore" />
                            <ui:VisualElement name="map-cloud-left-02" class="map-cloud map-cloud--left-02" picking-mode="Ignore" />
                            <ui:VisualElement name="map-cloud-bottom-01" class="map-cloud map-cloud--bottom-01" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- toggled to picking-mode:Position only while the chapter
                         panel is open, so a tap "elsewhere" on the map closes it
                         (JapanMapController). -->
                    <ui:VisualElement name="map-outside-catcher" class="map-outside-catcher" picking-mode="Ignore" />
                </ui:VisualElement>

                <!-- chapter detail OVERLAY panel: slides in over the map on
                     marker selection (see Map.uss ".detail-panel"). Never a
                     permanently reserved column, never auto-selected on entry.
                     Content (title/desc/CTA/video) is updated per selection by
                     JapanMapController. -->
                <ui:VisualElement name="chapter-panel" class="detail-panel" picking-mode="Ignore">
                    <ui:VisualElement name="chapter-panel-video" picking-mode="Ignore" class="detail-panel__video" />
                    <ui:VisualElement class="detail-panel__overlay detail-panel__overlay--1" picking-mode="Ignore" />
                    <ui:VisualElement class="detail-panel__overlay detail-panel__overlay--2" picking-mode="Ignore" />
                    <ui:Label name="chapter-panel-video-fallback" text="Preview unavailable" class="detail-panel__video-fallback" picking-mode="Ignore" />

                    <ui:VisualElement class="detail-panel__content">
                        <ui:Label name="chapter-panel-eyebrow" text="CHAPTER 0" class="detail-panel__eyebrow" />
                        <ui:Label name="chapter-panel-title" text="OKINAWA" class="detail-panel__title" />
                        <ui:Label name="chapter-panel-desc" text="Your journey begins here. Establish your baseline, learn the foundations, and unlock the path ahead." class="detail-panel__desc" />
                        <ui:Label name="chapter-panel-meta" text="6 LEVELS" class="detail-panel__meta" />

                        <!-- local controller-bound action (NOT a "go-" navigator):
                             JapanMapController plays the ink-fade transition then
                             routes to the "mapOkinawa" screen. Only enabled for
                             an unlocked, selected chapter. -->
                        <ui:Button name="chapter-panel-cta" class="detail-panel__cta tap-target-lg">
                            <ui:Label name="chapter-panel-cta-text" text="ENTER CHAPTER" class="detail-panel__cta-text" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- brief ink-fade used only for the Japan -> Okinawa chapter
                     transition (JapanMapController). -->
                <ui:VisualElement name="map-transition-overlay" class="map-transition-overlay" picking-mode="Ignore" />

                <!-- Проявление карты при входе: три чернильных пятна расходятся
                     и гаснут. Существует только на время церемонии — в покое
                     полностью прозрачен и не участвует ни в отрисовке, ни в
                     попадании, поэтому постоянного полноэкранного слоя это не
                     добавляет. -->
                <ui:VisualElement name="map-inkwash" class="map-inkwash" picking-mode="Ignore">
                    <ui:VisualElement class="map-inkwash__blot map-inkwash__blot--a" picking-mode="Ignore" />
                    <ui:VisualElement class="map-inkwash__blot map-inkwash__blot--b" picking-mode="Ignore" />
                    <ui:VisualElement class="map-inkwash__blot map-inkwash__blot--c" picking-mode="Ignore" />
                </ui:VisualElement>

                <!-- top quick-access HUD: translucent dark-glass overlay ON
                     TOP of the map stage (see Map.uss ".map-topbar"), not a
                     row that pushes it down — declared after the stage/
                     panels/transition overlay so it always paints above
                     them, but before the Settings modal so an open modal
                     still covers it. Clean text navigation (Menu / Map /
                     Techniques / Profile / Settings), no pill/bubble styling; "Map"
                     carries the active-section accent since the player is
                     always somewhere in the Map flow here. Settings is a
                     worded item like the rest, not a corner icon. Visible on both the Japan and
                     Okinawa map screens (see JapanMapController). -->
                <ui:VisualElement class="map-topbar">
                    <ui:VisualElement class="map-topbar__nav">
                        <ui:Button name="map-topbar-map" class="map-topbar__nav-btn map-topbar__nav-btn--active tap-target">
                            <ui:VisualElement class="map-topbar__nav-btn-halo map-topbar__nav-btn-halo--map" picking-mode="Ignore">
                                <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--outer" picking-mode="Ignore" />
                                <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--middle" picking-mode="Ignore" />
                                <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--inner" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label text="Map" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                            <ui:VisualElement class="map-topbar__nav-btn-underline map-topbar__nav-btn-underline--map" picking-mode="Ignore">
                                <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--a" picking-mode="Ignore" />
                                <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--b" picking-mode="Ignore" />
                                <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--c" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="map-topbar-techniques" class="map-topbar__nav-btn tap-target">
                            <ui:Label text="Techniques" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="map-topbar-stats" class="map-topbar__nav-btn tap-target">
                            <ui:Label text="Profile" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="map-topbar-settings" class="map-topbar__nav-btn tap-target">
                            <ui:Label text="Settings" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="map-topbar__right">
                        <ui:VisualElement class="map-topbar__status">
                            <ui:Label name="map-topbar-level" text="LVL 1" class="map-topbar__level" />
                            <ui:Label name="map-topbar-xp" text="320 / 500 XP" class="map-topbar__xp" />
                            <ui:VisualElement class="map-topbar__xp-bar" picking-mode="Ignore">
                                <ui:VisualElement class="map-topbar__xp-bar__fill" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SETTINGS ("map-topbar-settings" above) now opens the one
                     shared Settings modal (see the "shared-settings-modal"
                     element at the end of this file, and
                     SettingsModalController) — no local modal here anymore. -->

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 9b - MAP / OKINAWA CHAPTER MAP (landscape mobile). Reached via
             "ENTER CHAPTER" from the Japan world map. LVL 0-5 level nodes over
             the full-bleed pannable okinawa_map_final.jpg; the top bar's Map
             button returns to the Japan world map. See
             MapPanZoomController(screenId="mapOkinawa", viewport="okinawa-stage",
             canvas="okinawa-canvas") and OkinawaMapController. -->
        <ui:VisualElement name="mapOkinawa" class="screen map-screen">
            <Style src="Map/Map.uss" />

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="map-root">

                <ui:VisualElement name="okinawa-stage" class="pan-stage">
                    <ui:VisualElement name="okinawa-canvas" class="pan-canvas">
                        <ui:VisualElement class="okinawa-canvas-art" picking-mode="Ignore" />
                        <ui:VisualElement class="pan-canvas-scrim" picking-mode="Ignore" />

                        <!-- Плывущий слой Окинавы. Полосы те же, что на
                             Японии, см. MapWindLayout: композиция полос от
                             экрана не зависит. -->
                        <ui:VisualElement name="okinawa-wind-layer" class="map-wind-layer" picking-mode="Ignore">
                            <ui:VisualElement name="okinawa-wind-0" class="map-wind map-wind--left-01" picking-mode="Ignore" />
                            <ui:VisualElement name="okinawa-wind-1" class="map-wind map-wind--right-01" picking-mode="Ignore" />
                            <ui:VisualElement name="okinawa-wind-2" class="map-wind map-wind--left-02" picking-mode="Ignore" />
                            <ui:VisualElement name="okinawa-wind-3" class="map-wind map-wind--right-01" picking-mode="Ignore" />
                            <ui:VisualElement name="okinawa-wind-4" class="map-wind map-wind--left-01" picking-mode="Ignore" />
                            <ui:VisualElement name="okinawa-wind-5" class="map-wind map-wind--bottom-01" picking-mode="Ignore" />
                            <ui:VisualElement name="okinawa-wind-6" class="map-wind map-wind--left-01" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- LVL 0-8: Okinawa's mission set (1 Special + 4
                             Training + 3 Fight + 1 Boss Fight, see
                             MapMarkerLayout.Missions). Position (style.left/top,
                             percent) and mission-type icon class are both applied at
                             bind time by OkinawaMapController from
                             MapMarkerLayout.Missions — the "level-node__icon" element
                             below is intentionally generic in markup; its type modifier
                             class is never hardcoded here so mission type stays
                             centralized in one place, not inferred from static CSS.
                             Icon is one of the four final supplied mission markers
                             (mission_lvl0.png / mission_training.png /
                             mission_fight.png / mission_boss.png), shown as-is with no
                             extra circle/backing plate. Label comes BEFORE the icon in
                             markup (rendered above it) so the node's own bottom edge is
                             the icon's bottom edge — MapMarkerLayout's coordinates are
                             the pin's bottom TIP, and ".level-node" anchors via
                             "translate: -50% -100%" in Map.uss. -->
                        <!-- LVL 0: unlocked (existing starting assessment flow). -->
                        <ui:Button name="level-node-0" class="level-node level-node--0 tap-target-lg">
                            <ui:VisualElement class="level-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="LVL 0" class="level-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="level-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="level-node__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="level-node__ripple" picking-mode="Ignore" />
                        </ui:Button>
                        <!-- LVL 1: visible but locked until Level1Unlocked. -->
                        <ui:Button name="level-node-1" class="level-node level-node--1 level-node--locked tap-target-lg">
                            <ui:VisualElement class="level-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="LVL 1" class="level-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="level-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="level-node__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="level-node__ripple" picking-mode="Ignore" />
                        </ui:Button>
                        <!-- LVL 2-8: visible but always locked for now; no
                             gameplay built for these yet. -->
                        <ui:Button name="level-node-2" class="level-node level-node--2 level-node--locked tap-target-lg">
                            <ui:VisualElement class="level-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="LVL 2" class="level-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="level-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="level-node__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="level-node__ripple" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="level-node-3" class="level-node level-node--3 level-node--locked tap-target-lg">
                            <ui:VisualElement class="level-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="LVL 3" class="level-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="level-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="level-node__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="level-node__ripple" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="level-node-4" class="level-node level-node--4 level-node--locked tap-target-lg">
                            <ui:VisualElement class="level-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="LVL 4" class="level-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="level-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="level-node__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="level-node__ripple" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="level-node-5" class="level-node level-node--5 level-node--locked tap-target-lg">
                            <ui:VisualElement class="level-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="LVL 5" class="level-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="level-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="level-node__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="level-node__ripple" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="level-node-6" class="level-node level-node--6 level-node--locked tap-target-lg">
                            <ui:VisualElement class="level-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="LVL 6" class="level-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="level-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="level-node__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="level-node__ripple" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="level-node-7" class="level-node level-node--7 level-node--locked tap-target-lg">
                            <ui:VisualElement class="level-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="LVL 7" class="level-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="level-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="level-node__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="level-node__ripple" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="level-node-8" class="level-node level-node--8 level-node--locked tap-target-lg">
                            <ui:VisualElement class="level-node__shadow" picking-mode="Ignore" />
                            <ui:Label text="LVL 8" class="level-node__label" picking-mode="Ignore" />
                            <ui:VisualElement class="level-node__breath" picking-mode="Ignore">
                                <ui:VisualElement class="level-node__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="level-node__ripple" picking-mode="Ignore" />
                        </ui:Button>

                        <!-- Map Pass 3B decorative cloud overlay (corrected
                             architecture) — see the "map" screen's
                             "map-cloud-layer" for the full explanation. A child
                             of THIS "okinawa-canvas", so it pans/zooms with the
                             Okinawa map art. Rests at MapCloudLayout.OkinawaRest. -->
                        <ui:VisualElement name="okinawa-cloud-layer" class="map-cloud-layer" picking-mode="Ignore">
                            <ui:VisualElement name="okinawa-cloud-right-01" class="map-cloud map-cloud--right-01" picking-mode="Ignore" />
                            <ui:VisualElement name="okinawa-cloud-left-01" class="map-cloud map-cloud--left-01" picking-mode="Ignore" />
                            <ui:VisualElement name="okinawa-cloud-left-02" class="map-cloud map-cloud--left-02" picking-mode="Ignore" />
                            <ui:VisualElement name="okinawa-cloud-bottom-01" class="map-cloud map-cloud--bottom-01" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="okinawa-outside-catcher" class="map-outside-catcher" picking-mode="Ignore" />
                </ui:VisualElement>

                <!-- level detail OVERLAY popup: unlike the shared ".detail-panel"
                     slide used by the Japan chapter panel, this one raises as a
                     SCROLL, requested by name by the product owner. Contract:
                     the outer container (".detail-panel", "scroll" modifier
                     below) never moves and only clips (overflow:hidden); the
                     ".scroll-panel__paper" inside it is what slides, via
                     translate, out from under the container's own top edge,
                     carrying the rod at its bottom edge along with it. Height
                     is never touched (animating it would be a full layout
                     pass every frame, exactly what this whole design avoids),
                     and scaling Y from 0 was rejected too because it would
                     squash the text. See Map.uss for the ".scroll-panel__*"
                     rules and OkinawaMapController for the "revealed"
                     modifier class that staggers the content in after the
                     paper has mostly unrolled. NOTE: XML comments can't
                     contain a literal double hyphen, so BEM modifier classes
                     are named here without their leading two dashes. -->
                <ui:VisualElement name="level-panel" class="detail-panel detail-panel--scroll" picking-mode="Ignore">
                    <ui:VisualElement name="level-panel-paper" class="scroll-panel__paper" picking-mode="Ignore">
                        <ui:VisualElement class="detail-panel__content">
                            <ui:Label name="level-panel-eyebrow" text="LEVEL" class="detail-panel__eyebrow" />
                            <ui:Label name="level-panel-title" text="LVL 0" class="detail-panel__title" />
                            <ui:Label name="level-panel-subtitle" text="ASSESSMENT" class="detail-panel__subtitle" />
                            <ui:Label name="level-panel-desc" text="Measure your starting ability and learn how Mikey evaluates your movement." class="detail-panel__desc" />

                            <!-- local controller-bound action (NOT a "go-" navigator):
                                 OkinawaMapController routes LVL 0 to "combineIntro"
                                 and LVL 1 to the existing lesson/techniques flow;
                                 disabled while locked. -->
                            <ui:Button name="level-panel-cta" class="detail-panel__cta tap-target-lg">
                                <ui:Label name="level-panel-cta-text" text="BEGIN" class="detail-panel__cta-text" picking-mode="Ignore" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement class="scroll-panel__rod" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- starts opaque; OkinawaMapController fades it out on entry,
                     completing the ink-fade begun by the Japan screen. -->
                <ui:VisualElement name="okinawa-transition-overlay" class="map-transition-overlay map-transition-overlay--visible" picking-mode="Ignore" />

                <!-- Клякса перехода: своя копия на КАЖДОМ экране карты.
                     Клякса маскирует кадр подмены экранов, поэтому обязана
                     жить на том экране, который в этот момент ПОЯВЛЯЕТСЯ:
                     единственная копия внутри японского экрана растворялась
                     бы целиком в скрытом поддереве, когда карта уходит на
                     Окинаву. См. MapCeremonyController.PlayTransitionBlot,
                     который выбирает копию по экрану назначения. В покое
                     display:none, так что постоянной цены не несёт. -->
                <ui:VisualElement name="okinawa-inkwash" class="map-inkwash" picking-mode="Ignore">
                    <ui:VisualElement class="map-inkwash__blot map-inkwash__blot--a" picking-mode="Ignore" />
                    <ui:VisualElement class="map-inkwash__blot map-inkwash__blot--b" picking-mode="Ignore" />
                    <ui:VisualElement class="map-inkwash__blot map-inkwash__blot--c" picking-mode="Ignore" />
                </ui:VisualElement>

                <!-- top quick-access HUD: same translucent dark-glass overlay
                     system as the Japan world map (see Map.uss ".map-topbar"
                     and the "map" screen's own copy of this block for the
                     full explanation). -->
                <ui:VisualElement class="map-topbar">
                    <ui:VisualElement class="map-topbar__nav">
                        <!-- Custom-wired (not a plain "go-" navigator): OkinawaMapController
                             must reset the session map context to Japan BEFORE navigating,
                             so this can't rely on ScreenManager's generic click wiring, whose
                             ordering relative to a second handler isn't guaranteed. -->
                        <ui:Button name="okinawa-topbar-map" class="map-topbar__nav-btn map-topbar__nav-btn--active tap-target">
                            <ui:VisualElement class="map-topbar__nav-btn-halo map-topbar__nav-btn-halo--map" picking-mode="Ignore">
                                <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--outer" picking-mode="Ignore" />
                                <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--middle" picking-mode="Ignore" />
                                <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--inner" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label text="Map" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                            <ui:VisualElement class="map-topbar__nav-btn-underline map-topbar__nav-btn-underline--map" picking-mode="Ignore">
                                <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--a" picking-mode="Ignore" />
                                <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--b" picking-mode="Ignore" />
                                <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--c" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="okinawa-topbar-techniques" class="map-topbar__nav-btn tap-target">
                            <ui:Label text="Techniques" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="okinawa-topbar-stats" class="map-topbar__nav-btn tap-target">
                            <ui:Label text="Profile" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="okinawa-topbar-settings" class="map-topbar__nav-btn tap-target">
                            <ui:Label text="Settings" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="map-topbar__right">
                        <ui:VisualElement class="map-topbar__status">
                            <ui:Label name="okinawa-topbar-level" text="LVL 1" class="map-topbar__level" />
                            <ui:Label name="okinawa-topbar-xp" text="320 / 500 XP" class="map-topbar__xp" />
                            <ui:VisualElement class="map-topbar__xp-bar" picking-mode="Ignore">
                                <ui:VisualElement class="map-topbar__xp-bar__fill" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SETTINGS ("okinawa-topbar-settings" above) now opens the
                     one shared Settings modal (see the "shared-settings-modal"
                     element at the end of this file, and
                     SettingsModalController) — no local modal here anymore. -->

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 10 - PROFILE / PLAYER DASHBOARD (landscape, read-only frontend data) -->
        <ui:VisualElement name="profile" class="screen profile-screen">
            <Style src="Profile/Profile.uss" />
            <!-- shared top-nav visual system (".map-topbar"), reused exactly as-is
                 — see the same note on the "techniques" screen above. -->
            <Style src="Map/Map.uss" />
            <!-- full-bleed Profile background, OUTSIDE the safe-area wrapper. The
                 supplied final art (profile_background.jpg) IS the background —
                 no generated decorative glow/enso shapes. -->
            <ui:VisualElement class="profile-bg" picking-mode="Ignore">
                <ui:VisualElement class="profile-scrim" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content">

            <!-- shared top quick-access HUD, exactly the same system as Map/
                 Okinawa/Techniques (see Map/Map.uss ".map-topbar"). Reuses the
                 SAME element names the old bottom dock used
                 (profile-nav-map/profile-nav-techniques/nav-profile) —
                 only relocated + restyled — so ProfileController's existing
                 Map/Techniques progression-gating (see ProfileProgressionTests)
                 needs no code changes at all. "Profile" carries the active
                 accent. Settings opens the one shared modal
                 (SettingsModalController — "profile-topbar-settings"). -->
            <ui:VisualElement class="map-topbar">
                <ui:VisualElement class="map-topbar__nav">
                    <ui:VisualElement name="profile-nav-map" class="map-topbar__nav-btn tap-target">
                        <ui:Label text="Map" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="profile-nav-techniques" class="map-topbar__nav-btn tap-target">
                        <ui:Label text="Techniques" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="nav-profile" class="map-topbar__nav-btn map-topbar__nav-btn--active tap-target" picking-mode="Ignore">
                        <ui:VisualElement class="map-topbar__nav-btn-halo map-topbar__nav-btn-halo--profile" picking-mode="Ignore">
                            <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--outer" picking-mode="Ignore" />
                            <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--middle" picking-mode="Ignore" />
                            <ui:VisualElement class="map-topbar__nav-btn-halo__layer map-topbar__nav-btn-halo__layer--inner" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label text="Profile" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                        <ui:VisualElement class="map-topbar__nav-btn-underline map-topbar__nav-btn-underline--profile" picking-mode="Ignore">
                            <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--a" picking-mode="Ignore" />
                            <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--b" picking-mode="Ignore" />
                            <ui:VisualElement class="map-topbar__nav-btn-underline__stroke map-topbar__nav-btn-underline__stroke--c" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="profile-topbar-settings" class="map-topbar__nav-btn tap-target">
                        <ui:Label text="Settings" class="map-topbar__nav-btn-text" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="map-topbar__right">
                    <ui:VisualElement class="map-topbar__status">
                        <ui:Label name="profile-topbar-level" text="LVL 1" class="map-topbar__level" />
                        <ui:Label name="profile-topbar-xp" text="320 / 500 XP" class="map-topbar__xp" />
                        <ui:VisualElement class="map-topbar__xp-bar" picking-mode="Ignore">
                            <ui:VisualElement class="map-topbar__xp-bar__fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- three-region composition: identity (left) / capability radar
                 (center, hero element) / current journey (right). Frontend
                 mock data throughout — see ProfileController for the single
                 centralized source of every placeholder value. -->
            <ui:VisualElement class="profile-layout">

                <!-- LEFT: identity / progression -->
                <ui:VisualElement class="profile-column profile-column--identity">
                    <ui:Label text="PROFILE" class="profile-kicker" />
                    <ui:VisualElement class="profile-name-row">
                        <ui:Label name="profile-display-name" text="Mikey" class="profile-name" />
                        <!-- Plain, unconditional navigation to Profile Details — no
                             gating, so a generic ScreenManager "go-" navigator needs
                             zero controller code (see ProfileDetailsController for
                             the screen it opens). -->
                        <ui:Button name="go-profileDetails" class="profile-name-edit-btn tap-target">
                            <ui:VisualElement class="profile-name-edit-icon" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="profile-role-row">
                        <ui:Label text="Disciple" class="profile-role" />
                        <ui:Label name="profile-identity-level" text="LVL 1" class="profile-role-level" />
                    </ui:VisualElement>

                    <ui:VisualElement class="profile-xp-bar">
                        <ui:VisualElement name="profile-xp-bar-fill" class="profile-xp-bar__fill" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="profile-xp-label" text="320 / 500 XP" class="profile-xp-label" />

                    <ui:VisualElement class="profile-identity-facts">
                        <ui:VisualElement class="profile-identity-fact">
                            <ui:Label text="3 Day Streak" class="profile-identity-fact__text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="profile-identity-fact">
                            <ui:Label text="Chapter 0 · Okinawa" class="profile-identity-fact__text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="profile-identity-fact">
                            <ui:Label text="1 Technique Learned" class="profile-identity-fact__text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- CENTER: five-sided capability radar — the hero element.
                     ProfileController mounts a ProfileRadarChart (custom
                     VisualElement, generateVisualContent/Painter2D — see
                     Assets/UI/Profile/ProfileRadarChart.cs) into this mount
                     point and drives its collapse->target entrance animation. -->
                <ui:VisualElement class="profile-column profile-column--radar">
                    <ui:VisualElement name="profile-radar-mount" class="profile-radar-mount" />
                </ui:VisualElement>

                <!-- RIGHT: current journey / training -->
                <ui:VisualElement class="profile-column profile-column--journey">
                    <ui:Label text="Current Journey" class="profile-section-title" />
                    <ui:Label text="Chapter 0" class="profile-journey-kicker" />
                    <ui:VisualElement class="profile-journey-row">
                        <ui:Label text="Okinawa" class="profile-journey-value" />
                        <ui:Label text="Level 1 of 6" class="profile-journey-meta" />
                    </ui:VisualElement>
                    <ui:VisualElement class="profile-journey-bar">
                        <ui:VisualElement class="profile-journey-bar__fill" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:Label text="Training" class="profile-section-title profile-section-title--spaced" />
                    <ui:VisualElement class="profile-training-list">
                        <ui:Label text="1 Technique Learned" class="profile-training-item" />
                        <ui:Label text="1 Assessment Completed" class="profile-training-item" />
                        <ui:Label text="3 Day Streak" class="profile-training-item" />
                    </ui:VisualElement>

                    <ui:Label text="Recent Milestone" class="profile-section-title profile-section-title--spaced profile-section-title--muted" />
                    <ui:Label text="First Assessment Complete" class="profile-milestone-value" />
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Attribute Details popup — a Profile-LOCAL overlay (no new screen
                 id), opened by tapping the radar itself (ProfileController wires
                 "profile-radar-mount"'s click) instead of a permanently-visible
                 guide that fought the background art for readability. Tapping the
                 scrim or Close dismisses it; opening/closing never touches
                 IScreenNavigator, so it can never replay the radar entrance
                 animation (that only reacts to ScreenChanged — see
                 ProfileController). Declared after ".profile-layout" so it paints
                 above the three-region composition. -->
            <ui:VisualElement name="profile-attribute-popup" class="profile-popup">
                <ui:VisualElement name="profile-attribute-popup-scrim" class="profile-popup__scrim" />
                <ui:VisualElement class="profile-popup__card profile-popup__card--wide">
                    <ui:Label text="Attributes" class="profile-popup__title" />
                    <ui:VisualElement class="profile-attribute-popup__grid">
                        <ui:VisualElement class="profile-attribute-popup__entry">
                            <ui:Label text="Strength" class="profile-attribute-popup__name" />
                            <ui:Label text="Measures power production and striking force. Higher Strength reflects your ability to generate force efficiently through movement." class="profile-attribute-popup__desc" />
                        </ui:VisualElement>
                        <ui:VisualElement class="profile-attribute-popup__entry">
                            <ui:Label text="Speed" class="profile-attribute-popup__name" />
                            <ui:Label text="Measures how quickly you move and react. Higher Speed reflects faster execution, transitions, and response time." class="profile-attribute-popup__desc" />
                        </ui:VisualElement>
                        <ui:VisualElement class="profile-attribute-popup__entry">
                            <ui:Label text="Form" class="profile-attribute-popup__name" />
                            <ui:Label text="Measures technical precision and correctness. Higher Form reflects cleaner positioning, mechanics, and execution of techniques." class="profile-attribute-popup__desc" />
                        </ui:VisualElement>
                        <ui:VisualElement class="profile-attribute-popup__entry">
                            <ui:Label text="Stamina" class="profile-attribute-popup__name" />
                            <ui:Label text="Measures endurance during repeated effort. Higher Stamina reflects your ability to maintain performance as a session becomes longer or more demanding." class="profile-attribute-popup__desc" />
                        </ui:VisualElement>
                        <ui:VisualElement class="profile-attribute-popup__entry">
                            <ui:Label text="Control" class="profile-attribute-popup__name" />
                            <ui:Label text="Measures balance, stability, and body control. Higher Control reflects your ability to stay composed, coordinated, and accurate throughout movement." class="profile-attribute-popup__desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="profile-attribute-popup-close" text="Close" class="profile-popup__close tap-target" />
                </ui:VisualElement>
            </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 10b - PROFILE DETAILS (Display Name / Gender / Age / Weight / Height).
             A proper full screen (not a popup), reached only from Profile's edit
             icon ("go-profileDetails") or the one-time incomplete-profile
             redirect (see ProfileController). Save validates everything and
             returns to "profile" (ProfileDetailsController); Cancel is a plain
             "go-profile" — nothing is written until Save, so there is nothing to
             "revert". Classified as a hub screen (see AudioController.HubScreenIds)
             so hub music never stops/restarts crossing into or out of it. Replaces
             the old Profile-local username-only popup entirely — this is now the
             ONE place Profile identity is edited. -->
        <ui:VisualElement name="profileDetails" class="screen profile-details-screen">
            <Style src="Profile/ProfileDetails.uss" />
            <!-- Reuses the same final Profile background art as the "profile"
                 screen (source bytes untouched) under a strong scrim, so this
                 stays atmospheric without ever competing with the form. -->
            <ui:VisualElement class="profile-details-bg" picking-mode="Ignore">
                <ui:VisualElement class="profile-details-scrim" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="safe-area-content">
            <ui:VisualElement class="profile-details-layout">

                <ui:VisualElement class="profile-details-form">
                    <!-- LEFT: heading + Display Name + Gender + Age -->
                    <ui:VisualElement class="profile-details-column">
                        <ui:Label text="Profile Details" class="profile-details-title" />
                        <ui:Label text="Tell Mikey about you. These details will help personalize your training." class="profile-details-subtitle" />

                        <ui:VisualElement class="profile-details-field">
                            <ui:Label text="Display Name" class="profile-details-field__label" />
                            <ui:TextField name="profile-details-display-name" max-length="24" class="profile-details-field__input" />
                            <ui:Label name="profile-details-display-name-error" text="" class="profile-details-field__error" />
                        </ui:VisualElement>

                        <ui:VisualElement class="profile-details-field">
                            <ui:Label text="Gender" class="profile-details-field__label" />
                            <ui:VisualElement name="profile-details-gender-group" class="profile-details-gender-group">
                                <ui:Button name="profile-details-gender-male" text="Male" class="profile-details-gender-option tap-target" />
                                <ui:Button name="profile-details-gender-female" text="Female" class="profile-details-gender-option tap-target" />
                                <ui:Button name="profile-details-gender-other" text="Other" class="profile-details-gender-option tap-target" />
                                <ui:Button name="profile-details-gender-undisclosed" text="Prefer not to say" class="profile-details-gender-option tap-target" />
                            </ui:VisualElement>
                            <ui:Label name="profile-details-gender-error" text="" class="profile-details-field__error" />
                        </ui:VisualElement>

                        <ui:VisualElement class="profile-details-field">
                            <ui:Label text="Age" class="profile-details-field__label" />
                            <ui:TextField name="profile-details-age" class="profile-details-field__input profile-details-field__input--narrow" />
                            <ui:Label name="profile-details-age-error" text="" class="profile-details-field__error" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- RIGHT: Weight + Height + a short explanatory note -->
                    <ui:VisualElement class="profile-details-column profile-details-column--right">
                        <ui:VisualElement class="profile-details-field">
                            <ui:Label text="Weight" class="profile-details-field__label" />
                            <ui:VisualElement class="profile-details-field__input-row">
                                <ui:TextField name="profile-details-weight" class="profile-details-field__input profile-details-field__input--narrow" />
                                <ui:Label text="kg" class="profile-details-field__unit" />
                            </ui:VisualElement>
                            <ui:Label name="profile-details-weight-error" text="" class="profile-details-field__error" />
                        </ui:VisualElement>

                        <ui:VisualElement class="profile-details-field">
                            <ui:Label text="Height" class="profile-details-field__label" />
                            <ui:VisualElement class="profile-details-field__input-row">
                                <ui:TextField name="profile-details-height" class="profile-details-field__input profile-details-field__input--narrow" />
                                <ui:Label text="cm" class="profile-details-field__unit" />
                            </ui:VisualElement>
                            <ui:Label name="profile-details-height-error" text="" class="profile-details-field__error" />
                        </ui:VisualElement>

                        <ui:Label text="Used to personalize future training statistics." class="profile-details-note" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="profile-details-actions">
                    <ui:Button name="go-profile" text="Cancel" class="profile-details-btn profile-details-btn--secondary tap-target" />
                    <ui:Button name="profile-details-save" text="Save" class="profile-details-btn profile-details-btn--primary tap-target" />
                </ui:VisualElement>

                <!-- Блок аккаунта. Вход необязателен: без него приложение
                     работает полностью, просто без резервной копии. Текст
                     согласия перечисляет данные о теле поимённо — человек
                     должен знать, что отправляет их о себе. Отдельный блок
                     под рядом Cancel/Save, а не внутри него: та строка узкая
                     (flex-direction: row), длинный текст согласия в ней был
                     бы сжат до нечитаемости. -->
                <ui:VisualElement name="account-panel" class="pd-account">
                    <ui:Label name="account-status" text="Прогресс хранится только на этом телефоне"
                              class="pd-account__status" />
                    <ui:Label name="account-consent"
                              text="Вход через Google сохранит на сервере имя, пол, возраст, вес, рост и результаты тренировок, чтобы прогресс вернулся после переустановки."
                              class="pd-account__consent" />
                    <ui:Button name="account-sign-in" class="pd-btn pd-btn--primary tap-target-lg">
                        <ui:Label text="Войти через Google" class="pd-btn__text" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="account-sign-out" class="pd-btn pd-btn--ghost tap-target-lg">
                        <ui:Label text="Выйти" class="pd-btn__text" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="account-delete" class="pd-btn pd-btn--danger tap-target-lg">
                        <ui:Label text="Удалить аккаунт" class="pd-btn__text" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 11 - SHARED SETTINGS MODAL (Music / Sound Effects / Trainer Voice).
             The ONE Settings window for the whole app — reachable from the
             Map hub's top bar and its siblings ("map-topbar-settings" /
             "okinawa-topbar-settings" / "techniques-topbar-settings" /
             "profile-topbar-settings"), all wired to
             THIS SAME element by SettingsModalController. Declared last, after
             every screen, so it always paints/hit-tests above whichever screen
             is currently active (ScreenManager only toggles screens'
             display:none/flex; this element isn't itself a screen and is never
             touched by ScreenManager). Closing only removes the modal's own
             "open" CSS class — it never navigates, so the screen underneath
             (and, on a map screen, its camera/chapter context) is always
             left exactly as it was. Hidden by default. -->
        <ui:VisualElement name="shared-settings-modal" class="settings-modal">
            <Style src="Settings/Settings.uss" />
            <ui:VisualElement class="settings-modal__card">
                <ui:Label text="Settings" class="settings-modal__title" />
                <ui:VisualElement class="setting">
                    <ui:Label text="Music" class="setting__label" />
                    <ui:Slider name="shared-settings-music" low-value="0" high-value="1" value="0.70" class="setting__slider" />
                </ui:VisualElement>
                <ui:VisualElement class="setting">
                    <ui:Label text="Sound Effects" class="setting__label" />
                    <ui:Slider name="shared-settings-sfx" low-value="0" high-value="1" value="1.00" class="setting__slider" />
                </ui:VisualElement>
                <ui:VisualElement class="setting">
                    <ui:Label text="Trainer Voice" class="setting__label" />
                    <ui:Slider name="shared-settings-trainer" low-value="0" high-value="1" value="1.00" class="setting__slider" />
                </ui:VisualElement>
                <!-- Одна настройка движения: выключает декоративный ambient-слой
                     карты целиком (см. MapAmbientController). Отклик на палец —
                     инерция пана и резинка — ею сознательно не управляется. -->
                <ui:VisualElement class="setting">
                    <ui:Label text="Reduced motion" class="setting__label" />
                    <ui:Toggle name="shared-settings-reduced-motion" class="setting__toggle" />
                </ui:VisualElement>
                <ui:Button name="shared-settings-close" text="Close" class="settings-modal__close tap-target" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 12 - LAUNCH TRANSITION OVERLAY: the one shared full-screen black fade
             used only by the Logo Intro -> Lore -> Main Menu launch sequence (see
             TransitionOverlayController / ITransitionOverlay, driven by
             TitleController and LoreExitController). Declared last, after every
             screen AND the shared Settings modal, so it always paints above
             whichever screen is currently active — same "declared last,
             self-managed, never touched by ScreenManager" pattern as
             shared-settings-modal above. Not a "screen" — ScreenManager never
             touches it. Starts fully transparent and click-through
             (picking-mode="Ignore"); TransitionOverlayController flips
             picking-mode to Position only while actively covering the screen. -->
        <ui:VisualElement name="transition-overlay" class="transition-overlay" picking-mode="Ignore" />

    </ui:VisualElement>
</ui:UXML>
