/* ============================================================
   Mikey (Ink & Dojo) — UI Toolkit theme
   Translated from ui-mockup/styles.css. Locked palette below.
   Painted art lands later; this is structure + the real colors.
   ============================================================ */

/* Palette + root. Custom properties cascade to all descendants. */
.mikey-app {
    --base: #0B0E11;     /* near-black charcoal */
    --bone: #EDE6D8;     /* warm bone / ivory   */
    --ember: #FF5A1F;    /* ember orange accent */
    --jade: #2BD9A8;     /* jade green accent   */
    --seal: #C8472E;     /* vermilion red seal  */
    --base-2: #12161B;   /* raised surface */
    --base-3: #1B2129;   /* card surface   */
    --line: #2A323C;     /* hairline border */
    --muted: #8B95A1;    /* muted text */

    flex-grow: 1;
    background-color: var(--base);
    color: var(--bone);
}

/* ---------- screens ---------- */
/* Each screen fills the panel; ScreenManager shows one at a time. */
.screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
    padding: 22px;
    background-color: var(--base);
}

/* Landscape content column: keeps screen content readable + centered on a
   wide display. The wide margins left/right are room for painted art later. */
.content {
    width: 100%;
    max-width: 720px;
    align-self: center;
    flex-grow: 1;
    flex-direction: column;
}

/* ---------- safe-area foreground wrapper ----------
   One per screen. Fills the screen's usable area and receives device
   safe-area insets (as padding) from SafeAreaController. Full-bleed siblings
   (.cam-feed, .title-bg) stay outside it. The alignment modifiers reproduce the
   per-screen alignment that otherwise lives on the .screen element. */
.safe-area-content {
    flex-grow: 1;
    width: 100%;
}
.safe-area-content.sa-center {
    align-items: center;
    justify-content: center;
}
.safe-area-content.sa-top-center {
    align-items: center;
    justify-content: flex-start;
}
.safe-area-content.sa-bottom-center {
    align-items: center;
    justify-content: flex-end;
}

/* ---------- typography ---------- */
.kicker {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--ember);
}
.title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--bone);
    margin-top: 6px;
    margin-bottom: 4px;
}
.lead {
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
}
.spacer {
    flex-grow: 1;
}

/* ---------- buttons ---------- */
.btn {
    width: 100%;
    padding: 20px;
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--base-3);
    color: var(--bone);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 14px;
}
/* smaller inline buttons (e.g. side-by-side camera actions) */
.btn.sm {
    padding: 14px;
    font-size: 15px;
    margin-top: 0;
}
.btn:hover {
    border-color: var(--bone);
}
.btn.primary {
    background-color: var(--ember);
    color: #1A0A03;
    border-color: var(--ember);
}

/* skip pill, top-right */
.skip {
    position: absolute;
    top: 18px;
    right: 18px;
    width: auto;
    margin-top: 0;
    padding: 6px 12px;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(0, 0, 0, 0.4);
    color: var(--muted);
    font-size: 12px;
    -unity-font-style: normal;
}

/* The Splash screen was retired: its single polished replacement is the Title
   entry screen (see Title/Title.uss). The old .splash / .logo-mark / .logo-glyph
   / .splash-title / .splash-tag styles were removed with that markup; no other
   screen referenced them. */

/* The Intro ("intro") screen is styled by its own modular stylesheet,
   Intro/Intro.uss (linked from the screen in MikeyApp.uxml), mirroring how the
   Home hub and Combine slice own their stylesheets. The previous inline
   .videobox / .videobox-label placeholder styles were removed with that
   portrait-origin markup; no other screen referenced them. The base .skip pill
   below is still shared by the Intro skip control. */

/* The Title ("title") entrance screen is styled by its own modular stylesheet,
   Title/Title.uss (linked from the screen in MikeyApp.uxml), mirroring how the
   Intro cold-open, Home hub and Combine slice own their stylesheets. The
   previous inline .title-screen / .got-sun / .title-block / .title-kanji /
   .title-name / .title-rule / .title-tag / .begin-btn / .tap-begin styles moved
   there with the redesign; no other screen referenced them. */

/* ---------- main menu / Home hub ----------
   The Home hub ("menu" screen) is styled by its own modular stylesheet,
   Home/Home.uss (linked from the screen in MikeyApp.uxml), mirroring how the
   Combine slice owns Combine/Combine.uss. The previous portrait-column menu
   styles (.topbar/.belt/.level-node/.bottomnav/.navbtn …) were removed with
   that markup; no other screen referenced them. */

/* ---------- stat list (Combine intro + results) ---------- */
.statlist {
    flex-direction: column;
    margin-top: 14px;
}
.stat {
    flex-direction: column;
    background-color: var(--base-2);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 10px;
}
.stat .sh {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}
.stat .sh-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--bone);
}
.stat .sh-meta {
    font-size: 12px;
    color: var(--muted);
}

/* ---------- camera screen (no painted background) ---------- */
.camera {
    padding: 22px;
    align-items: center;
    justify-content: flex-start;
    background-color: #05070A;
}
.cam-feed {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #0A0D11;
}
.live {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 20px;
    padding: 7px 13px;
    font-size: 12px;
    color: var(--bone);
}
.live .dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: var(--seal);
    margin-right: 8px;
}
.testname {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--bone);
    margin-top: 18px;
}
.counter {
    align-items: center;
    margin-top: 8px;
}
.counter .big {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--jade);
}
.counter .lbl {
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--muted);
}
.callout {
    margin-top: 14px;
    padding: 8px 14px;
    border-radius: 10px;
    background-color: rgba(255, 90, 31, 0.15);
    color: var(--ember);
    font-size: 13px;
}
.callout.good {
    background-color: rgba(43, 217, 168, 0.15);
    color: var(--jade);
}
.pose-box {
    width: 130px;
    height: 180px;
    border-width: 2px;
    border-color: var(--jade);
    border-radius: 14px;
    margin-top: 18px;
}
.cam-note {
    font-size: 12px;
    color: var(--muted);
    margin-top: 14px;
}
.cam-actions {
    flex-direction: row;
    width: 100%;
    max-width: 720px;
    margin-top: 18px;
}
.cam-actions .btn {
    flex-grow: 1;
    margin: 0 5px 0 5px;
    min-height: 48px; /* keep the camera actions reliably tappable */
}
