/* ============================================================
   Combine screen — LEVEL 0 checklist (locked design reference).
   Palette custom properties (--ember, --seal, --bone, …) cascade in
   from .mikey-app in theme.uss; this file only adds Combine-specific
   structure so the screen stays modular. Landscape-only: a left preview
   panel + a right checklist, matching the locked mockup's two-column
   composition.
   ============================================================ */

/* Full-bleed background layer. Lives OUTSIDE .safe-area-content so it
   bleeds under device insets, like .cam-feed / .title-bg on other screens.
   The real art (combine_background.png) is bound at the scene level onto
   combine-bg-media (see BackgroundMediaController) as a static image, same
   mechanism as the "map" screen — this color is only the pre-load fallback. */
.combine-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #0B0E11;
}

/* Legibility scrim over the background art — kept light so the supplied
   textured artwork still reads through, per the locked reference. */
.combine-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 8, 10, 0.35);
}

/* ---------- top bar: back (left) / menu glyph (right) ---------- */
.combine-topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}
.combine-back {
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
}
.combine-back__glyph {
    font-size: 30px;
    color: var(--bone);
}
.combine-menu {
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
}
.combine-menu__glyph {
    font-size: 26px;
    color: var(--bone);
    opacity: 0.85;
}

/* ---------- two-column layout ---------- */
.combine-layout {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
    align-items: stretch;
    margin-top: 6px;
}

/* LEFT: LEVEL 0 / COMBINE header + selected-test preview + START. */
.combine-left {
    width: 56%;
    flex-direction: column;
    padding-right: 22px;
    justify-content: flex-start;
}
.combine-kicker {
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--muted);
}
.combine-title {
    font-size: 46px;
    -unity-font-style: bold;
    color: var(--bone);
    margin-top: 2px;
}
.combine-progress {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--seal);
    margin-top: 6px;
    margin-bottom: 12px;
}

.combine-illustration {
    width: 100%;
    height: 200px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}
.combine-illustration--camera { background-image: url("/Assets/UI/Media/Images/combine/combine_camera.png"); }
.combine-illustration--pushups { background-image: url("/Assets/UI/Media/Images/combine/combine_pushups.png"); }
.combine-illustration--squats { background-image: url("/Assets/UI/Media/Images/combine/combine_squats.png"); }
.combine-illustration--wallsit { background-image: url("/Assets/UI/Media/Images/combine/combine_wallsit.png"); }
.combine-illustration--yokogeri { background-image: url("/Assets/UI/Media/Images/combine/combine_yokogeri.png"); }

.combine-test-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--bone);
}
.combine-test-desc {
    margin-top: 4px;
    max-width: 420px;
}
.combine-test-secondary {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--seal);
    margin-top: 8px;
}
.combine-test-stat {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--muted);
    margin-top: 10px;
}

/* Prominent painted START button — the supplied red brushstroke asset, not a
   generated shape. */
.combine-start-btn {
    width: 100%;
    max-width: 340px;
    height: 68px;
    margin-top: 20px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/UI/Media/Images/combine/combine_start_brush.png");
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}
.combine-start-btn__text {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--bone);
}

/* Legacy compatibility bridge CTA — visible only once all five tests are
   complete. Reuses the shared .btn.primary look (theme.uss) rather than the
   painted brush, since it is a distinct "leave Combine" action, not another
   test START. */
.combine-continue {
    max-width: 300px;
    margin-top: 12px;
}

/* Vertical brush-stroke divider between the two panels. */
.combine-divider-vertical {
    width: 26px;
    background-image: url("/Assets/UI/Media/Images/combine/combine_divider_vertical.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* RIGHT: the five-row checklist. */
.combine-checklist {
    width: 44%;
    flex-direction: column;
    padding-left: 22px;
    justify-content: center;
}

.combine-divider-horizontal {
    height: 12px;
    margin: 2px 0;
    background-image: url("/Assets/UI/Media/Images/combine/combine_divider_horizontal.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.combine-row {
    position: relative;
    flex-direction: row;
    align-items: center;
    padding: 12px 10px;
}
.combine-row__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    background-image: url("/Assets/UI/Media/Images/combine/combine_selected_red.png");
    -unity-background-scale-mode: scale-and-crop;
}
.combine-row--selected .combine-row__accent {
    display: flex;
}

.combine-row__index {
    width: 26px;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--muted);
    -unity-text-align: middle-left;
}
.combine-row__body {
    flex-grow: 1;
    flex-direction: column;
}
.combine-row__title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--bone);
}
.combine-row__secondary {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 2px;
}
.combine-row__icon {
    width: 22px;
    height: 22px;
    margin-left: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
.combine-row__icon--check {
    background-image: url("/Assets/UI/Media/Images/combine/combine_check.png");
}
.combine-row__icon--lock {
    background-image: url("/Assets/UI/Media/Images/combine/combine_lock.png");
}

/* Row state modifiers — locked rows read subdued, complete rows read
   readable-but-secondary, available/selected rows read brightest. */
.combine-row--locked .combine-row__index,
.combine-row--locked .combine-row__title {
    color: var(--muted);
    opacity: 0.55;
}
.combine-row--complete .combine-row__title {
    opacity: 0.8;
}
.combine-row--available .combine-row__title {
    color: var(--bone);
    opacity: 1;
}
.combine-row--selected .combine-row__title {
    color: var(--bone);
    opacity: 1;
}
