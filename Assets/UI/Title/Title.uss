/* ============================================================
   Logo Intro — startup/logo screen ("title"). The app's very first screen:
   a full-screen near-black background with the centered Mikey logo mark and
   nothing else (TitleController auto-advances to Lore after a short beat, or
   immediately on a tap/click anywhere). Palette custom properties (--base …)
   cascade in from .mikey-app in theme.uss; this file only adds Title-specific
   structure, same pattern as Home/Home.uss, Intro/Intro.uss.

   Deliberately minimal: no CTA, no subtitle, no background art/video (the
   retired title_loop.mp4 / ember-sun treatment is gone — see MikeyApp.uxml).
   When a dedicated logo-animation video (logo_intro.mp4) exists, only
   .title-logo needs to become a video target; the timer/tap-skip behavior in
   TitleController does not change.
   ============================================================ */

.title-screen {
    padding: 0;
    background-color: var(--base);
}

/* ---------- full-bleed background ----------
   Lives OUTSIDE .safe-area-content so it bleeds under device insets, like
   .intro-bg / .home-bg / .combine-bg on the other screens. Solid near-black:
   no art, no glow, no scrim — the screen IS the background. */
.title-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
}

/* ---------- centered logo mark (inside the safe area) ---------- */
.title-block {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.title-logo {
    width: 300px;
    height: 300px;
    max-width: 70%;
    max-height: 70%;
    background-image: url("/Assets/UI/Media/Images/mikey_logo.png");
    -unity-background-scale-mode: scale-to-fit;
}
