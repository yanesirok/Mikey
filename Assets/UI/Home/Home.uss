/* ============================================================
   Home hub — landscape "menu" screen styles.
   Palette custom properties (--ember, --jade, --bone, --base, …) cascade
   in from .mikey-app in theme.uss; this file only adds Home-specific
   structure so the hub stays modular (same pattern as Combine/Combine.uss).

   Landscape-first: wide, width-capped composition that fills 16:9 and
   wider phone-landscape ratios — deliberately NOT the old 720px portrait
   column. Translated from design-pull/assets/screens-home.jsx + theme.css.
   ============================================================ */

/* ---------- full-bleed background ----------
   Lives OUTSIDE .safe-area-content so it bleeds under device insets, like
   .cam-feed / .got-sun / .combine-bg on the other screens. Solid base + a
   soft ember glow stands in for painted art (which lands later), matching
   the reference's radial-gradient hero wash. */
.home-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    align-items: center;
}
.home-glow {
    position: absolute;
    top: -160px;
    width: 760px;
    height: 760px;
    border-radius: 380px;
    background-color: rgba(255, 90, 31, 0.06);
}

/* ---------- foreground layout ----------
   One full-height column inside the safe area: ribbon pinned top, hero
   filling the middle, dock pinned bottom. align-self centers the capped
   width bands on ultra-wide displays without a narrow portrait column. */
.home-layout {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}

/* ---------- reusable visible-icon kit (Home-scoped) ----------
   Sizes the ICON ARTWORK itself (the rendered glyph), independently of the
   button hit area. Every icon is non-shrinking and centered so flex never
   collapses the artwork, and the glyph stays large/recognizable even at
   phone-landscape sizes. Used alongside the per-context colour classes
   (.home-tab__glyph / .home-chip__glyph) which now only carry colour. */
.home-icon {
    flex-shrink: 0;
    align-self: center;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}
.home-icon--nav {
    /* bottom-nav visible icons: 40–44px target */
    font-size: 42px;
}
.home-icon--ribbon {
    /* top ribbon icons/glyphs: 30–36px target */
    font-size: 34px;
}
.home-icon--cta {
    /* primary CTA arrow: 30–36px target */
    font-size: 34px;
}

/* ---------- touch-target kit (Home-scoped) ----------
   .tap-target  — generic interactive control: >= 48x48 logical.
   .tap-target-lg — bottom-nav dock tabs: >= 56x56 logical.
   Both set flex-shrink:0 so flex never collapses a control below a tappable
   size (keeps the dock clickable at phone-landscape sizes), centre content,
   and add a real pressed-state scale so controls never feel dead. */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target:active {
    scale: 0.97;
}
.tap-target-lg {
    min-width: 56px;
    min-height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target-lg:active {
    scale: 0.97;
}

/* ---------- top profile / stat ribbon ---------- */
.home-ribbon {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1400px;
    align-self: center;
}
.home-belt {
    flex-direction: row;
    align-items: center;
}
/* belt/rank visual — at least 36px in its main dimension, non-shrinking */
.home-belt__swatch {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 9px;
    background-color: var(--bone);
    border-width: 1px;
    border-color: var(--line);
    margin-right: 12px;
}
.home-belt__rank {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--bone);
}
.home-belt__level {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--muted);
}
.home-stats {
    flex-direction: row;
    align-items: center;
}
.home-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(11, 14, 17, 0.45);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 22px;
    padding: 8px 16px;
    margin-left: 10px;
}
/* colour only — size comes from .home-icon--ribbon */
.home-chip__glyph {
    color: var(--ember);
    margin-right: 10px;
}
.home-chip__text {
    font-size: 13px;
    color: var(--bone);
}
.home-chip__text--coin {
    color: var(--jade);
}

/* ---------- hero / progression ---------- */
.home-hero {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}
.home-hero__card {
    flex-direction: row;
    align-items: center;
    width: 100%;
    max-width: 980px;
    align-self: center;
    background-color: rgba(18, 22, 27, 0.7);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 18px;
    padding: 34px;
}
/* session progress ring (focal), stands in for the SVG ring in the reference */
.home-ring {
    width: 168px;
    height: 168px;
    border-radius: 84px;
    border-width: 10px;
    border-color: rgba(237, 230, 216, 0.14);
    border-top-color: var(--ember);
    align-items: center;
    justify-content: center;
    margin-right: 36px;
    flex-shrink: 0;
}
.home-ring__value {
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--bone);
}
.home-ring__label {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--muted);
}
.home-hero__body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
}
.home-hero__kicker {
    letter-spacing: 3px;
}
.home-hero__title {
    font-size: 34px;
}
.home-hero__lead {
    margin-top: 4px;
    max-width: 520px;
}
/* CTA = text label + a separately-sized arrow icon, laid out in a row */
.home-hero__cta {
    max-width: 300px;
    margin-top: 20px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.home-cta__text {
    font-size: 18px;
    -unity-font-style: bold;
    color: #1A0A03;
}
.home-cta__arrow {
    color: #1A0A03;
    margin-left: 12px;
}

/* power ribbon — STR / SPD / AGI / END mock attributes */
.home-power {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 22px;
}
.home-power__cell {
    align-items: center;
    min-width: 88px;
    padding: 11px 18px;
    margin: 5px;
    background-color: rgba(11, 14, 17, 0.45);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 12px;
}
.home-power__key {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--muted);
}
.home-power__val {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--bone);
}

/* ---------- persistent bottom navigation dock ---------- */
.home-dock {
    flex-direction: row;
    width: 100%;
    max-width: 1100px;
    align-self: center;
    justify-content: center;
    margin-top: 16px;
}
.home-tab {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 240px;
    align-items: center;
    justify-content: center;
    padding: 10px 8px;
    margin: 0 6px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(11, 14, 17, 0.5);
}
/* colour only — size comes from .home-icon--nav */
.home-tab__glyph {
    color: rgba(237, 230, 216, 0.6);
}
.home-tab__label {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgba(237, 230, 216, 0.6);
    margin-top: 4px;
}
.home-tab__badge {
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--base);
    background-color: var(--muted);
    border-radius: 6px;
    padding: 1px 6px;
    margin-top: 4px;
}

/* active tab — unmistakable current state (ember accent, top rule) */
.home-tab--active {
    border-color: var(--ember);
    background-color: rgba(255, 90, 31, 0.12);
    border-top-width: 3px;
    border-top-color: var(--ember);
}
.home-tab--active .home-tab__glyph {
    color: var(--ember);
}
.home-tab--active .home-tab__label {
    color: var(--bone);
}

/* locked / "coming soon" tabs — clearly disabled but the icon stays readable
   (kept distinctly dimmer than the ember active tab, not near-invisible). */
.home-tab--locked {
    opacity: 0.6;
}
