/* ============================================================
   Main Menu — landscape "menu" screen styles.
   Palette custom properties (--ember, --bone, --base, …) cascade in from
   .mikey-app in theme.uss; this file only adds Main-Menu-specific structure
   so the screen stays modular (same pattern as Combine/Combine.uss).

   Rebuilt as a cinematic game main menu (video + logo + typography), not the
   old dashboard hub: no cards, no stats, no dock, no progression CTA. The
   full-bleed background layer keeps its original element/class names
   (.home-bg / #home-bg-media / .home-scrim) — BackgroundMediaController and
   its tests key off them by screen id ("menu") already; only the bound clip
   changed (main_menu_loop.mp4).
   ============================================================ */

/* ---------- full-bleed background video ----------
   Lives OUTSIDE .safe-area-content so it bleeds under device insets, like
   .cam-feed / .title-bg / .combine-bg on the other screens. */
.home-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    overflow: hidden;
}

/* Subtle legibility scrim over the cinematic so the logo/menu stay readable
   without obscuring the supplied video more than needed. */
.home-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 12, 0.32);
}

/* ---------- touch-target kit (Home-scoped) ---------- */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target:active {
    scale: 0.97 0.97;
}
.tap-target-lg {
    min-width: 56px;
    min-height: 56px;
    flex-shrink: 0;
}
.tap-target-lg:active {
    scale: 0.97 0.97;
}

/* ---------- foreground layout ----------
   Logo pinned upper-left (absolute, so it never disturbs the nav's own
   layout); the vertical nav fills the right side, vertically centered. */
.home-layout {
    flex-grow: 1;
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.home-logo {
    position: absolute;
    top: 20px;
    left: 6px;
    width: 156px;
    height: 156px;
    background-image: url("/Assets/UI/Media/Images/mikey_logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- right-side vertical navigation ----------
   Premium game-menu navigation: spacing and typography carry the hierarchy,
   not rounded card containers. Strong hover/focus/pressed states. */
.home-nav {
    flex-direction: column;
    align-items: flex-end;
    padding-right: 8px;
}
.home-nav__item {
    background-color: transparent;
    border-width: 0;
    border-right-width: 3px;
    border-right-color: transparent;
    border-radius: 0;
    margin: 10px 0;
    padding: 8px 26px 8px 46px;
    color: rgba(237, 230, 216, 0.78);
}
.home-nav__item:hover,
.home-nav__item:focus {
    color: var(--bone);
    border-right-color: var(--ember);
}
.home-nav__item:active {
    scale: 0.97 0.97;
}
.home-nav__label {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-right;
}

/* ---------- individual per-item brushstroke backings ----------
   Each nav item gets its OWN separate real ink-swipe backing (the supplied
   menu_brushstroke.png) — never one shared panel/band behind the whole nav.
   One reusable recipe (this base class) shared by all four items; only each
   item's width/crop is tuned per word via a small modifier class below,
   since USS can't measure rendered text width.

   The source PNG is a square 2500x2500 canvas with the actual painted swipe
   sitting in a horizontal band roughly through its vertical middle
   (opaque bounds measured at x:[77,2371] y:[977,1412]). Rather than editing
   the PNG bytes, each modifier crops straight to that ink band using
   background-size (scales the whole canvas up/down, non-uniformly — wider
   for longer words, same height for every item) plus background-position
   (shifts the scaled canvas so the ink band's top-left lands on the
   element's own top-left corner) — the same technique as a CSS
   "background-size: cover" crop, computed by hand per word. Horizontal
   scale varies per word (stretching sideways is expected/fine); vertical
   scale is identical for all four so every stroke reads at the same
   height and is never stretched taller/shorter than the others.

   Anchored to the item's own right padding (26px) so it centers under the
   right-aligned label regardless of the button's wider, asymmetric left
   padding — not centered on the button itself. Declared before the label
   in the markup, so it paints underneath it (later siblings paint on top);
   ignores picking, so it never affects the button's own click area. */
.home-nav__stroke {
    position: absolute;
    top: 50%;
    right: 26px;
    height: 44px;
    translate: 0 -50%;
    background-image: url("/Assets/UI/Media/Images/MainMenu/menu_brushstroke.png");
    background-repeat: no-repeat;
    background-position-y: top -99px;
    opacity: 0.35;
}

/* Per-word crop: background-size scales the full 2500x2500 canvas so the
   ink band's height always maps to the shared 44px above; background-size's
   width and background-position-x vary per word to control how much of the
   canvas's horizontal ink width is visible (and therefore the stroke's
   overall on-screen width) while cropping the same relative left margin. */
.home-nav__stroke--play {
    width: 170px;
    background-size: 185px 253px;
    background-position-x: left -6px;
}
.home-nav__stroke--plans {
    width: 210px;
    background-size: 229px 253px;
    background-position-x: left -7px;
}
.home-nav__stroke--settings {
    width: 320px;
    background-size: 349px 253px;
    background-position-x: left -11px;
}
.home-nav__stroke--quit {
    width: 150px;
    background-size: 163px 253px;
    background-position-x: left -5px;
}

/* QUIT is deliberately the lowest-priority action: same typography kit as
   PLAY/PLANS/SETTINGS, set apart only by extra separation and a dimmer
   default color (never smaller, never hidden). */
.home-nav__item--quit {
    margin-top: 30px;
    color: rgba(237, 230, 216, 0.5);
}
.home-nav__item--quit:hover,
.home-nav__item--quit:focus {
    color: var(--bone);
}

/* ---------- Plans / Settings modal overlays ----------
   A full-bleed dim backdrop + a centered card, layered on top of the Main
   Menu (still a child of the "menu" screen, not a second .safe-area-content).
   Hidden by default (display:none) — the safe markup default — and toggled
   by HomeController. The menu video/music underneath is untouched by this. */
.menu-modal {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 8, 10, 0.72);
}
.menu-modal__card {
    width: 440px;
    max-width: 86%;
    background-color: var(--base-3);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 20px;
    padding: 36px;
    align-items: center;
}
.menu-modal__title {
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--ember);
}
.menu-modal__body {
    font-size: 19px;
    color: var(--bone);
    margin-top: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
}
.menu-modal__close {
    margin-top: 30px;
    min-width: 160px;
}

/* Settings ("menu-settings-open" in MikeyApp.uxml) now opens the one shared
   Settings modal (see Assets/UI/Settings/Settings.uss and
   SettingsModalController) — the old local ".menu-setting*" rows were
   retired with it. ".menu-modal" above remains: it's still used by the
   separate Plans overlay. */
