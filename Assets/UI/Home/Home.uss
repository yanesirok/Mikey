/* ============================================================
   Sign In — landscape "menu" screen styles.
   Palette custom properties (--ember, --bone, --base, …) cascade in from
   .mikey-app in theme.uss; this file only adds Sign-In-specific structure
   so the screen stays modular (same pattern as Combine/Combine.uss).

   Rebuilt again as the app's Sign In screen: the same cinematic video + logo,
   with one bottom-centered row of round, icon-only account buttons instead of
   the retired PLAY/VOW/SETTINGS/QUIT typography menu. The
   full-bleed background layer keeps its original element/class names
   (.home-bg / #home-bg-media / .home-scrim) — BackgroundMediaController and
   its tests key off them by screen id ("menu") already; only the bound clip
   changed (main_menu_loop.mp4).
   ============================================================ */

/* ---------- full-bleed background video ----------
   Lives OUTSIDE .safe-area-content so it bleeds under device insets, like
   .cam-feed / .title-bg / .combine-bg on the other screens. */
.home-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    overflow: hidden;
}

/* Subtle legibility scrim over the cinematic so the logo/menu stay readable
   without obscuring the supplied video more than needed. */
.home-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 12, 0.32);
}

/* ---------- touch-target kit (Home-scoped) ---------- */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target:active {
    scale: 0.97 0.97;
}
.tap-target-lg {
    min-width: 56px;
    min-height: 56px;
    flex-shrink: 0;
}
.tap-target-lg:active {
    scale: 0.97 0.97;
}

/* ---------- foreground layout ----------
   Logo pinned upper-left (absolute, so it never disturbs the account row's own
   layout); the account row sits bottom-centered, the shape every mobile game
   login screen uses. */
.home-layout {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 36px;
}

.home-logo {
    position: absolute;
    top: 20px;
    left: 6px;
    width: 156px;
    height: 156px;
    background-image: url("/Assets/UI/Media/Images/mikey_logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- account row ----------
   Icon-only round buttons — the Google mark and the guest glyph carry the
   meaning, there is no worded menu on this screen at all. Both are the same
   size and the same shape: the guest option is set apart by a dimmer ring,
   never by being smaller or hidden. */
.home-auth {
    align-items: center;
}
.home-auth__row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.home-auth__btn {
    width: 72px;
    height: 72px;
    margin: 0 16px;
    padding: 0;
    background-color: rgba(10, 12, 14, 0.55);
    border-width: 2px;
    border-color: rgba(237, 230, 216, 0.38);
    border-radius: 36px;
    align-items: center;
    justify-content: center;
}
.home-auth__btn:hover,
.home-auth__btn:focus {
    background-color: rgba(10, 12, 14, 0.78);
    border-color: var(--ember);
}
.home-auth__btn:active {
    scale: 0.94 0.94;
}
/* Disabled only while the system account dialog is up (HomeController). */
.home-auth__btn:disabled {
    opacity: 0.4;
}
/* Guest is the quieter of the two: dimmer ring, same size and reach. */
.home-auth__btn--guest {
    border-color: rgba(237, 230, 216, 0.22);
}
.home-auth__btn--guest:hover,
.home-auth__btn--guest:focus {
    border-color: var(--ember);
}

.home-auth__icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}
.home-auth__icon--google {
    background-image: url("/Assets/UI/Media/Images/MainMenu/google_icon.png");
}
.home-auth__icon--guest {
    background-image: url("/Assets/UI/Media/Images/MainMenu/guest_icon.png");
    opacity: 0.82;
}

/* One inline status line under the row: empty by default, so the screen shows
   nothing but the two icons until there is something honest to report. */
.home-auth__status {
    margin-top: 14px;
    height: 20px;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(237, 230, 216, 0.7);
    -unity-text-align: middle-center;
    white-space: normal;
}
