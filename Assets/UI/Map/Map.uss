/* ============================================================
   Map — mobile-first fullscreen Map rebuild. Palette custom properties
   (--ember, --seal, --bone, --base, --muted, --line …) cascade in from
   .mikey-app in theme.uss; this file only adds Map-specific structure so the
   screen stays modular (same pattern as Home/Home.uss, Techniques/Techniques.uss).

   The map itself is always full-screen/dominant (no permanently-reserved side
   column eating width): a top quick-access bar (Home / MAP / TECHNIQUES /
   STATS, Settings, Level · XP), then the pannable/zoomable map canvas fills
   all remaining space. The LVL0/LVL1 detail panel is an OVERLAY docked to the
   right, hidden by default (display:none) and toggled open by
   MapLevelPreviewController — never a layout-affecting sibling — so there is
   never a permanent side column or empty letterboxed gap. Reuses the existing
   asia_map.jpeg ink-wash artwork (previously the disabled legacy full-screen
   background) as the pannable canvas backdrop; the old flattened
   japan_route_map_mvp(@2x).png composition with baked Okinawa/Tohokku/Kanto
   text is retired — checkpoint labels are now real UI Toolkit elements
   ("LVL 0" / "LVL 1"), not baked into an image. Pan/zoom transform mechanics
   live in MapPanZoomController (a separate, focused controller); this
   stylesheet only defines the .map-stage/.map-canvas structure it drives.
   ============================================================ */

/* ---------- full-bleed background ----------
   Lives OUTSIDE .safe-area-content so it bleeds under device insets, like
   .home-bg / .tq-bg / .cam-feed on the other screens. Solid neutral base —
   visible only at the pannable canvas's zoomed-out/panned-away edges. */
.map-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
}

/* ---------- touch-target kit (Map-scoped) ---------- */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target:active {
    scale: 0.97;
}
.tap-target-lg {
    min-width: 56px;
    min-height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target-lg:active {
    scale: 0.97;
}

/* ---------- full-viewport layout ---------- */
.map-layout {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
}

/* ---------- top quick-access bar ----------
   Fixed height, full width, solid backing so it stays readable over the
   map/panel regardless of what's beneath it. Left cluster: Home + MAP /
   TECHNIQUES / STATS. Right cluster: Settings + Level/XP (mock). */
.map-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 64px;
    padding: 0 20px;
    background-color: rgba(11, 14, 17, 0.72);
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}
.map-topbar__tabs {
    flex-direction: row;
    align-items: center;
}
.map-topbar__home {
    color: rgba(237, 230, 216, 0.6);
    font-size: 22px;
    -unity-font-style: bold;
    margin-right: 18px;
    padding: 6px 4px;
}
.map-topbar__home:hover {
    color: var(--bone);
}
.map-topbar__tab {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    border-radius: 0;
    margin: 0 4px;
    padding: 8px 14px;
    color: rgba(237, 230, 216, 0.75);
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.map-topbar__tab:hover {
    color: var(--bone);
}
.map-topbar__tab--active {
    color: var(--ember);
    border-bottom-color: var(--ember);
}
.map-topbar__tab--locked {
    opacity: 0.5;
}

.map-topbar__right {
    flex-direction: row;
    align-items: center;
}
.map-topbar__settings {
    background-color: transparent;
    border-width: 0;
    color: rgba(237, 230, 216, 0.75);
    font-size: 26px;
    margin-right: 20px;
    padding: 4px;
}
.map-topbar__settings:hover {
    color: var(--bone);
}
.map-topbar__progress {
    align-items: flex-end;
}
.map-topbar__level {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
}
.map-topbar__xp {
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 2px;
}

/* ---------- pan/zoom map stage ----------
   Always fills the remaining space below the top bar — the map is the main
   focus, full-screen/dominant, never squeezed by a permanently-reserved side
   column. overflow:hidden clips the pannable/zoomable canvas so it never
   paints outside the stage while panned/zoomed. */
.map-stage {
    position: relative;
    flex-grow: 1;
    width: 100%;
    overflow: hidden;
}

/* The pannable/zoomable content layer: MapPanZoomController applies
   transform.position (pan) and transform.scale (zoom) to this element as a
   whole, so the artwork and the hotspot markers inside it — both its children
   — always move and scale together. Fills the stage exactly at the default
   (identity) transform; USS's default transform-origin (center) means zoom
   pivots around the stage's own center with no extra math. */
.map-canvas {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* The reused ink-wash Japan/Asia map artwork (no baked labels — checkpoint
   names are now real UI Toolkit elements). scale-and-crop fills the canvas
   without stretching, cropping to cover like any other full-bleed media. */
.map-canvas-art {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/UI/Media/Images/asia_map.jpeg");
    -unity-background-scale-mode: scale-and-crop;
}

/* Subtle legibility darkening over the whole map canvas so marker labels and
   the top bar stay readable. Sits above the canvas, ignores picking so it
   never blocks panning/zooming or hotspot taps underneath it. */
.map-stage__scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 12, 0.22);
}

/* ---------- checkpoint hotspot markers ----------
   Clean Japanese-style icon markers: a circular kanji badge + a real "LVL n"
   label, replacing the old flattened image's baked Okinawa/Tohokku text.
   Percentage-positioned within .map-canvas so markers move/scale with the
   map. Generous tap area (see .tap-target-lg) beyond the visible badge. */
.map-node {
    position: absolute;
    translate: -50% -50%;
    width: 96px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
}
/* Percentage position within .map-canvas, per checkpoint — evocative
   placement on the reused ink-wash artwork, not pixel-exact geography. */
.map-node--lvl0 {
    left: 24%;
    top: 82%;
}
.map-node--lvl1 {
    left: 40%;
    top: 62%;
}
.map-node__badge {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background-color: rgba(11, 14, 17, 0.75);
    border-width: 2px;
    border-color: var(--bone);
    align-items: center;
    justify-content: center;
}
.map-node__glyph {
    font-size: 26px;
    color: var(--bone);
    -unity-text-align: middle-center;
}
.map-node__label {
    margin-top: 8px;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
    background-color: rgba(11, 14, 17, 0.6);
    padding: 2px 10px;
    border-radius: 10px;
}

/* Selected: unmistakable ember highlight + a slight lift. */
.map-node--selected .map-node__badge {
    border-color: var(--ember);
    background-color: rgba(255, 90, 31, 0.22);
}
.map-node--selected .map-node__label {
    color: var(--ember);
}
.map-node:active {
    scale: 0.96 0.96;
}

/* Locked: visible but unmistakably not yet available — dimmed, still fully
   tappable (opening its panel with a locked CTA is the whole point). */
.map-node--locked {
    opacity: 0.55;
}

/* ---------- LVL0/LVL1 detail panel (overlay, hidden by default) ----------
   Docked right, floating OVER the map stage — never a layout-affecting
   sibling, so the map stays full-screen/dominant whether the panel is open
   or not. Hidden by default (display:none is the safe markup default);
   MapLevelPreviewController toggles ".map-detail--open" open/closed. */
.map-detail {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 42%;
    min-width: 360px;
    max-width: 520px;
    background-color: var(--base);
    border-left-width: 1px;
    border-left-color: var(--line);
    overflow: hidden;
}
.map-detail--open {
    display: flex;
}

/* full-height, full-width preview video (never a banner) */
.map-detail__video {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base-2);
    -unity-background-scale-mode: scale-and-crop;
}

.map-detail__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
}
.map-detail__overlay--1 {
    top: 0;
    background-color: rgba(11, 14, 17, 0.25);
}
.map-detail__overlay--2 {
    height: 65%;
    background-color: rgba(11, 14, 17, 0.48);
}
.map-detail__overlay--3 {
    height: 42%;
    background-color: rgba(11, 14, 17, 0.78);
}

/* safe static fallback: shown instead of the video if it cannot load, or if
   no preview clip is bound for the selected checkpoint (e.g. LVL0). */
.map-detail__video-fallback {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--muted);
    background-color: var(--base-2);
}
.map-detail__video-fallback--visible {
    display: flex;
}

/* One content block per checkpoint (mirrors Combine's loading/empty/ready/
   error state-switching): MapLevelPreviewController toggles which is
   visible; only the selected one is ever display:flex. */
.map-detail__content {
    position: relative;
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 32px 44px 32px;
}
.map-detail__title {
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--seal);
}
.map-detail__subtitle {
    font-size: 17px;
    color: var(--bone);
    letter-spacing: 1px;
    margin-top: 6px;
}
.map-detail__desc {
    font-size: 16px;
    color: rgba(237, 230, 216, 0.85);
    white-space: normal;
    margin-top: 14px;
}
.map-detail__stats {
    flex-direction: column;
    margin-top: 18px;
}
.map-detail__stat {
    flex-direction: row;
    align-items: baseline;
    margin-bottom: 6px;
}
.map-detail__stat-label {
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(237, 230, 216, 0.7);
}
.map-detail__stat-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--bone);
    margin-left: 14px;
}

/* Start CTA: fixed, content-appropriate size, never full-width. */
.map-detail__cta {
    align-self: flex-start;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 220px;
    height: 60px;
    margin-top: 22px;
    padding: 0 18px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--seal);
    background-color: var(--seal);
}
.map-detail__cta:hover {
    background-color: #D95A3C;
}
.map-detail__cta-text {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
}

/* Locked state (required progression state not yet reached): dims the CTA
   in place, no layout/composition change — same idiom as .tq-lesson--locked. */
.map-detail__cta--locked {
    opacity: 0.5;
}

/* ---------- Map Settings overlay ----------
   Mirrors the Main Menu's Settings overlay (Home.uss ".menu-modal"), scoped
   to Map so this screen's stylesheet stays self-contained. Hidden by default. */
.map-modal {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 8, 10, 0.72);
}
.map-modal__card {
    width: 420px;
    max-width: 86%;
    background-color: var(--base-3);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 20px;
    padding: 34px;
    align-items: center;
}
.map-modal__title {
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--ember);
}
.map-modal__close {
    margin-top: 26px;
    min-width: 160px;
}
.map-setting {
    width: 100%;
    align-items: flex-start;
    margin-top: 20px;
}
.map-setting__label {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--muted);
    margin-bottom: 8px;
}
.map-setting__slider {
    width: 100%;
}
