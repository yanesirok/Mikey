/* ============================================================
   Map / Progression — landscape "map" screen styles.
   Palette custom properties (--ember, --jade, --bone, --base, …) cascade
   in from .mikey-app in theme.uss; this file only adds Map-specific
   structure so the screen stays modular (same pattern as Home/Home.uss,
   Techniques/Techniques.uss, CombineIntro/CombineIntro.uss).

   Landscape-first: a width-capped two-band composition (campaign hub +
   progression route) that fills 16:9 and wider phone-landscape ratios.
   Translated from design-pull/assets/screens-world.jsx (WorldMap COUNTRIES
   + JapanMap CITIES roadmap) + theme.css. The reference's fullscreen
   drag-to-pan ink map is adapted into an honest, overflow-free node path:
   Okinawa (Level 1 · Karate, the "current" city) is the first available
   node and its Train action opens the Lessons/Techniques hub, exactly as
   the reference's current-city "Train" button calls nav("lessons").
   ============================================================ */

/* ---------- full-bleed background ----------
   Lives OUTSIDE .safe-area-content so it bleeds under device insets, like
   .home-bg / .tq-bg / .cam-feed on the other screens. Solid base + a soft
   ink wash stands in for the painted Asia/Japan map art (which lands later),
   mirroring the reference's radial-gradient ink map. */
.map-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    align-items: center;
}
.map-glow {
    position: absolute;
    top: -160px;
    width: 760px;
    height: 760px;
    border-radius: 380px;
    background-color: rgba(255, 90, 31, 0.06);
}
.map-ink-wash {
    position: absolute;
    bottom: -140px;
    left: -80px;
    width: 560px;
    height: 560px;
    border-radius: 280px;
    background-color: rgba(43, 217, 168, 0.04);
}

/* Legibility scrim over the static map image so the hub headline/lead text
   keep contrast; the node chips already carry their own backing. */
.map-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 17, 0.3);
}

/* ---------- reusable visible-icon kit (Map-scoped) ----------
   Sizes the rendered glyph itself, independently of the button hit area.
   Every icon is non-shrinking and centered so flex never collapses the
   artwork, even at phone-landscape sizes. Mirrors Home's .home-icon and
   Techniques' .tq-icon kits. */
.map-icon {
    flex-shrink: 0;
    align-self: center;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}
.map-icon--hub {
    /* hub header mark: large */
    font-size: 52px;
    color: var(--ember);
}
.map-icon--node {
    /* major available map-node glyph: 48–64px target */
    font-size: 56px;
}
.map-icon--node-locked {
    /* locked-node glyph: 36–48px target */
    font-size: 40px;
}
.map-icon--status {
    /* status / rank icons: 30–40px target */
    font-size: 34px;
}
.map-icon--action {
    /* action arrows / icons: 32–40px target */
    font-size: 34px;
}
.map-icon--nav {
    /* bottom-nav visible icons: 40–44px target */
    font-size: 42px;
}

/* ---------- touch-target kit (Map-scoped) ----------
   >= 48x48 generic / >= 56x56 large; flex-shrink:0 so flex never collapses a
   control below a tappable size; real pressed-state scale so nothing reads dead. */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target:active {
    scale: 0.97;
}
.tap-target-lg {
    min-width: 56px;
    min-height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target-lg:active {
    scale: 0.97;
}

/* ---------- foreground two-band layout ----------
   Row on wide displays, wraps to a stacked column on narrow landscape.
   min-width:0 + flex shrinking keep both bands readable without overflow. */
.map-layout {
    flex-grow: 1;
    width: 100%;
    max-width: 1500px;
    align-self: center;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
}

/* LEFT BAND — campaign hub: world/Japan hierarchy, mock rank/progress,
   locked future chapters, Home action. */
.map-hub {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 420px;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 16px 28px 16px 8px;
}
.map-headline {
    flex-direction: row;
    align-items: center;
}
.map-headline__mark {
    margin-right: 16px;
}
.map-headline__text {
    flex-direction: column;
    flex-shrink: 1;
    min-width: 0;
}
.map-kicker {
    letter-spacing: 3px;
}
.map-title {
    font-size: 40px;
}
/* location hierarchy: World (Asia) › Japan › current chapter */
.map-breadcrumb {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 8px;
}
.map-breadcrumb__crumb {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--bone);
}
.map-breadcrumb__sep {
    font-size: 13px;
    color: var(--muted);
    margin: 0 8px;
    flex-shrink: 0;
}
.map-breadcrumb__crumb--muted {
    color: var(--muted);
}
.map-lead {
    margin-top: 12px;
    max-width: 520px;
}

/* mock rank / progress summary (local frontend data only) */
.map-progress {
    margin-top: 22px;
    max-width: 520px;
    flex-direction: column;
}
.map-belt {
    flex-direction: row;
    align-items: center;
}
.map-belt__swatch {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 9px;
    background-color: var(--bone);
    border-width: 1px;
    border-color: var(--line);
    margin-right: 12px;
}
.map-belt__text {
    flex-direction: column;
}
.map-belt__rank {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--bone);
}
.map-belt__sub {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--muted);
}
.map-progress__bar {
    height: 10px;
    border-radius: 5px;
    margin-top: 14px;
    background-color: rgba(255, 90, 31, 0.14);
    border-width: 1px;
    border-color: var(--line);
    overflow: hidden;
}
.map-progress__fill {
    height: 100%;
    width: 10%;
    border-radius: 5px;
    background-color: var(--ember);
}
.map-progress__count {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--muted);
    margin-top: 8px;
}

/* locked future chapters (World-map regions: China / Korea / Thailand) —
   honest "coming soon" chips, non-interactive, readable but dimmed. */
.map-chapters {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 20px;
    max-width: 520px;
}
.map-chapter {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 10px 10px 0;
    padding: 8px 14px;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(11, 14, 17, 0.4);
    opacity: 0.6;
}
.map-chapter__glyph {
    color: var(--muted);
    margin-right: 8px;
}
.map-chapter__text {
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--muted);
}

/* ---------- responsive action bar (wraps; no width:100% siblings) ---------- */
.map-actionbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 26px;
}
.map-actionbar--hub {
    justify-content: flex-start;
}

/* Action buttons size to content (NOT the width:100% global .btn), so two
   siblings never overflow a narrow landscape row. */
.map-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0 24px;
    margin: 6px 12px 6px 0;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--base-3);
}
.map-btn--ghost {
    background-color: rgba(11, 14, 17, 0.5);
}
.map-btn--ghost:hover {
    border-color: var(--bone);
}
.map-btn__text {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--bone);
}
.map-btn__icon {
    color: var(--bone);
    margin-left: 10px;
}
.map-btn__icon--lead {
    margin-left: 0;
    margin-right: 10px;
}

/* RIGHT BAND — responsive progression route / node path. Nodes wrap
   intentionally on narrow widths; min-width:0 keeps text from overflowing. */
.map-route {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 520px;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 16px 8px;
}
.map-route__label {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--muted);
    margin-bottom: 12px;
    margin-left: 4px;
}

/* one node on the route: row of glyph + body + trailing marker */
.map-node {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 14px;
    padding: 18px 22px;
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(18, 22, 27, 0.7);
}
.map-node__glyph {
    color: var(--bone);
    margin-right: 18px;
}
.map-node__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
}
.map-node__name {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--bone);
    white-space: normal;
}
.map-node__romaji {
    font-size: 14px;
    color: var(--muted);
    margin-top: 2px;
    white-space: normal;
}
.map-node__meta {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--ember);
    margin-top: 8px;
    white-space: normal;
}
.map-node__go {
    color: var(--ember);
    margin-left: 14px;
}

/* available (the first city, Okinawa) — visually distinct: ember accent,
   lifted; clearly the actionable node. Primary node >= 64x64. */
.map-node--available {
    border-color: var(--ember);
    background-color: rgba(255, 90, 31, 0.1);
    min-height: 96px;
}
.map-node--available:hover {
    border-color: var(--ember);
    background-color: rgba(255, 90, 31, 0.16);
}

/* locked — clearly disabled but readable; the glyph stays recognizable. */
.map-node--locked {
    opacity: 0.6;
    border-color: var(--line);
    background-color: rgba(11, 14, 17, 0.4);
}
.map-node__glyph--locked {
    color: var(--muted);
}
.map-node__meta--locked {
    color: var(--muted);
}
.map-node__badge {
    flex-shrink: 0;
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--base);
    background-color: var(--muted);
    border-radius: 6px;
    padding: 2px 8px;
    margin-left: 14px;
    -unity-text-align: middle-center;
}

/* selected / active checkpoint — the chosen city turns to the "active red
   checkpoint" per the approved design (layers on top of .map-node--available,
   so hover/available base styling still applies underneath). Driven by
   MapLevelPreviewController toggling this class, never baked into the map
   background image. */
.map-node--selected {
    border-color: var(--seal);
    background-color: rgba(200, 71, 46, 0.18);
}
.map-node--selected .map-node__glyph,
.map-node--selected .map-node__go {
    color: var(--seal);
}

/* ---------- Okinawa level-detail panel (right-side inline preview) ----------
   Opens when the Okinawa checkpoint node is selected (MapLevelPreviewController
   toggles ".map-detail--open"); hidden by default so the panel never reserves
   space until chosen. Sized so the existing hub + route content (left band)
   settles into ~60-65% of the capped .map-layout width and this panel takes
   ~35-40% — stable at both 1920x1080 and 2400x1080 because .map-layout is
   already width-capped at 1500px and centered (see above). Conceptually
   separate from the full-bleed .map-bg / BackgroundMediaController video
   system: this is an inline, in-panel preview, never a full-screen background. */
.map-detail {
    display: none;
    flex-direction: column;
    flex-shrink: 0;
    width: 36%;
    min-width: 340px;
    max-width: 560px;
    margin-left: 18px;
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(11, 14, 17, 0.86);
    overflow: hidden;
}
.map-detail--open {
    display: flex;
}

/* upper portion: inline looping preview video + legibility scrim + fallback */
.map-detail__preview {
    position: relative;
    width: 100%;
    height: 220px;
    flex-shrink: 0;
    background-color: var(--base-2);
    overflow: hidden;
}
.map-detail__video {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base-2);
    -unity-background-scale-mode: scale-and-crop;
}
/* Dark scrim over the preview so any future overlaid text stays readable;
   USS has no linear-gradient support here, so (mirroring .map-scrim /
   .title-scrim / .combine-scrim elsewhere) this is a flat semi-transparent
   layer rather than a true gradient. */
.map-detail__video-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 17, 0.22);
}
/* safe static fallback: shown instead of the video if it cannot load */
.map-detail__video-fallback {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--muted);
    background-color: var(--base-2);
}
.map-detail__video-fallback--visible {
    display: flex;
}
.map-detail__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 17px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(11, 14, 17, 0.55);
    align-items: center;
    justify-content: center;
}
.map-detail__close-icon {
    font-size: 15px;
    color: var(--bone);
}

/* lower portion: title / subtitle / description / stats / CTA — real UI
   Toolkit elements, never baked into the video. */
.map-detail__body {
    flex-direction: column;
    flex-grow: 1;
    padding: 18px 20px 20px;
}
.map-detail__title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--bone);
}
.map-detail__subtitle {
    font-size: 13px;
    color: var(--ember);
    letter-spacing: 1px;
    margin-top: 2px;
}
.map-detail__desc {
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
    margin-top: 12px;
}
.map-detail__stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 18px;
}
.map-detail__stat {
    flex-direction: column;
    align-items: flex-start;
    margin-right: 26px;
    margin-bottom: 8px;
}
.map-detail__stat-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--bone);
}
.map-detail__stat-label {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 2px;
}
.map-detail__cta {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    margin-top: 20px;
    padding: 0 22px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--ember);
    background-color: var(--ember);
}
.map-detail__cta:hover {
    background-color: #FF702E;
}
.map-detail__cta-text {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #1A0A03;
}
.map-detail__cta-icon {
    color: #1A0A03;
    margin-left: 10px;
}

/* ---------- persistent bottom navigation dock (canonical 4-tab model) ----------
   Same Home / Map / Techniques / Profile model as the Home dock, with the
   Map tab in its active state here. Map-scoped class names keep the styling
   self-contained (Home.uss is only linked on the menu screen). */
.map-dock {
    flex-direction: row;
    width: 100%;
    max-width: 1100px;
    align-self: center;
    justify-content: center;
    margin-top: 16px;
}
.map-tab {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 240px;
    align-items: center;
    justify-content: center;
    padding: 10px 8px;
    margin: 0 6px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(11, 14, 17, 0.5);
}
.map-tab__glyph {
    color: rgba(237, 230, 216, 0.6);
}
.map-tab__label {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgba(237, 230, 216, 0.6);
    margin-top: 4px;
}
.map-tab__badge {
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--base);
    background-color: var(--muted);
    border-radius: 6px;
    padding: 1px 6px;
    margin-top: 4px;
}

/* active tab — unmistakable current state (ember accent, top rule) */
.map-tab--active {
    border-color: var(--ember);
    background-color: rgba(255, 90, 31, 0.12);
    border-top-width: 3px;
    border-top-color: var(--ember);
}
.map-tab--active .map-tab__glyph {
    color: var(--ember);
}
.map-tab--active .map-tab__label {
    color: var(--bone);
}

/* locked / "coming soon" tabs — clearly disabled but the icon stays readable. */
.map-tab--locked {
    opacity: 0.6;
}
