/* ============================================================
   Map — full-viewport landscape "selected-level" screen styles.
   Palette custom properties (--ember, --seal, --bone, --base, …) cascade
   in from .mikey-app in theme.uss; this file only adds Map-specific
   structure so the screen stays modular (same pattern as Home/Home.uss,
   Techniques/Techniques.uss, CombineIntro/CombineIntro.uss).

   Approved design: the map itself fills the left ~62-64% of the full
   viewport (no centered/max-width container, no large outer margins);
   checkpoints and the route line sit directly over the map (never baked
   into the background image); a docked, flush right-side panel (~36-38%)
   shows the Okinawa level detail — hidden until a checkpoint is selected,
   at which point MapLevelPreviewController shows it and starts its inline
   preview. Replaces the earlier "roadmap dashboard" composition (left hub
   card + vertical city-card list + big 4-tab dock), which read as a
   generic desktop web layout rather than the approved full-bleed map.
   ============================================================ */

/* ---------- full-bleed background ----------
   Lives OUTSIDE .safe-area-content so it bleeds under device insets, like
   .home-bg / .tq-bg / .cam-feed on the other screens. Solid base + a soft
   ink wash stands in for the painted Asia/Japan map art (which lands later),
   mirroring the reference's radial-gradient ink map. Untouched by the
   layout correction — the Map background stays the same full-bleed static
   image driven by BackgroundMediaController. */
.map-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    align-items: center;
}
.map-glow {
    position: absolute;
    top: -160px;
    width: 760px;
    height: 760px;
    border-radius: 380px;
    background-color: rgba(255, 90, 31, 0.06);
}
.map-ink-wash {
    position: absolute;
    bottom: -140px;
    left: -80px;
    width: 560px;
    height: 560px;
    border-radius: 280px;
    background-color: rgba(43, 217, 168, 0.04);
}

/* Dark/fog legibility overlay over the map so checkpoint labels and the
   route line keep contrast against the painted art. */
.map-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 17, 0.3);
}

/* ---------- reusable visible-icon kit (Map-scoped) ----------
   Sizes the rendered glyph itself, independently of the button hit area.
   Every icon is non-shrinking and centered so flex never collapses the
   artwork, even at phone-landscape sizes. Mirrors Home's .home-icon and
   Techniques' .tq-icon kits. */
.map-icon {
    flex-shrink: 0;
    align-self: center;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}
.map-icon--action {
    /* action arrows / icons: 32-40px target */
    font-size: 28px;
}

/* ---------- touch-target kit (Map-scoped) ----------
   >= 48x48 generic / >= 56x56 large; flex-shrink:0 so flex never collapses a
   control below a tappable size; real pressed-state scale so nothing reads dead. */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target:active {
    scale: 0.97;
}
.tap-target-lg {
    min-width: 56px;
    min-height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target-lg:active {
    scale: 0.97;
}

/* ---------- full-viewport two-region layout ----------
   No centered/max-width container, no outer side margins: the map stage
   grows to fill whatever width the docked detail panel doesn't take, so
   the ~63/37 split holds at any viewport width (1920x1080, 2400x1080, …)
   instead of staying capped at a fixed desktop-webpage width. */
.map-layout {
    flex-grow: 1;
    width: 100%;
    flex-direction: row;
    align-items: stretch;
}

/* LEFT — the map stage: checkpoints and the route line are drawn directly
   over the full-bleed map background (never baked into the image), plus
   one small, unobtrusive way back to Home. Fills all remaining width once
   the docked panel (fixed %) takes its share. */
.map-stage {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

/* Small, unobtrusive Home affordance (replaces the old large 4-tab dock
   for this selected-level presentation). */
.map-home {
    position: absolute;
    top: 18px;
    left: 18px;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(11, 14, 17, 0.55);
}
.map-home:hover {
    border-color: var(--bone);
}
.map-home__icon {
    color: var(--bone);
    font-size: 20px;
}

/* ---------- route line ----------
   Simple straight segments connecting checkpoint centers, positioned as a
   percentage of the map stage (approximate at the 1920x1080 reference
   proportions — starting positions only, easy to retune alongside the
   .map-pin-- coordinates below). Never baked into the map background. */
.map-route-seg {
    position: absolute;
    height: 3px;
    background-color: rgba(237, 230, 216, 0.55);
    translate: -50% -50%;
}
/* Okinawa -> Tonokku */
.map-route-seg--1 {
    left: 37%;
    top: 58%;
    width: 30%;
    rotate: -48deg;
}
/* Tonokku -> Kanto */
.map-route-seg--2 {
    left: 59.5%;
    top: 42.5%;
    width: 27%;
    rotate: -20deg;
}
/* Kanto -> future checkpoint */
.map-route-seg--3 {
    left: 82%;
    top: 28%;
    width: 28%;
    rotate: -45deg;
}

/* ---------- checkpoints (pins) directly over the map ----------
   Coordinates are percentages of the map stage box, centered on the pin via
   translate(-50%,-50%) — starting positions only, kept in USS (not baked
   into the background image or hardcoded in C#) so they stay easy to
   retune. */
.map-pin {
    position: absolute;
    translate: -50% -50%;
    flex-direction: column;
    align-items: center;
}
.map-pin--okinawa {
    left: 27%;
    top: 69%;
}
.map-pin--tonokku {
    left: 47%;
    top: 47%;
}
.map-pin--kanto {
    left: 72%;
    top: 38%;
}
.map-pin--future {
    left: 92%;
    top: 18%;
}

.map-pin__glyph {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    border-width: 2px;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 22px;
}
.map-pin__label {
    margin-top: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
    -unity-text-align: upper-center;
}
.map-pin__badge {
    margin-top: 2px;
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--base);
    background-color: var(--muted);
    border-radius: 6px;
    padding: 1px 6px;
    -unity-text-align: middle-center;
}

/* current/available (Okinawa) — the red checkpoint; clickable. */
.map-pin--current .map-pin__glyph {
    background-color: var(--seal);
    border-color: var(--bone);
    color: var(--bone);
}
.map-pin--current:hover .map-pin__glyph {
    background-color: #D95A3C;
}
/* actively selected (panel open) — brighter ring so the active checkpoint
   reads as distinct from merely "available". Toggled at runtime by
   MapLevelPreviewController (SelectCheckpoint / ClosePanel). */
.map-pin--current.map-node--selected .map-pin__glyph {
    border-color: var(--ember);
    border-width: 3px;
}

/* locked (Tonokku / Kanto / future) — white/muted, non-interactive,
   honestly "coming soon"; never startable. */
.map-pin--locked .map-pin__glyph {
    background-color: rgba(237, 230, 216, 0.14);
    border-color: rgba(237, 230, 216, 0.4);
    color: var(--muted);
}
.map-pin__label--locked {
    color: var(--muted);
}

/* ---------- Okinawa level-detail panel (docked right side) ----------
   Opens when the Okinawa checkpoint pin is selected (MapLevelPreviewController
   toggles ".map-detail--open"); hidden by default so the stage fills the
   full viewport until a checkpoint is chosen. Docked flush against the top,
   right and bottom edges (no outer margin, square edges, dark charcoal
   background) rather than a floating rounded card. Conceptually separate
   from the full-bleed .map-bg / BackgroundMediaController video system:
   this is an inline, in-panel preview, never a full-screen background. */
.map-detail {
    display: none;
    flex-direction: column;
    flex-shrink: 0;
    width: 37%;
    min-width: 460px;
    background-color: var(--base);
    border-left-width: 1px;
    border-left-color: var(--line);
    overflow: hidden;
}
.map-detail--open {
    display: flex;
}

/* upper portion: inline looping preview video + legibility scrim + fallback.
   Percentage height (not a fixed px) so it stays ~42-48% of the panel at
   any viewport height; full panel width, centered scale-and-crop so the
   portrait (1080x1920) source crops top/bottom rather than left/right,
   keeping the subject visible instead of a narrow banner. */
.map-detail__preview {
    position: relative;
    width: 100%;
    height: 46%;
    flex-shrink: 0;
    background-color: var(--base-2);
    overflow: hidden;
}
.map-detail__video {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base-2);
    -unity-background-scale-mode: scale-and-crop;
}
/* Dark scrim over the preview so any future overlaid text stays readable;
   USS has no linear-gradient support here, so (mirroring .map-scrim
   elsewhere) this is a flat semi-transparent layer rather than a true
   gradient. */
.map-detail__video-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 17, 0.18);
}
/* safe static fallback: shown instead of the video if it cannot load */
.map-detail__video-fallback {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--muted);
    background-color: var(--base-2);
}
.map-detail__video-fallback--visible {
    display: flex;
}
/* small, visually unobtrusive close control */
.map-detail__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 15px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(11, 14, 17, 0.55);
    align-items: center;
    justify-content: center;
}
.map-detail__close-icon {
    font-size: 13px;
    color: var(--bone);
}

/* lower portion: title / subtitle / description / stats / CTA — real UI
   Toolkit elements, never baked into the video. */
.map-detail__body {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px 22px 22px;
}
.map-detail__title {
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--seal);
}
.map-detail__subtitle {
    font-size: 13px;
    color: var(--bone);
    letter-spacing: 1px;
    margin-top: 2px;
}
.map-detail__desc {
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
    margin-top: 12px;
}
.map-detail__stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 18px;
}
.map-detail__stat {
    flex-direction: column;
    align-items: flex-start;
    margin-right: 26px;
    margin-bottom: 8px;
}
.map-detail__stat-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--bone);
}
.map-detail__stat-label {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 2px;
}

/* Start Lesson: left-aligned, content-width (not a full-width stretched
   bar), dark-red/red treatment. */
.map-detail__cta {
    align-self: flex-start;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 52%;
    min-width: 200px;
    min-height: 56px;
    margin-top: 22px;
    padding: 0 22px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--seal);
    background-color: var(--seal);
}
.map-detail__cta:hover {
    background-color: #D95A3C;
}
.map-detail__cta-text {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
}
.map-detail__cta-icon {
    color: var(--bone);
    margin-left: 10px;
}
