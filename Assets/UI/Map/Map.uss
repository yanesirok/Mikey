/* ============================================================
   Map — full-viewport cinematic Map presentation, rebuilt from the
   approved reference (map_okinawa_approved_reference.jpg). Palette custom
   properties (--ember, --seal, --bone, --base, …) cascade in from
   .mikey-app in theme.uss; this file only adds Map-specific structure so
   the screen stays modular (same pattern as Home/Home.uss,
   Techniques/Techniques.uss, CombineIntro/CombineIntro.uss).

   Baseline composition is 1280x720: the map fills the left ~61.7% (x
   0-790) and the Okinawa cinematic panel is docked flush against the
   right ~38.3% (x 790-1280), both full height. MVP: the left map's whole
   route/checkpoint composition is one flattened static image
   (japan_route_map_mvp@2x.png) rather than separately-rendered dots/
   labels/route segments, held inside an aspect-ratio-locked ".map-artboard"
   (790:720) so it's never stretched or re-cropped; a single transparent
   Button hotspot sits over Okinawa's position INSIDE that same artboard,
   so it stays aligned with the visible artwork even when the artboard
   pillarboxes within a wider stage (e.g. ultrawide 2400x1080). The right
   panel is ONE full-height preview video with layered dark overlays over
   its lower portion; title/description/stats/CTA sit directly on top of
   the video, not in a separate solid content panel below it.
   Percentage-based layout scales the composition at 1920x1080 /
   2400x1080; font sizes stay fixed px (UI Toolkit has no fluid/
   viewport-relative typography), sized to the 1280x720 baseline.
   ============================================================ */

/* ---------- full-bleed background ----------
   Lives OUTSIDE .safe-area-content so it bleeds under device insets, like
   .home-bg / .tq-bg / .cam-feed on the other screens. Untouched asset,
   driven by BackgroundMediaController; only a dark/fog legibility scrim
   sits over it now — the old translucent red/green "territory shape"
   glows were removed (they never matched the approved reference's dark
   monochrome ink-map treatment). */
.map-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    align-items: center;
}

/* Dark/fog legibility overlay behind the map artboard, matching the
   approved reference's dark, moody tone. */
.map-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 17, 0.32);
}

/* ---------- touch-target kit (Map-scoped) ----------
   >= 48x48 generic / >= 56x56 large; flex-shrink:0 so flex never collapses a
   control below a tappable size; real pressed-state scale so nothing reads dead. */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target:active {
    scale: 0.97;
}
.tap-target-lg {
    min-width: 56px;
    min-height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target-lg:active {
    scale: 0.97;
}

/* ---------- full-viewport two-region layout ----------
   No centered/max-width container, no outer side margins: the map stage
   grows to fill whatever width the docked detail panel doesn't take, so
   the ~61.7/38.3 split (per the approved reference) holds at any
   viewport width (1280x720, 1920x1080, 2400x1080, …). */
.map-layout {
    flex-grow: 1;
    width: 100%;
    flex-direction: row;
    align-items: stretch;
}

/* LEFT (~61.7%) — the map stage: hosts the aspect-locked .map-artboard
   (map art + Okinawa hotspot), centered, plus one small, unobtrusive way
   back to Home. Fills all remaining width once the docked panel (fixed %)
   takes its share. */
.map-stage {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Small, unobtrusive Home affordance: plain text, no pill/box background,
   so it never competes with the cinematic map. */
.map-home {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 4px 6px;
}
.map-home__icon {
    color: rgba(237, 230, 216, 0.7);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.map-home:hover .map-home__icon {
    color: var(--bone);
}

/* ---------- MVP flattened map artboard ----------
   .map-artboard is the maximum box that fits inside .map-stage while
   preserving the approved reference's exact 790:720 aspect ratio (never
   stretched, never cropped differently at different sizes). At every
   validated resolution (1280x720, 1920x1080, 2400x1080) the stage is
   proportionally wider than 790:720 (the docked side panel eats
   relatively more width as the viewport widens), so a definite
   height:100% + aspect-ratio computes the correct, narrower width, and
   .map-stage's justify-content:center centers the result horizontally —
   this is the fix for the hotspot misalignment bug: both the map artwork
   (.map-art) AND the Okinawa hotspot are children of THIS box, so
   percentage positions inside it always match the actual displayed
   artwork, even while it pillarboxes at wider aspect ratios. */
.map-artboard {
    position: relative;
    height: 100%;
    aspect-ratio: 1.0972;
}

/* The flattened route/checkpoint composition (map art, route line,
   Tonokku/Kanto/future points + labels, Okinawa point + label) is ONE
   static image, losslessly cropped from the approved 1280x720 reference
   at x:0-790, y:0-720 (a 790x720 source, same aspect ratio as
   .map-artboard above). Uses the high-resolution 2x export
   (japan_route_map_mvp@2x.png, 1580x1440 — same composition and aspect
   ratio, just higher pixel density) for on-screen quality. Fills the
   artboard exactly (their aspect ratios already match); scale-to-fit is
   kept as a safety margin against any sub-pixel rounding, never
   stretching or re-cropping. */
.map-art {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/UI/Media/Images/japan_route_map_mvp@2x.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- Okinawa interaction hotspot ----------
   Transparent — no visible background, border or label; the visible red
   Okinawa marker is baked into the map artwork above. Positioned at the
   marker's normalized coordinate RELATIVE TO THE ARTBOARD (measured
   centre in the 790x720 source: x=222, y=489 -> 222/790=28.1%,
   489/720=67.9%), NOT the wider .map-stage — this is what keeps the
   hotspot aligned with the visible dot at every validated resolution,
   including ultrawide 2400x1080 where the artboard pillarboxes within
   the stage. Centered via translate(-50%,-50%), with a generous
   invisible tap area (see .tap-target) larger than the visible dot for
   usability. Locked points (Tonokku / Kanto / future) have no separate
   interactive element for this MVP — they are part of the flattened
   artwork and simply cannot be clicked. */
.map-node-okinawa {
    position: absolute;
    left: 28.1%;
    top: 67.9%;
    translate: -50% -50%;
    width: 72px;
    height: 72px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* ---------- Okinawa cinematic preview panel (docked right side) ----------
   Opens when the Okinawa hotspot is selected (MapLevelPreviewController
   toggles ".map-detail--open"); hidden by default so the stage fills the
   full viewport until a checkpoint is chosen. Docked flush against the
   top, right and bottom edges (no outer margin, square edges). ONE
   full-height video with layered dark overlays over its lower portion —
   there is no separate solid-black content container below it; the
   title/description/stats/CTA sit directly on top of the video. */
.map-detail {
    display: none;
    position: relative;
    flex-shrink: 0;
    width: 38.3%;
    min-width: 440px;
    background-color: var(--base);
    overflow: hidden;
}
.map-detail--open {
    display: flex;
}

/* full-height, full-width preview video (never a banner) */
.map-detail__video {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base-2);
    -unity-background-scale-mode: scale-and-crop;
}

/* Layered dark overlays approximating the reference's gradient (USS has
   no linear-gradient support): a subtle overall tint so the whole frame
   reads a little darker/moodier, plus two stronger bands anchored to the
   bottom covering roughly the lower 55-65% of the panel, so scenery stays
   visible behind the upper portion of the video while the information
   area at the bottom stays readable. */
.map-detail__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
}
.map-detail__overlay--1 {
    top: 0;
    background-color: rgba(11, 14, 17, 0.18);
}
.map-detail__overlay--2 {
    height: 65%;
    background-color: rgba(11, 14, 17, 0.4);
}
.map-detail__overlay--3 {
    height: 38%;
    background-color: rgba(11, 14, 17, 0.72);
}

/* safe static fallback: shown instead of the video if it cannot load */
.map-detail__video-fallback {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--muted);
    background-color: var(--base-2);
}
.map-detail__video-fallback--visible {
    display: flex;
}

/* minimal, unobtrusive close action: plain text, no button pill/circle
   behind it, so it never reads as a large control over the video. */
.map-detail__close {
    position: absolute;
    top: 14px;
    right: 16px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 2px 6px;
}
.map-detail__close-icon {
    font-size: 16px;
    color: rgba(237, 230, 216, 0.6);
}
.map-detail__close:hover .map-detail__close-icon {
    color: var(--bone);
}

/* title / subtitle / description / stats / CTA — real UI Toolkit elements
   laid directly over the video + overlays (no background of its own),
   anchored to the lower portion of the panel via flex + padding rather
   than absolute pixel coordinates, so it stays in the "middle/lower
   section" at both the 720 and 1080 baseline heights. */
.map-detail__content {
    position: relative;
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 40px 60px 58px;
}
.map-detail__title {
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--seal);
}
.map-detail__subtitle {
    font-size: 15px;
    color: var(--bone);
    letter-spacing: 1px;
    margin-top: 4px;
}
.map-detail__desc {
    font-size: 14px;
    color: rgba(237, 230, 216, 0.8);
    white-space: normal;
    max-width: 380px;
    margin-top: 14px;
}
.map-detail__stats {
    flex-direction: column;
    margin-top: 20px;
}
.map-detail__stat {
    flex-direction: row;
    align-items: baseline;
    margin-bottom: 6px;
}
.map-detail__stat-label {
    font-size: 13px;
    letter-spacing: 1px;
    color: rgba(237, 230, 216, 0.65);
}
.map-detail__stat-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--bone);
    margin-left: 16px;
}

/* Start Lesson: fixed baseline size (~200x60 at 1280x720), left-aligned,
   dark-red/vermilion treatment, never full-width. */
.map-detail__cta {
    align-self: flex-start;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 200px;
    height: 60px;
    margin-top: 24px;
    padding: 0 18px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--seal);
    background-color: var(--seal);
}
.map-detail__cta:hover {
    background-color: #D95A3C;
}
.map-detail__cta-text {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
}
