/* ============================================================
   Map — mobile rebuild. The Map is now the primary in-game hub, with a
   two-tier hierarchy: the Japan world map ("map" screen) shows CHAPTER/CITY
   nodes (Okinawa unlocked, Tohoku locked); tapping "ENTER CHAPTER" on Okinawa
   transitions into the Okinawa chapter map ("mapOkinawa" screen), which shows
   LEVEL nodes (LVL 0-5). Both screens share this one stylesheet and the same
   structural pattern:
     .*-topbar   -- Settings / Map / Techniques / Stats + Level/XP, always visible
     .pan-stage  -- full-viewport, overflow:hidden pan/zoom viewport
     .pan-canvas -- the pannable/zoomable layer MapPanZoomController transforms
     .detail-panel -- a right-side OVERLAY panel (never a permanently reserved
                      column) shown on marker selection, closed by tapping the
                      same marker again, another marker, or elsewhere on the stage
     .map-transition-overlay -- brief ink-fade used only for the Japan -> Okinawa
                                 chapter transition
   Palette custom properties (--ember, --seal, --bone, --base, …) cascade in
   from .mikey-app in theme.uss. Markers are real UI Toolkit elements (never
   baked into the map art), sized well above the ~44-48px minimum touch target
   for landscape Android. The old flattened single-image MVP composition (a
   single cropped route image, the permanent 61.7/38.3 split, the always-open
   Okinawa panel) is fully retired by this file — see JapanMapController /
   OkinawaMapController for the behavior that used to live in
   MapLevelPreviewController.
   ============================================================ */

/* ---------- kept background-media plumbing (untouched wiring) ----------
   BackgroundMediaController's "map" -> asia_map.jpeg binding stays in the
   scene so Title/Home/Combine's shared full-bleed background system is
   never touched; this screen simply never shows it — the pan/zoom canvas
   art below is the only visible map image. Same shared shape as every other
   screen with bound media (full-bleed layer + legibility scrim, outside
   .safe-area-content — see BackgroundMediaUxmlTests). */
.map-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
}
#map-bg-media {
    display: none;
}
.map-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 17, 0.32);
}

/* ---------- touch-target kit (Map-scoped) ----------
   >= 48x48 generic / >= 56x56 large; flex-shrink:0 so flex never collapses a
   control below a tappable size; real pressed-state scale so nothing reads dead. */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target:active {
    scale: 0.97;
}
.tap-target-lg {
    min-width: 56px;
    min-height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target-lg:active {
    scale: 0.97;
}

/* ---------- screen root ----------
   Fills the safe area below the device notch/bars; top bar + stage stack in
   a column so the stage always gets "the rest" of the height, full width. */
.map-root {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
}

/* ---------- top quick-access bar ----------
   Visible on both the Japan and Okinawa map screens. Left: Settings icon +
   Map/Techniques/Stats. Right: current Level/XP. Sized generously for
   landscape Android (>= 48px targets, >= 15px text) — the previous Map's
   text was reported unreadable on device. */
.map-topbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 4px;
}
.map-topbar__left {
    flex-direction: row;
    align-items: center;
}
.map-topbar__right {
    flex-direction: row;
    align-items: center;
}
.map-topbar__icon-btn {
    width: 48px;
    height: 48px;
    margin-right: 6px;
    border-radius: 24px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(18, 22, 27, 0.82);
}
.map-topbar__icon-glyph {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
}
.map-topbar__nav-btn {
    height: 48px;
    margin-right: 8px;
    padding: 0 16px;
    border-radius: 24px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(18, 22, 27, 0.82);
}
.map-topbar__nav-btn-text {
    font-size: 15px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--bone);
}
.map-topbar__nav-btn:hover {
    border-color: var(--bone);
}
.map-topbar__nav-btn--locked {
    opacity: 0.5;
}
.map-topbar__status {
    flex-direction: column;
    align-items: flex-end;
    padding: 0 6px 0 16px;
}
.map-topbar__level {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--seal);
}
.map-topbar__xp {
    font-size: 13px;
    color: var(--muted);
    margin-top: 2px;
}

/* ---------- pan/zoom stage (shared by Japan + Okinawa) ----------
   Always fills the remaining space below the top bar — the map is the main
   focus, full-bleed/dominant, never squeezed by a permanently-reserved side
   column, never a floating centered rectangle. overflow:hidden clips the
   pannable/zoomable canvas so it never paints outside the stage while
   panned/zoomed. */
.pan-stage {
    position: relative;
    flex-grow: 1;
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
}

/* The pannable/zoomable content layer: MapPanZoomController applies
   transform.position (pan) and transform.scale (zoom) to this element as a
   whole, so the artwork and its marker buttons — both its children — always
   move and scale together. Fills the stage exactly at the default (identity)
   transform; USS's default transform-origin (center) means zoom pivots
   around the stage's own center with no extra math. */
.pan-canvas {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Full-bleed cover-fit map art — never stretched, source bytes untouched;
   only the runtime display fit is cover, matching every other full-bleed
   media surface in this app (see theme.uss ".bg-media"). */
.map-canvas-art {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/UI/Media/Images/japan_map_final.jpg");
    -unity-background-scale-mode: scale-and-crop;
}
.okinawa-canvas-art {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/UI/Media/Images/okinawa_map_final.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

/* Subtle legibility darkening so marker labels and the top bar stay
   readable over bright regions of the map art. Ignores picking so it never
   blocks panning/zooming or marker taps underneath it. */
.pan-canvas-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 12, 0.16);
}

/* Invisible full-stage catcher, toggled to picking-mode:Position only while
   a detail panel/popup is open, so a tap "elsewhere" on the map closes it.
   Ignored (pass-through to markers/pan) whenever nothing is open. */
.map-outside-catcher {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ---------- Japan chapter markers ----------
   Compact, elegant, brush/seal-inspired badges — never giant text painted
   across the map. Percentage-positioned within .pan-canvas so markers move
   and scale together with the map. The button's own box is generously
   larger than the visible badge for a comfortable touch target. */
.chapter-node {
    position: absolute;
    translate: -50% -50%;
    width: 120px;
    padding: 10px 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: column;
    align-items: center;
}
.chapter-node--okinawa {
    left: 30%;
    top: 62%;
}
.chapter-node--tohoku {
    left: 47%;
    top: 30%;
}
.chapter-node__badge {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background-color: rgba(11, 14, 17, 0.82);
    border-width: 2px;
    border-color: var(--seal);
    align-items: center;
    justify-content: center;
}
.chapter-node__badge-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--seal);
}
.chapter-node__label {
    margin-top: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--bone);
    -unity-text-align: middle-center;
}
.chapter-node--locked .chapter-node__badge {
    border-color: var(--line);
    background-color: rgba(11, 14, 17, 0.6);
}
.chapter-node--locked .chapter-node__badge-dot {
    background-color: var(--muted);
}
.chapter-node--locked .chapter-node__label {
    color: var(--muted);
}
.chapter-node--selected .chapter-node__badge {
    border-color: var(--ember);
    border-width: 3px;
    scale: 1.08;
}

/* ---------- Okinawa level markers ----------
   Same visual language as the chapter markers, smaller/denser since there
   are six of them. LVL n index shown directly in the badge. */
.level-node {
    position: absolute;
    translate: -50% -50%;
    width: 92px;
    padding: 8px 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: column;
    align-items: center;
}
.level-node--0 { left: 22%; top: 78%; }
.level-node--1 { left: 34%; top: 60%; }
.level-node--2 { left: 48%; top: 68%; }
.level-node--3 { left: 60%; top: 48%; }
.level-node--4 { left: 72%; top: 58%; }
.level-node--5 { left: 82%; top: 36%; }

.level-node__badge {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgba(11, 14, 17, 0.82);
    border-width: 2px;
    border-color: var(--seal);
    align-items: center;
    justify-content: center;
}
.level-node__badge-index {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--bone);
}
.level-node__label {
    margin-top: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
    -unity-text-align: middle-center;
}
.level-node--locked .level-node__badge {
    border-color: var(--line);
    background-color: rgba(11, 14, 17, 0.6);
}
.level-node--locked .level-node__badge-index {
    color: var(--muted);
}
.level-node--locked .level-node__label {
    color: var(--muted);
}
.level-node--selected .level-node__badge {
    border-color: var(--ember);
    border-width: 3px;
    scale: 1.1;
}
.level-node--completed .level-node__badge {
    border-color: var(--jade);
}

/* ---------- shared detail panel (chapter panel + level popup) ----------
   ONE overlay panel style used by both the Japan chapter panel and the
   Okinawa level popup. Slides in from the right OVER the map — the stage
   never shrinks/reflows to make room for it, and it never becomes a
   permanently-reserved column. Closed state is also picking-mode:Ignore
   (set by the owning controller) so it never intercepts stage taps while
   off-screen. */
.detail-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 46%;
    min-width: 360px;
    max-width: 500px;
    background-color: var(--base-2);
    border-left-width: 1px;
    border-left-color: var(--line);
    overflow: hidden;
    translate: 100% 0;
    transition-property: translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}
.detail-panel--open {
    translate: 0 0;
}

/* full-bleed preview video (chapter panel only) */
.detail-panel__video {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base-2);
    -unity-background-scale-mode: scale-and-crop;
}
.detail-panel__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
}
.detail-panel__overlay--1 {
    top: 0;
    background-color: rgba(11, 14, 17, 0.2);
}
.detail-panel__overlay--2 {
    height: 60%;
    background-color: rgba(11, 14, 17, 0.78);
}
.detail-panel__video-fallback {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--muted);
    background-color: var(--base-2);
}
.detail-panel__video-fallback--visible {
    display: flex;
}

.detail-panel__content {
    position: relative;
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 34px 44px 34px;
}
.detail-panel__eyebrow {
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--seal);
}
.detail-panel__title {
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--bone);
    margin-top: 4px;
}
.detail-panel__subtitle {
    font-size: 17px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 4px;
}
.detail-panel__desc {
    font-size: 18px;
    color: rgba(237, 230, 216, 0.85);
    white-space: normal;
    margin-top: 16px;
}
.detail-panel__meta {
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 14px;
}
.detail-panel__cta {
    align-self: flex-start;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 220px;
    height: 64px;
    margin-top: 26px;
    padding: 0 22px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--seal);
    background-color: var(--seal);
}
.detail-panel__cta:hover {
    background-color: #D95A3C;
}
.detail-panel__cta-text {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
}
.detail-panel__cta--locked {
    opacity: 0.5;
    border-color: var(--line);
    background-color: var(--base-3);
}

/* ---------- Japan -> Okinawa ink-fade transition ----------
   A short, simple full-stage fade (never an elaborate cinematic system).
   Ignores picking; the controller guards re-entrancy in code rather than
   relying on this overlay to block input. */
.map-transition-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-in-out;
}
.map-transition-overlay--visible {
    opacity: 1;
}

/* ---------- minimal map-local settings modal ----------
   Deliberately small: reuses IAudioSettings (Mikey.UI.Audio) directly rather
   than duplicating Home's whole settings system. Same three sliders as
   Home's Settings overlay, Map-scoped markup/classes so this stays
   decoupled from HomeController. Hidden by default. */
.map-settings-modal {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 7, 9, 0.72);
}
.map-settings-modal--open {
    display: flex;
}
.map-settings-modal__card {
    width: 420px;
    max-width: 86%;
    padding: 28px;
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--base-3);
}
.map-settings-modal__title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--bone);
    margin-bottom: 16px;
}
.map-setting {
    margin-bottom: 14px;
}
.map-setting__label {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-bottom: 4px;
}
.map-settings-modal__close {
    margin-top: 10px;
}
