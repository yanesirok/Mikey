/* ============================================================
   Map — mobile rebuild. The Map is now the primary in-game hub, with a
   two-tier hierarchy: the Japan world map ("map" screen) shows CHAPTER/CITY
   nodes (Okinawa unlocked, Fukuoka and Hiroshima locked — see
   MapMarkerLayout); tapping "ENTER CHAPTER" on Okinawa
   transitions into the Okinawa chapter map ("mapOkinawa" screen), which shows
   LEVEL nodes (LVL 0-5). Both screens share this one stylesheet and the same
   structural pattern:
     .*-topbar   -- Settings / Map / Techniques / Stats + Level/XP, always visible
     .pan-stage  -- full-viewport, overflow:hidden pan/zoom viewport
     .pan-canvas -- the pannable/zoomable layer MapPanZoomController transforms
     .detail-panel -- a right-side OVERLAY panel (never a permanently reserved
                      column) shown on marker selection, closed by tapping the
                      same marker again, another marker, or elsewhere on the stage
     .map-transition-overlay -- brief ink-fade used only for the Japan -> Okinawa
                                 chapter transition
   Palette custom properties (--ember, --seal, --bone, --base, …) cascade in
   from .mikey-app in theme.uss. Markers are real UI Toolkit elements (never
   baked into the map art), sized well above the ~44-48px minimum touch target
   for landscape Android. The old flattened single-image MVP composition (a
   single cropped route image, the permanent 61.7/38.3 split, the always-open
   Okinawa panel) is fully retired by this file — see JapanMapController /
   OkinawaMapController for the behavior that used to live in
   MapLevelPreviewController.
   ============================================================ */

/* ---------- kept background-media plumbing (untouched wiring) ----------
   BackgroundMediaController's "map" -> asia_map.jpeg binding stays in the
   scene so Title/Home/Combine's shared full-bleed background system is
   never touched; this screen simply never shows it — the pan/zoom canvas
   art below is the only visible map image. Same shared shape as every other
   screen with bound media (full-bleed layer + legibility scrim, outside
   .safe-area-content — see BackgroundMediaUxmlTests). */
.map-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
}
#map-bg-media {
    display: none;
}
.map-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 17, 0.32);
}

/* ---------- touch-target kit (Map-scoped) ----------
   >= 48x48 generic / >= 56x56 large; flex-shrink:0 so flex never collapses a
   control below a tappable size; real pressed-state scale so nothing reads dead. */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target:active {
    scale: 0.97;
}
.tap-target-lg {
    min-width: 56px;
    min-height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target-lg:active {
    scale: 0.97;
}

/* ---------- screen root ----------
   Fills the safe area below the device notch/bars; top bar + stage stack in
   a column so the stage always gets "the rest" of the height, full width. */
.map-root {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
}

/* ---------- top quick-access HUD ----------
   An overlay strip OVER the pan/zoom stage (absolute, not a normal-flow row
   that pushes the map down) — translucent dark-glass tint so the map stays
   subtly visible through it, never an opaque black bar. Declared after the
   stage/panels/transition overlay in the map screen's markup (see
   MikeyApp.uxml) so it always paints above them — UI Toolkit hit-tests in
   reverse document order, so this also means a tap on the HUD is never
   swallowed by the map/panel beneath it, with no extra picking-mode work
   needed — but before the Settings modal, so an open modal still covers it.
   Visible on both the Japan and Okinawa map screens, >= 48px targets,
   Title Case text (never a wall of all-caps) — the previous Map's text was
   reported both unreadable on device and too "heavy black bar with
   individual button bubbles". */
.map-topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 84px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    background-color: rgba(11, 14, 17, 0.74);
    border-bottom-width: 1px;
    border-bottom-color: rgba(237, 230, 216, 0.12);
}
.map-topbar__nav {
    flex-direction: row;
    align-items: center;
}

/* Clean text navigation — deliberately no pill/capsule/bubble background per
   nav item. The button's own box stays a comfortable, larger-than-the-text
   touch target (>= 48px tall via .tap-target); only the label itself reads
   as a button. Generous inter-item spacing so this reads as premium
   navigation rather than a compressed toolbar; position:relative so the
   active item's brushstroke underline (".map-topbar__nav-btn-underline")
   can anchor to this box rather than the row. */
.map-topbar__nav-btn {
    position: relative;
    height: 100%;
    margin-right: 52px;
    padding: 0;
    min-width: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    align-items: center;
    justify-content: center;
}
.map-topbar__nav-btn-text {
    font-size: 29px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
    color: rgba(237, 230, 216, 0.72);
}
.map-topbar__nav-btn:hover .map-topbar__nav-btn-text {
    color: var(--bone);
}
.map-topbar__nav-btn--locked {
    opacity: 0.5;
}

/* The single active-section indicator: brighter text sitting in front of a
   layered crimson BACKLIGHT (see ".map-topbar__nav-btn-halo" below) plus a
   small painted brushstroke underline (".map-topbar__nav-btn-underline",
   added only inside the currently-active button's own markup per screen —
   see MikeyApp.uxml) — never a surrounding bubble, never a flat 2px CSS
   line. "Map" carries this statically on both map screens; "Profile" on
   Profile; "Techniques" on Techniques (the player is always somewhere in
   that flow while its HUD is visible).

   Deliberately NOT text-shadow: a glyph shadow outlines the letters
   themselves (a halo traced around each character), which read as a hard
   red outline rather than "soft light behind the word" no matter how the
   blur/alpha were tuned — several passes confirmed this is the wrong tool
   for the job, not a tuning problem. The halo below is real geometry
   (layered, low-alpha, increasingly-opaque-toward-center ellipses painted
   BEHIND the label — same technique already used for the radar polygon's
   glow) so it reads as atmospheric light, not letter outlines. */
.map-topbar__nav-btn--active .map-topbar__nav-btn-text {
    color: var(--bone);
}

/* Layered backlight behind the active label. Sized per word (roughly the
   word's width plus room to breathe) via the same per-label modifier
   pattern as the underline below. Ellipses (percentage border-radius, so
   width != height still yields fully-round edges — never a rectangle/pill
   with visible corners) at low, increasing-toward-center opacity fake a
   soft glow without a blur filter (UI Toolkit has none for arbitrary
   elements). Declared BEFORE the label in markup so it paints underneath
   it; ignores picking throughout so it never affects the button's hit
   target. */
.map-topbar__nav-btn-halo {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    height: 60px;
}
.map-topbar__nav-btn-halo--map {
    width: 88px;
}
.map-topbar__nav-btn-halo--profile {
    width: 140px;
}
.map-topbar__nav-btn-halo--techniques {
    width: 184px;
}
.map-topbar__nav-btn-halo__layer {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    border-radius: 50%;
    background-color: #C62828;
}
.map-topbar__nav-btn-halo__layer--outer {
    width: 100%;
    height: 100%;
    opacity: 0.05;
}
.map-topbar__nav-btn-halo__layer--middle {
    width: 72%;
    height: 72%;
    opacity: 0.1;
}
.map-topbar__nav-btn-halo__layer--inner {
    width: 46%;
    height: 46%;
    opacity: 0.16;
}

/* Small inked underline beneath the active label. NOT the Main-Menu
   brushstroke image: that asset's ink is stored as near-black RGB with an
   alpha mask (see Home.uss's un-tinted, opacity-only use of it), and
   "-unity-background-image-tint-color" is a per-pixel MULTIPLY — multiplying
   black by any tint color still yields black, so it can never actually read
   as red at any crop/scale. Built instead as 3 layered, slightly rotated
   solid-red bars (a "small dedicated layered brush-like VisualElement
   approximation") so it's unambiguously red and reads as painted/irregular
   rather than a flat single rule. Width is tuned per label so it reads as
   "about the width of the word", via percentage-sized strokes inside a
   per-label-width wrapper — never touching neighboring nav items
   (".map-topbar__nav-btn" already reserves >= 52px of margin). Every layer
   ignores picking so the underline never affects the button's hit target. */
.map-topbar__nav-btn-underline {
    position: absolute;
    left: 50%;
    bottom: -10px;
    height: 14px;
    translate: -50% 0;
}
.map-topbar__nav-btn-underline--map {
    width: 66px;
}
.map-topbar__nav-btn-underline--profile {
    width: 112px;
}
.map-topbar__nav-btn-underline--techniques {
    width: 152px;
}
.map-topbar__nav-btn-underline__stroke {
    position: absolute;
    left: 0;
    border-radius: 3px;
    background-color: #C62828;
}
.map-topbar__nav-btn-underline__stroke--a {
    top: 4px;
    width: 100%;
    height: 3px;
    opacity: 0.85;
    rotate: -1.2deg;
}
.map-topbar__nav-btn-underline__stroke--b {
    top: 7px;
    left: 8%;
    width: 78%;
    height: 2px;
    opacity: 0.55;
    rotate: 1.6deg;
}
.map-topbar__nav-btn-underline__stroke--c {
    top: 1px;
    left: 20%;
    width: 55%;
    height: 2px;
    opacity: 0.45;
    rotate: -2deg;
}

.map-topbar__right {
    flex-direction: row;
    align-items: center;
}
.map-topbar__status {
    flex-direction: column;
    align-items: flex-end;
    padding: 0 26px 0 22px;
    flex-shrink: 0;
}
/* Off-white primary text with a restrained red glow as the accent — never
   solid orange/red text. rgba matches --crimson (#C62828); see the active-nav
   glow comment above for why this is a literal rgba rather than var(). Bumped
   slightly stronger than before (8px/0.4 -> 12px/0.55) — still clearly
   "restrained metadata," but more clearly Mikey's red visual language. */
.map-topbar__level {
    font-size: 27px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: var(--bone);
    text-shadow: 0 0 12px rgba(198, 40, 40, 0.55);
}
.map-topbar__xp {
    font-size: 22px;
    color: var(--muted);
    margin-top: 2px;
}
.map-topbar__xp-bar {
    width: 92px;
    height: 3px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-top: 5px;
    overflow: hidden;
}
.map-topbar__xp-bar__fill {
    width: 64%;
    height: 100%;
    background-color: var(--crimson);
}

/* Settings: the one genuine icon button in the HUD. Uses the supplied
   settings_icon.png (a white gear silhouette with an alpha-only shape) as-is
   — it's already the exact off-white the old ring+dot glyph approximated, so
   no tint is needed. Replaces that placeholder glyph entirely. Transparent
   button background, matching the "clean text navigation" language rather
   than another button bubble; the icon dims slightly on hover/press. The
   button itself keeps the >=48px ".tap-target" touch target even though the
   visible icon is smaller. */
.map-topbar__settings-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}
.map-topbar__settings-icon {
    width: 32px;
    height: 32px;
    background-image: url("/Assets/UI/Media/Images/settings_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}
.map-topbar__settings-btn:hover .map-topbar__settings-icon {
    opacity: 0.75;
}

/* ---------- pan/zoom stage (shared by Japan + Okinawa) ----------
   Fills the whole map-root, edge to edge — the HUD now overlays on top of
   it (see ".map-topbar") rather than sitting in its own row above it, so
   the map is always the main, full-bleed/dominant focus, never squeezed by
   a permanently-reserved side column or top row, never a floating centered
   rectangle. overflow:hidden clips the pannable/zoomable canvas so it never
   paints outside the stage while panned/zoomed. */
.pan-stage {
    position: relative;
    flex-grow: 1;
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
}

/* The pannable/zoomable content layer: MapPanZoomController applies
   transform.position (pan) and transform.scale (zoom) to this element as a
   whole, so the artwork and its marker buttons — both its children — always
   move and scale together. Fills the stage exactly at the default (identity)
   transform; USS's default transform-origin (center) means zoom pivots
   around the stage's own center with no extra math. */
.pan-canvas {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Full-bleed cover-fit map art — never stretched, source bytes untouched;
   only the runtime display fit is cover, matching every other full-bleed
   media surface in this app (see theme.uss ".bg-media"). */
.map-canvas-art {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/UI/Media/Images/japan_map_final.jpg");
    -unity-background-scale-mode: scale-and-crop;
}
.okinawa-canvas-art {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/UI/Media/Images/okinawa_map_final.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

/* Subtle legibility darkening so marker labels and the top bar stay
   readable over bright regions of the map art. Ignores picking so it never
   blocks panning/zooming or marker taps underneath it. */
.pan-canvas-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 12, 0.16);
}

/* Invisible full-stage catcher, toggled to picking-mode:Position only while
   a detail panel/popup is open, so a tap "elsewhere" on the map closes it.
   Ignored (pass-through to markers/pan) whenever nothing is open. */
.map-outside-catcher {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ---------- Japan chapter markers ----------
   Map Pass 3A: the final supplied chapter_*.png marker art (its own painted
   pin/emblem, seal-red circle baked in) IS the badge now — no extra circle,
   dark backing plate or dot drawn around it. Position (left/top, percent)
   is applied at bind time by JapanMapController from
   MapMarkerLayout.Chapters, never hardcoded here — see that file to move a
   marker. The button's own box stays generously larger than the visible
   icon for a comfortable touch target (".tap-target-lg").

   Anchor: MapMarkerLayout coordinates are the pin's bottom TIP, not its
   center — "translate: -50% -100%" anchors this node's own bottom edge to
   that point. The label is ordered BEFORE the icon in the UXML (so it
   renders above it) specifically so the node's bottom edge coincides with
   the icon's bottom edge/pin tip, not the label's. */
.chapter-node {
    position: absolute;
    translate: -50% -100%;
    width: 132px;
    padding: 6px 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: column;
    align-items: center;
}
.chapter-node__label {
    margin-bottom: 6px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--bone);
    -unity-text-align: middle-center;
}
.chapter-node__icon {
    width: 66px;
    height: 66px;
    -unity-background-scale-mode: scale-to-fit;
}
.chapter-node__icon--okinawa {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Chapters/chapter_okinawa.png");
}
.chapter-node__icon--fukuoka {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Chapters/chapter_fukuoka.png");
}
.chapter-node__icon--hiroshima {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Chapters/chapter_hiroshima.png");
}
/* Restrained locked treatment: a light per-pixel multiply tint plus a
   modest opacity drop, never a lock glyph/giant lock painted over the
   unique emblem. Kept light enough that the emblem/symbol stays clearly
   readable against the map — this is a "locked" cue, not a fog-out. */
.chapter-node--locked .chapter-node__icon {
    opacity: 0.82;
    -unity-background-image-tint-color: rgb(210, 210, 210);
}
.chapter-node--locked .chapter-node__label {
    color: var(--muted);
}
.chapter-node--selected .chapter-node__icon {
    scale: 1.08;
}

/* ---------- Okinawa mission markers (LVL 0-6) ----------
   Same treatment as the chapter markers: the final supplied mission marker
   art (Special/Training/Fight/Boss Fight) is shown directly, smaller/denser
   since there are seven of them. Which icon shows is applied at bind time by
   OkinawaMapController from MapMarkerLayout.Missions (mission type is
   centralized there, never inferred from a static CSS class baked into the
   UXML). Position is likewise applied at bind time from the same
   centralized data.

   Anchor: same tip-anchor scheme as ".chapter-node" — "translate: -50%
   -100%" plus the label ordered before the icon in the UXML, so the node's
   bottom edge is the icon's bottom edge/pin tip. */
.level-node {
    position: absolute;
    translate: -50% -100%;
    width: 92px;
    padding: 6px 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: column;
    align-items: center;
}
.level-node__label {
    margin-bottom: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
    -unity-text-align: middle-center;
}
.level-node__icon {
    width: 54px;
    height: 54px;
    -unity-background-scale-mode: scale-to-fit;
}
.level-node__icon--special {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Missions/mission_lvl0.png");
}
.level-node__icon--training {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Missions/mission_training.png");
}
.level-node__icon--fight {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Missions/mission_fight.png");
}
.level-node__icon--boss-fight {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Missions/mission_boss.png");
}
.level-node--locked .level-node__icon {
    opacity: 0.82;
    -unity-background-image-tint-color: rgb(210, 210, 210);
}
.level-node--locked .level-node__label {
    color: var(--muted);
}
.level-node--selected .level-node__icon {
    scale: 1.1;
}

/* ---------- shared detail panel (chapter panel + level popup) ----------
   ONE overlay panel style used by both the Japan chapter panel and the
   Okinawa level popup. Slides in from the right OVER the map — the stage
   never shrinks/reflows to make room for it, and it never becomes a
   permanently-reserved column. Closed state is also picking-mode:Ignore
   (set by the owning controller) so it never intercepts stage taps while
   off-screen. */
.detail-panel {
    position: absolute;
    top: 84px; /* below the HUD band (.map-topbar), never fighting it for the same pixels */
    right: 0;
    bottom: 0;
    width: 48%;
    min-width: 400px;
    max-width: 540px;
    background-color: var(--base-2);
    border-left-width: 1px;
    border-left-color: var(--line);
    overflow: hidden;
    translate: 100% 0;
    transition-property: translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}
.detail-panel--open {
    translate: 0 0;
}

/* full-bleed preview video (chapter panel only) */
.detail-panel__video {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base-2);
    -unity-background-scale-mode: scale-and-crop;
}
.detail-panel__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
}
.detail-panel__overlay--1 {
    top: 0;
    background-color: rgba(11, 14, 17, 0.2);
}
.detail-panel__overlay--2 {
    height: 60%;
    background-color: rgba(11, 14, 17, 0.78);
}
.detail-panel__video-fallback {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--muted);
    background-color: var(--base-2);
}
.detail-panel__video-fallback--visible {
    display: flex;
}

.detail-panel__content {
    position: relative;
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 40px 48px 40px;
}
.detail-panel__eyebrow {
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--seal);
}
.detail-panel__title {
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
    margin-top: 8px;
}
.detail-panel__subtitle {
    font-size: 22px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 8px;
}
.detail-panel__desc {
    font-size: 20px;
    color: rgba(237, 230, 216, 0.85);
    white-space: normal;
    margin-top: 22px;
}
.detail-panel__meta {
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 18px;
}
.detail-panel__cta {
    align-self: flex-start;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 230px;
    height: 60px;
    margin-top: 32px;
    padding: 0 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--seal);
    background-color: var(--seal);
}
.detail-panel__cta:hover {
    background-color: #D95A3C;
}
.detail-panel__cta-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: var(--bone);
}
.detail-panel__cta--locked {
    opacity: 0.5;
    border-color: var(--line);
    background-color: var(--base-3);
}
/* Unlocked but no mission screen built yet (LVL2-6 pending real gameplay) —
   visually distinct from --locked: the mission genuinely IS available, there
   is just nowhere to route yet. */
.detail-panel__cta--soon {
    opacity: 0.7;
    border-color: var(--seal);
    background-color: var(--base-3);
}

/* ---------- Japan -> Okinawa ink-fade transition ----------
   A short, simple full-stage fade (never an elaborate cinematic system).
   Ignores picking; the controller guards re-entrancy in code rather than
   relying on this overlay to block input. */
.map-transition-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-in-out;
}
.map-transition-overlay--visible {
    opacity: 1;
}

/* ---------- Map Pass 3B decorative cloud overlay (corrected architecture) ----------
   The four sumi-e cloud PNGs, positioned/sized/rotated/opacity per
   MapCloudLayout — a child of ".pan-canvas" (the SAME transformed map
   artboard as the map art and markers, declared last inside it so it
   paints above them), never a viewport-fixed overlay, so clouds pan/zoom
   together with the map. Sized to exactly match the canvas's own box
   (inset:0, same pattern as ".map-canvas-art") so the cloud sprites'
   percentage left/top/width/height resolve against the same box
   MapCloudLayout.Apply's viewportWidth/viewportHeight argument measures.
   No overflow:hidden here (a cloud's Canva-authored bleed past the canvas
   edge is already clipped correctly by ".pan-stage"'s own overflow:hidden,
   the outer clip boundary that already governs the map art/markers at any
   pan/zoom state — an extra clip here would double-clip incorrectly once
   zoomed/panned). Opacity is per-cloud/per-state (see MapCloudLayout) —
   the CSS never hardcodes it. */
.map-cloud-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}
.map-cloud {
    position: absolute;
    -unity-background-scale-mode: stretch;
}
.map-cloud--left-01 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_left_01.png");
}
.map-cloud--left-02 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_left_02.png");
}
.map-cloud--right-01 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_right_01.png");
}
.map-cloud--bottom-01 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_bottom_01.png");
}

/* The map-local Settings modal (previously here) is retired: Settings is
   now the one shared modal for the whole app — see
   Assets/UI/Settings/Settings.uss and SettingsModalController. The
   "map-topbar-settings" / "okinawa-topbar-settings" buttons above are its
   open triggers; their own icon styling (".map-topbar__settings-*") is
   unrelated and stays here, unchanged. */
