/* ============================================================
   Map — mobile rebuild. The Map is now the primary in-game hub, with a
   two-tier hierarchy: the Japan world map ("map" screen) shows CHAPTER/CITY
   nodes (Okinawa unlocked, Fukuoka and Hiroshima locked — see
   MapMarkerLayout); tapping "ENTER CHAPTER" on Okinawa
   transitions into the Okinawa chapter map ("mapOkinawa" screen), which shows
   LEVEL nodes (LVL 0-5). Both screens share this one stylesheet and the same
   structural pattern:
     .*-topbar   -- Settings / Map / Techniques / Stats + Level/XP, always visible
     .pan-stage  -- full-viewport, overflow:hidden pan/zoom viewport
     .pan-canvas -- the pannable/zoomable layer MapPanZoomController transforms
     .detail-panel -- a right-side OVERLAY panel (never a permanently reserved
                      column) shown on marker selection, closed by tapping the
                      same marker again, another marker, or elsewhere on the stage
     .map-transition-overlay -- brief ink-fade used only for the Japan -> Okinawa
                                 chapter transition
   Palette custom properties (--ember, --seal, --bone, --base, …) cascade in
   from .mikey-app in theme.uss. Markers are real UI Toolkit elements (never
   baked into the map art), sized well above the ~44-48px minimum touch target
   for landscape Android. The old flattened single-image MVP composition (a
   single cropped route image, the permanent 61.7/38.3 split, the always-open
   Okinawa panel) is fully retired by this file — see JapanMapController /
   OkinawaMapController for the behavior that used to live in
   MapLevelPreviewController.
   ============================================================ */

/* ---------- kept background-media plumbing (untouched wiring) ----------
   BackgroundMediaController's "map" -> asia_map.jpeg binding stays in the
   scene so Title/Home/Combine's shared full-bleed background system is
   never touched; this screen simply never shows it — the pan/zoom canvas
   art below is the only visible map image. Same shared shape as every other
   screen with bound media (full-bleed layer + legibility scrim, outside
   .safe-area-content — see BackgroundMediaUxmlTests). */
.map-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
}
#map-bg-media {
    display: none;
}
.map-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 17, 0.32);
}

/* ---------- touch-target kit (Map-scoped) ----------
   >= 48x48 generic / >= 56x56 large; flex-shrink:0 so flex never collapses a
   control below a tappable size; real pressed-state scale so nothing reads dead. */
.tap-target {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target:active {
    scale: 0.97;
}
.tap-target-lg {
    min-width: 56px;
    min-height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.tap-target-lg:active {
    scale: 0.97;
}

/* ---------- screen root ----------
   Fills the safe area below the device notch/bars; top bar + stage stack in
   a column so the stage always gets "the rest" of the height, full width. */
.map-root {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
}

/* ---------- top quick-access HUD ----------
   An overlay strip OVER the pan/zoom stage (absolute, not a normal-flow row
   that pushes the map down) — translucent dark-glass tint so the map stays
   subtly visible through it, never an opaque black bar. Declared after the
   stage/panels/transition overlay in the map screen's markup (see
   MikeyApp.uxml) so it always paints above them — UI Toolkit hit-tests in
   reverse document order, so this also means a tap on the HUD is never
   swallowed by the map/panel beneath it, with no extra picking-mode work
   needed — but before the MODALS, so an open modal still covers it. That
   second half is not only about the shared Settings modal: on the Okinawa
   screen the level scroll (".scroll-panel", declared after this block in
   MikeyApp.uxml) is a modal too, and its dim is supposed to reach the HUD
   and make it untappable while a scroll is open. So "HUD above panels,
   below modals" is the whole rule — the Japan chapter panel is a panel and
   stays under this bar; the Okinawa scroll is a modal and sits over it.
   Visible on both the Japan and Okinawa map screens, >= 48px targets,
   Title Case text (never a wall of all-caps) — the previous Map's text was
   reported both unreadable on device and too "heavy black bar with
   individual button bubbles". */
.map-topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 84px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    background-color: rgba(11, 14, 17, 0.74);
    border-bottom-width: 1px;
    border-bottom-color: rgba(237, 230, 216, 0.12);
}
.map-topbar__nav {
    flex-direction: row;
    align-items: center;
}

/* Clean text navigation — deliberately no pill/capsule/bubble background per
   nav item. The button's own box stays a comfortable, larger-than-the-text
   touch target (>= 48px tall via .tap-target); only the label itself reads
   as a button. Generous inter-item spacing so this reads as premium
   navigation rather than a compressed toolbar; position:relative so the
   active item's brushstroke underline (".map-topbar__nav-btn-underline")
   can anchor to this box rather than the row. */
.map-topbar__nav-btn {
    position: relative;
    height: 100%;
    margin-right: 52px;
    padding: 0;
    min-width: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    align-items: center;
    justify-content: center;
}
.map-topbar__nav-btn-text {
    font-size: 29px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
    color: rgba(237, 230, 216, 0.72);
}
.map-topbar__nav-btn:hover .map-topbar__nav-btn-text {
    color: var(--bone);
}
.map-topbar__nav-btn--locked {
    opacity: 0.5;
}

/* The single active-section indicator: brighter text sitting in front of a
   layered crimson BACKLIGHT (see ".map-topbar__nav-btn-halo" below) plus a
   small painted brushstroke underline (".map-topbar__nav-btn-underline",
   added only inside the currently-active button's own markup per screen —
   see MikeyApp.uxml) — never a surrounding bubble, never a flat 2px CSS
   line. "Map" carries this statically on both map screens; "Profile" on
   Profile; "Techniques" on Techniques (the player is always somewhere in
   that flow while its HUD is visible).

   Deliberately NOT text-shadow: a glyph shadow outlines the letters
   themselves (a halo traced around each character), which read as a hard
   red outline rather than "soft light behind the word" no matter how the
   blur/alpha were tuned — several passes confirmed this is the wrong tool
   for the job, not a tuning problem. The halo below is real geometry
   (layered, low-alpha, increasingly-opaque-toward-center ellipses painted
   BEHIND the label — same technique already used for the radar polygon's
   glow) so it reads as atmospheric light, not letter outlines. */
.map-topbar__nav-btn--active .map-topbar__nav-btn-text {
    color: var(--bone);
}

/* Layered backlight behind the active label. Sized per word (roughly the
   word's width plus room to breathe) via the same per-label modifier
   pattern as the underline below. Ellipses (percentage border-radius, so
   width != height still yields fully-round edges — never a rectangle/pill
   with visible corners) at low, increasing-toward-center opacity fake a
   soft glow without a blur filter (UI Toolkit has none for arbitrary
   elements). Declared BEFORE the label in markup so it paints underneath
   it; ignores picking throughout so it never affects the button's hit
   target. */
.map-topbar__nav-btn-halo {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    height: 60px;
}
.map-topbar__nav-btn-halo--map {
    width: 88px;
}
.map-topbar__nav-btn-halo--profile {
    width: 140px;
}
.map-topbar__nav-btn-halo--techniques {
    width: 184px;
}
.map-topbar__nav-btn-halo__layer {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    border-radius: 50%;
    background-color: #C62828;
}
.map-topbar__nav-btn-halo__layer--outer {
    width: 100%;
    height: 100%;
    opacity: 0.05;
}
.map-topbar__nav-btn-halo__layer--middle {
    width: 72%;
    height: 72%;
    opacity: 0.1;
}
.map-topbar__nav-btn-halo__layer--inner {
    width: 46%;
    height: 46%;
    opacity: 0.16;
}

/* Small inked underline beneath the active label. NOT the Main-Menu
   brushstroke image: that asset's ink is stored as near-black RGB with an
   alpha mask (see Home.uss's un-tinted, opacity-only use of it), and
   "-unity-background-image-tint-color" is a per-pixel MULTIPLY — multiplying
   black by any tint color still yields black, so it can never actually read
   as red at any crop/scale. Built instead as 3 layered, slightly rotated
   solid-red bars (a "small dedicated layered brush-like VisualElement
   approximation") so it's unambiguously red and reads as painted/irregular
   rather than a flat single rule. Width is tuned per label so it reads as
   "about the width of the word", via percentage-sized strokes inside a
   per-label-width wrapper — never touching neighboring nav items
   (".map-topbar__nav-btn" already reserves >= 52px of margin). Every layer
   ignores picking so the underline never affects the button's hit target. */
.map-topbar__nav-btn-underline {
    position: absolute;
    left: 50%;
    bottom: -10px;
    height: 14px;
    translate: -50% 0;
}
.map-topbar__nav-btn-underline--map {
    width: 66px;
}
.map-topbar__nav-btn-underline--profile {
    width: 112px;
}
.map-topbar__nav-btn-underline--techniques {
    width: 152px;
}
.map-topbar__nav-btn-underline__stroke {
    position: absolute;
    left: 0;
    border-radius: 3px;
    background-color: #C62828;
}
.map-topbar__nav-btn-underline__stroke--a {
    top: 4px;
    width: 100%;
    height: 3px;
    opacity: 0.85;
    rotate: -1.2deg;
}
.map-topbar__nav-btn-underline__stroke--b {
    top: 7px;
    left: 8%;
    width: 78%;
    height: 2px;
    opacity: 0.55;
    rotate: 1.6deg;
}
.map-topbar__nav-btn-underline__stroke--c {
    top: 1px;
    left: 20%;
    width: 55%;
    height: 2px;
    opacity: 0.45;
    rotate: -2deg;
}

.map-topbar__right {
    flex-direction: row;
    align-items: center;
}
.map-topbar__status {
    flex-direction: column;
    align-items: flex-end;
    padding: 0 26px 0 22px;
    flex-shrink: 0;
}
/* Off-white primary text with a restrained red glow as the accent — never
   solid orange/red text. rgba matches --crimson (#C62828); see the active-nav
   glow comment above for why this is a literal rgba rather than var(). Bumped
   slightly stronger than before (8px/0.4 -> 12px/0.55) — still clearly
   "restrained metadata," but more clearly Mikey's red visual language. */
.map-topbar__level {
    font-size: 27px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: var(--bone);
    text-shadow: 0 0 12px rgba(198, 40, 40, 0.55);
}
.map-topbar__xp {
    font-size: 22px;
    color: var(--muted);
    margin-top: 2px;
}
.map-topbar__xp-bar {
    width: 92px;
    height: 3px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-top: 5px;
    overflow: hidden;
}
.map-topbar__xp-bar__fill {
    width: 64%;
    height: 100%;
    background-color: var(--crimson);
}

/* ---------- pan/zoom stage (shared by Japan + Okinawa) ----------
   Fills the whole map-root, edge to edge — the HUD now overlays on top of
   it (see ".map-topbar") rather than sitting in its own row above it, so
   the map is always the main, full-bleed/dominant focus, never squeezed by
   a permanently-reserved side column or top row, never a floating centered
   rectangle. overflow:hidden clips the pannable/zoomable canvas so it never
   paints outside the stage while panned/zoomed. */
.pan-stage {
    position: relative;
    flex-grow: 1;
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
}

/* Карта уходит вглубь, пока открыта панель главы: масштаб на самой сцене
   (одна трансформация на весь экран, не на каждом элементе) плюс более
   плотный скрим. Без этого панель читается как наклейка поверх картинки, а
   не как слой над сценой.
   Это НЕ то же самое, что MapPanZoomController's собственный pan/zoom —
   тот пишет translate/scale на ".pan-canvas" (ребёнке этой сцены) поверх
   layout-координат, которые сам же и читает через resolvedStyle.width/
   height; ни один из этих двух transform'ов не читает и не пишет
   resolvedStyle, так что маркеры (MapMarkerLayout, считающий свои позиции
   от resolvedStyle "-canvas") и клампы пан/зума видят прежние layout-
   размеры сцены независимо от того, насколько она визуально ужалась —
   scale тут чисто отрисовочный, как CSS transform, в layout не
   просачивается. Видимые по краям 0.75% на сторону — не пустота: под
   сценой на весь экран уже лежит ".map-bg" (var(--base), тот же
   тёмно-угольный, что и её собственный ".map-scrim"), так что обнажается
   тематически тот же тёмный фон, а не дыра.
   .pan-stage остаётся элементом, на котором висят обработчики пан/зума
   (MapPanZoomController.viewportElementName="map-stage") — они читают
   PointerEvent.position в координатах панели (экранных, не локальных),
   поэтому пока сцена анимирует масштаб, drag-дельта на долю процента не
   успевает точно совпасть с картинкой на экране. Но панель открыта, пока
   не будет тапа по сцене — а любой такой тап сначала закрывает панель
   через ".map-outside-catcher" (см. JapanMapController), так что реальный
   пан начинается уже во время отката scale к 1 назад, не во время
   стабильно открытой панели — переходное несовпадение исчезает вместе с
   самим переходом за 0.34s, а не накапливается. */
.pan-stage {
    transition-property: scale;
    transition-duration: 0.34s;
    transition-timing-function: ease-out;
}
.pan-stage--pushed {
    scale: 0.985;
}
.pan-canvas-scrim {
    transition-property: background-color;
    transition-duration: 0.34s;
    transition-timing-function: ease-out;
}
.pan-stage--pushed .pan-canvas-scrim {
    background-color: rgba(8, 10, 12, 0.32);
}

/* The pannable/zoomable content layer: MapPanZoomController applies
   transform.position (pan) and transform.scale (zoom) to this element as a
   whole, so the artwork and its marker buttons — both its children — always
   move and scale together. Fills the stage exactly at the default (identity)
   transform; USS's default transform-origin (center) means zoom pivots
   around the stage's own center with no extra math. */
.pan-canvas {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Full-bleed cover-fit map art — never stretched, source bytes untouched;
   only the runtime display fit is cover, matching every other full-bleed
   media surface in this app (see theme.uss ".bg-media"). */
.map-canvas-art {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/UI/Media/Images/japan_map_final.jpg");
    -unity-background-scale-mode: scale-and-crop;
}
.okinawa-canvas-art {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/UI/Media/Images/okinawa_map_final.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

/* Subtle legibility darkening so marker labels and the top bar stay
   readable over bright regions of the map art. Ignores picking so it never
   blocks panning/zooming or marker taps underneath it. */
.pan-canvas-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 12, 0.16);
}

/* Invisible full-stage catcher, toggled to picking-mode:Position only while
   a detail panel/popup is open, so a tap "elsewhere" on the map closes it.
   Ignored (pass-through to markers/pan) whenever nothing is open. */
.map-outside-catcher {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ---------- Japan chapter markers ----------
   Map Pass 3A: the final supplied chapter_*.png marker art (its own painted
   pin/emblem, seal-red circle baked in) IS the badge now — no extra circle,
   dark backing plate or dot drawn around it. Position (left/top, percent)
   is applied at bind time by JapanMapController from
   MapMarkerLayout.Chapters, never hardcoded here — see that file to move a
   marker. The button's own box stays generously larger than the visible
   icon for a comfortable touch target (".tap-target-lg").

   Anchor: MapMarkerLayout coordinates are the pin's bottom TIP, not its
   center — "translate: -50% -100%" anchors this node's own bottom edge to
   that point. The label is ordered BEFORE the icon in the UXML (so it
   renders above it) specifically so the node's bottom edge coincides with
   the icon's bottom edge/pin tip, not the label's. */
.chapter-node {
    position: absolute;
    translate: -50% -100%;
    width: 132px;
    padding: 6px 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: column;
    align-items: center;
}
.chapter-node__label {
    margin-bottom: 6px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--bone);
    -unity-text-align: middle-center;
}
/* transition-property здесь, а не в отдельном правиле под .chapter-node--selected:
   там уже есть свой width/height, второе правило на тот же селектор задвоило
   бы текст без пользы. Переход только на translate/scale — свойства, которыми
   владеет выбор (см. .chapter-node--selected .chapter-node__icon ниже); сама
   иконка, а не обёртка дыхания, потому что ту непрерывно пишет ambient
   инлайном, и USS там не победит. */
.chapter-node__icon {
    width: 66px;
    height: 66px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: translate, scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
/* Обёртка дыхания. Собственных визуальных свойств не имеет: существует
   ровно для того, чтобы ambient-слой писал непрерывный масштаб СЮДА, а
   USS-состояния (выбран/заблокирован) остались на иконке. Инлайн-стиль
   перебивает USS, поэтому делить одно свойство между ними нельзя. */
.chapter-node__breath {
    align-items: center;
    justify-content: center;
}

/* Тень под кончиком пина: отрывает маркер от бумаги. Эллипс, а не
   изображение — та же техника, что у ореола в топбаре, где блюра нет. */
.chapter-node__shadow {
    position: absolute;
    left: 50%;
    bottom: -5px;
    translate: -50% 0;
    width: 46px;
    height: 12px;
    border-radius: 50%;
    /* Цвет НЕПРОЗРАЧНЫЙ намеренно: видимой альфой владеет только inline
       opacity, которую пишет ambient. UI Toolkit перемножает opacity на
       альфу цвета, поэтому rgba(...,0.35) вместе с opacity 0.35 дал бы
       реальные 0.12 — тень была бы втрое бледнее задуманного, а её дыхание
       практически неразличимо. */
    background-color: rgb(0, 0, 0);
}
.chapter-node__icon--okinawa {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Chapters/chapter_okinawa.png");
}
.chapter-node__icon--fukuoka {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Chapters/chapter_fukuoka.png");
}
.chapter-node__icon--hiroshima {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Chapters/chapter_hiroshima.png");
}
/* Restrained locked treatment: a light per-pixel multiply tint plus a
   modest opacity drop, never a lock glyph/giant lock painted over the
   unique emblem. Kept light enough that the emblem/symbol stays clearly
   readable against the map — this is a "locked" cue, not a fog-out. */
.chapter-node--locked .chapter-node__icon {
    opacity: 0.82;
    -unity-background-image-tint-color: rgb(210, 210, 210);
}
.chapter-node--locked .chapter-node__label {
    color: var(--muted);
}
/* Выбранный маркер приподнимается, а его тень расходится и бледнеет —
   вместе это читается как «поднялся над картой». */
.chapter-node--selected .chapter-node__icon {
    translate: 0 -6px;
    scale: 1.10;
}
/* Заблокированный маркер не поднимается, даже если тоже получил класс
   выбора (SelectChapter вешает его безусловно — открывает панель с
   объяснением "заблокировано" и для locked тоже). Подъём читается как
   "выбрано, заходи" и спорит с дрожью отказа в тот же момент — сигналы
   противоречат друг другу. Комбинация двух классов на узле, а не :not():
   поддержка ограниченного набора селекторов в UI Toolkit непроверена, а
   два класса на одном элементе работают гарантированно. Специфичность
   компаунд-селектора выше, чем у одного класса ".chapter-node--selected",
   и вдобавок объявлено ПОСЛЕ него в файле — перебивает в любом случае. */
.chapter-node--locked.chapter-node--selected .chapter-node__icon {
    translate: 0 0;
    scale: 1;
}

/* ---------- Okinawa mission markers (LVL 0-8) ----------
   Same treatment as the chapter markers: the final supplied mission marker
   art (Special/Training/Fight/Boss Fight) is shown directly, smaller/denser
   since there are nine of them. Which icon shows is applied at bind time by
   OkinawaMapController from MapMarkerLayout.Missions (mission type is
   centralized there, never inferred from a static CSS class baked into the
   UXML). Position is likewise applied at bind time from the same
   centralized data.

   Anchor: same tip-anchor scheme as ".chapter-node" — "translate: -50%
   -100%" plus the label ordered before the icon in the UXML, so the node's
   bottom edge is the icon's bottom edge/pin tip. */
.level-node {
    position: absolute;
    translate: -50% -100%;
    width: 92px;
    padding: 6px 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: column;
    align-items: center;
}
.level-node__label {
    margin-bottom: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
    -unity-text-align: middle-center;
}
/* Симметрично .chapter-node__icon: transition-property на translate/scale
   прямо здесь, чтобы не задваивать селектор отдельным правилом ниже. */
.level-node__icon {
    width: 54px;
    height: 54px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: translate, scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
.level-node__breath {
    align-items: center;
    justify-content: center;
}
.level-node__shadow {
    position: absolute;
    left: 50%;
    bottom: -4px;
    translate: -50% 0;
    width: 36px;
    height: 10px;
    border-radius: 50%;
    /* Цвет НЕПРОЗРАЧНЫЙ намеренно: видимой альфой владеет только inline
       opacity, которую пишет ambient. UI Toolkit перемножает opacity на
       альфу цвета, поэтому rgba(...,0.35) вместе с opacity 0.35 дал бы
       реальные 0.12 — тень была бы втрое бледнее задуманного, а её дыхание
       практически неразличимо. */
    background-color: rgb(0, 0, 0);
}
.level-node__icon--special {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Missions/mission_lvl0.png");
}
.level-node__icon--training {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Missions/mission_training.png");
}
.level-node__icon--fight {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Missions/mission_fight.png");
}
.level-node__icon--boss-fight {
    background-image: url("/Assets/UI/Media/Images/Map/Markers/Missions/mission_boss.png");
}
.level-node--locked .level-node__icon {
    opacity: 0.82;
    -unity-background-image-tint-color: rgb(210, 210, 210);
}
.level-node--locked .level-node__label {
    color: var(--muted);
}
.level-node--selected .level-node__icon {
    translate: 0 -6px;
    scale: 1.10;
}
/* Симметрично .chapter-node--locked.chapter-node--selected выше. */
.level-node--locked.level-node--selected .level-node__icon {
    translate: 0 0;
    scale: 1;
}

/* ---------- tap ripple (chapter + level markers) ----------
   Кольцо расходится от кончика пина и гаснет при тапе — отклик «тап
   принят, вход состоялся» ТОЛЬКО у доступного маркера. У заблокированного
   входа не происходит: контроллеры карты (JapanMapController.SelectChapter,
   OkinawaMapController.SelectLevel) вызывают MapNodeFeedback.PlayRipple
   только когда узел не заблокирован — тем же признаком блокировки, которым
   решается дрожь отказа из задачи 10. Волна и дрожь НЕ играют вместе на
   одном тапе: если снова свести их вызовы в одно безусловное место,
   заблокированный маркер получит одновременно «нельзя» (дрожь) и «принято,
   засчитано» (волна) — два противоречащих сигнала. В покое прозрачность 0
   и масштаб мал, поэтому элемент ничего не стоит и (вместе с
   picking-mode="Ignore" в разметке) ничего не перехватывает.

   transition-property объявлено здесь, на базовом правиле, а не только
   под --rippling: оно действует ВСЕГДА, при любой записи opacity/scale,
   включая инлайн-прыжок в пиковое состояние из MapNodeFeedback.PlayRipple
   — поэтому этот прыжок там временно снимает переход, иначе сам скачок в
   пик тоже уехал бы эти 0.5с вместо мгновенного появления. */
.chapter-node__ripple,
.level-node__ripple {
    position: absolute;
    left: 50%;
    bottom: -6px;
    translate: -50% 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border-width: 2px;
    border-color: #C62828;
    opacity: 0;
    scale: 0.4;
    transition-property: opacity, scale;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
}
.chapter-node--rippling .chapter-node__ripple,
.level-node--rippling .level-node__ripple {
    opacity: 0;
    scale: 2.2;
}

/* ---------- shared detail panel (chapter panel + level popup) ----------
   ONE overlay panel style used by both the Japan chapter panel and the
   Okinawa level popup. Slides in from the right OVER the map — the stage
   never shrinks/reflows to make room for it, and it never becomes a
   permanently-reserved column. Closed state is also picking-mode:Ignore
   (set by the owning controller) so it never intercepts stage taps while
   off-screen. */
.detail-panel {
    position: absolute;
    top: 84px; /* below the HUD band (.map-topbar), never fighting it for the same pixels */
    right: 0;
    bottom: 0;
    width: 48%;
    min-width: 400px;
    max-width: 540px;
    background-color: var(--base-2);
    border-left-width: 1px;
    border-left-color: var(--line);
    overflow: hidden;
    translate: 100% 0;
    transition-property: translate;
    transition-duration: 0.25s;
    /* ease-out-back (не ease-out): панель — единственная вещь на этом
       экране, что физически прилетает, а не просто задвигается, и лёгкий
       перелёт продаёт это, не трогая длительность. Тот же easing уже
       прошёл проверку версии редактора в задаче 12 (".scroll-panel__paper"
       ниже), поэтому здесь он безопасен без повторной проверки парсера. */
    transition-timing-function: ease-out-back;
}
.detail-panel--open {
    translate: 0 0;
}

/* full-bleed preview video (chapter panel only) */
.detail-panel__video {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base-2);
    -unity-background-scale-mode: scale-and-crop;
}
.detail-panel__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
}
.detail-panel__overlay--1 {
    top: 0;
    background-color: rgba(11, 14, 17, 0.2);
}
.detail-panel__overlay--2 {
    height: 60%;
    background-color: rgba(11, 14, 17, 0.78);
}
.detail-panel__video-fallback {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--muted);
    background-color: var(--base-2);
}
.detail-panel__video-fallback--visible {
    display: flex;
}

.detail-panel__content {
    position: relative;
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 40px 48px 40px;
}
.detail-panel__eyebrow {
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--seal);
}
.detail-panel__title {
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--bone);
    margin-top: 8px;
}
.detail-panel__subtitle {
    font-size: 22px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 8px;
}
.detail-panel__desc {
    font-size: 20px;
    color: rgba(237, 230, 216, 0.85);
    white-space: normal;
    margin-top: 22px;
}
.detail-panel__meta {
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 18px;
}
.detail-panel__cta {
    align-self: flex-start;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 230px;
    height: 60px;
    margin-top: 32px;
    padding: 0 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--seal);
    background-color: var(--seal);
}
.detail-panel__cta:hover {
    background-color: #D95A3C;
}
.detail-panel__cta-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: var(--bone);
}
.detail-panel__cta--locked {
    opacity: 0.5;
    border-color: var(--line);
    background-color: var(--base-3);
}

/* ---------- свиток (попап уровня, Окинава) ----------
   СОБСТВЕННАЯ система, а НЕ ".detail-panel": попап уровня больше не делит
   стиль с панелью главы. Та осталась правой выезжающей шторкой, её блок
   выше по файлу трогать нельзя — на нём висят MapHudRedesignTests и
   JapanMapScreenUxmlTests, и любая правка там молча перекрасила бы Японию.
   Здесь — центрированная модалка-макимоно: верхний валик стоит на месте,
   бумага растёт вниз, нижний валик едет на её нижнем крае просто потому,
   что он следующий flex-ребёнок колонки.

   ОТМЕНЁННОЕ РЕШЕНИЕ, а не забытое. До этой задачи бумага раскрывалась
   смещением (translate) внутри контейнера с overflow:hidden — ровно
   затем, чтобы не трогать height, потому что height это полный проход
   лэйаута каждый кадр. Владелец продукта отменил то решение осознанно,
   ради точного совпадения с макетом: при translate краска едет вниз
   ВМЕСТЕ с бумагой, при height — стоит на месте, а бумага открывается
   из-под валика. Разница читается, и выбрана вторая. Цена принята и она
   ограничена: height анимирует РОВНО ОДИН элемент шириной 766px, все его
   дети спозиционированы абсолютно и в потоке не участвуют. Если кадр
   когда-нибудь станет дорогим — возвращать надо translate-вариант
   целиком (бумага и нижний валик одной едущей группой внутри клипующего
   контейнера), а не «оптимизировать» этот наполовину.

   Открытие и закрытие сознательно НЕ различены через ":not()": эта
   комбинация ловится живой ошибкой парсера USS в этой версии редактора
   ("Recursive pseudo classes are not supported"), см. ту же осторожность
   у ".chapter-node--locked.chapter-node--selected" выше. Вместо этого
   БАЗОВОЕ правило каждого элемента — это состояние ЗАКРЫТО, а более
   специфичный потомковый селектор ".scroll-panel--open X" перебивает его
   на состояние ОТКРЫТО. */
.scroll-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* Затемнение. Оно же — поверхность закрытия по тапу «мимо»: свиток
   накрывает весь экран, поэтому лежащий ПОД ним ".map-outside-catcher"
   Окинавы до тапа уже не достаёт. Обработчик тот же самый
   (OkinawaMapController.OnOutsideCatcherPointerDown) и pickingMode
   переключается тем же SetOutsideCatcherActive — одна механика на две
   поверхности, а не вторая копия логики закрытия. */
.scroll-panel__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 17, 0.9);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}
.scroll-panel--open .scroll-panel__backdrop {
    opacity: 1;
}

/* 840 — ширина ВАЛИКОВ. Бумага уже, 766: валики свисают на 37px с каждой
   стороны, и этот свес нарисован в самой картинке, это не отступ.
   Прозрачность колонки на ЗАКРЫТИИ уходит с задержкой 0.38s + 0.24s =
   0.62s, ровно за длительность сворачивания бумаги, чтобы свиток не
   растворился в воздухе раньше, чем свернулся. На ОТКРЫТИИ задержки нет:
   0.24s, свиток проявляется, пока разворачивается. */
.scroll-panel__column {
    width: 840px;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.24s;
    transition-delay: 0.38s;
    transition-timing-function: ease-out;
}
.scroll-panel--open .scroll-panel__column {
    opacity: 1;
    transition-delay: 0s;
}

/* Валики не тянутся никогда: у них своя коробка ровно 840x120, как
   нарезано. Отрицательные margin убирают шов между валиком и бумагой. */
.scroll-panel__roll {
    width: 840px;
    height: 120px;
    -unity-background-scale-mode: stretch-to-fill;
}
.scroll-panel__roll--top {
    margin-bottom: -2px;
    background-image: url("/Assets/UI/Media/Images/Map/Scroll/scroll-top.png");
}
.scroll-panel__roll--bottom {
    margin-top: -4px;
    background-image: url("/Assets/UI/Media/Images/Map/Scroll/scroll-bottom.png");
}

/* Бумага. Растяжение ТОЛЬКО по вертикали ("stretch", не "scale-to-fit":
   тот вписал бы текстуру с полями). overflow:hidden здесь несёт двойную
   службу — обрезает содержимое, пока свиток не развернулся, и он же
   гасит попадания по невидимой кнопке CTA в закрытом состоянии. */
.scroll-panel__paper {
    width: 766px;
    height: 0;
    overflow: hidden;
    background-image: url("/Assets/UI/Media/Images/Map/Scroll/scroll-center.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: height;
    transition-duration: 0.62s;
    transition-timing-function: ease-out-cubic;
}
.scroll-panel--open .scroll-panel__paper {
    height: 690px;
}
/* (0,3,0) против (0,2,0) выше — заблокированный свиток разворачивается
   короче, потому что говорить ему нечего: ни кнопки, ни метрик. */
.scroll-panel--open.scroll-panel--locked .scroll-panel__paper {
    height: 460px;
}

/* Подложка читаемости. У бумаги в текстуре есть тёмные потёки, и на них
   строки 22-23px проваливаются ниже контраста 3:1. Радиального градиента
   в USS нет, поэтому это одна плоская заливка по инструкции макета, а не
   мягкое пятно. Убирать её нельзя — она несёт контраст вместо
   mix-blend-mode:multiply, которого в UI Toolkit тоже нет. */
.scroll-panel__wash {
    position: absolute;
    left: 74px;
    right: 74px;
    top: 3%;
    bottom: 4%;
    background-color: rgba(244, 234, 214, 0.34);
}

/* Текстовый блок. Врезки — из макета: top = paperHeight*0.06 + 18,
   height = paperHeight*0.88 - 36, посчитано для обеих высот бумаги и
   зашито числами, чтобы не считать это в C# на каждое открытие. */
.scroll-panel__text {
    position: absolute;
    left: 84px;
    right: 78px;
    top: 59px;
    height: 571px;
    flex-direction: column;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}
.scroll-panel--locked .scroll-panel__text {
    top: 46px;
    height: 369px;
}
/* Текст проступает с задержкой 0.3s — на середине разворота бумаги, а не
   вместе с ней: сначала разворачивается свиток, потом на нём проступают
   чернила. На закрытии задержки нет (базовое правило выше), поэтому
   чернила уходят первыми, и бумага сворачивается уже пустой. */
.scroll-panel--open .scroll-panel__text {
    opacity: 1;
    transition-delay: 0.3s;
}

.scroll-panel__head {
    flex-direction: column;
    padding-right: 96px;
}
.scroll-panel__eyebrow {
    -unity-font-definition: url("/Assets/UI/Fonts/YujiMai-Latin.ttf");
    font-size: 19px;
    letter-spacing: 6px;
    color: #8A2A16;
}
.scroll-panel__title {
    -unity-font-definition: url("/Assets/UI/Fonts/YujiMai-Latin.ttf");
    font-size: 54px;
    color: #1E1409;
    margin-top: 4px;
    rotate: -0.5deg;
}
.scroll-panel__subtitle {
    -unity-font-definition: url("/Assets/UI/Fonts/YujiMai-Latin.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    color: #4A3520;
    margin-top: 4px;
}

/* Черта под шапкой: две линии с разным креном, чтобы читалась мазком, а
   не линейкой. Затухания к краю нет — градиентов в USS нет. */
.scroll-panel__rule {
    height: 2px;
    margin-top: 18px;
    background-color: rgba(42, 32, 24, 0.5);
    rotate: -0.12deg;
}
.scroll-panel__rule__echo {
    position: absolute;
    top: 3px;
    left: 0;
    width: 58%;
    height: 1px;
    background-color: rgba(42, 32, 24, 0.14);
    rotate: 0.16deg;
}

.scroll-panel__desc {
    -unity-font-definition: url("/Assets/UI/Fonts/ShipporiMincho-Latin.ttf");
    font-size: 23px;
    color: #2A1B10;
    white-space: normal;
    margin-top: 22px;
}

/* Строка требования — только у заблокированного уровня, прижата к низу
   текстового блока. Кнопки там нет вообще: приглушённой "LOCKED" макет
   не предусматривает, и это намеренно. */
.scroll-panel__requirement {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("/Assets/UI/Fonts/ShipporiMincho-Latin.ttf");
    font-size: 22px;
    letter-spacing: 1px;
    color: #3A2A1C;
    white-space: normal;
}
.scroll-panel--locked .scroll-panel__requirement {
    display: flex;
}

/* CTA — само слово над рисованным подчёркиванием, а не кнопка-плашка.
   Коробка прозрачна и без рамки; три полосы подчёркивания построены тем
   же приёмом, что ".map-topbar__nav-btn-underline__stroke--a/b/c" выше
   по файлу. Нижний padding 22px держит высоту попадания выше 48px при
   14px-полосе — тот же порог, что задаёт ".tap-target". */
.scroll-panel__cta {
    position: absolute;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 10px 6px 22px 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    transition-property: scale;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}
.scroll-panel--locked .scroll-panel__cta {
    display: none;
}
.scroll-panel__cta:hover {
    scale: 1.04;
}
/* Не дубликат ".tap-target:active" (та же 0.97, но объявлена в начале
   файла): нажатие почти всегда происходит С наведением, и тогда правило
   ":hover" прямо над этим — тоже (0,2,0), но объявленное позже — побило бы
   ту раннюю ":active", и кнопка на нажатии РАСТЯГИВАЛАСЬ бы вместо того,
   чтобы вдавиться. Это объявление идёт последним и выигрывает. */
.scroll-panel__cta:active {
    scale: 0.97;
}
.scroll-panel__cta-text {
    -unity-font-definition: url("/Assets/UI/Fonts/YujiMai-Latin.ttf");
    font-size: 44px;
    letter-spacing: 8px;
    color: #1E1409;
}
.scroll-panel__cta-underline {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 6px;
    height: 14px;
}
.scroll-panel__cta-underline__stroke {
    position: absolute;
    left: 0;
    border-radius: 3px;
    background-color: #8A2A16;
}
.scroll-panel__cta-underline__stroke--a {
    top: 4px;
    width: 100%;
    height: 4px;
    opacity: 0.85;
    rotate: -1.1deg;
}
.scroll-panel__cta-underline__stroke--b {
    top: 8px;
    left: 7%;
    width: 80%;
    height: 3px;
    opacity: 0.5;
    rotate: 1.4deg;
}
.scroll-panel__cta-underline__stroke--c {
    top: 1px;
    left: 18%;
    width: 56%;
    height: 2px;
    opacity: 0.4;
    rotate: -1.9deg;
}

/* Шнур поперёк бумаги — вместо CTA у заблокированного уровня.
   Вертикальный градиент шнура собран из плоских полос: градиентов в USS
   нет вовсе, повторяющейся штриховки «витья» тоже — макет сам называет
   этот запасной вариант. Свеса за края бумаги нет: бумага клипует
   (её overflow:hidden несёт разворот), поэтому шнур идёт ровно по её
   ширине. */
.scroll-panel__cord {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 96px;
    height: 150px;
}
.scroll-panel--locked .scroll-panel__cord {
    display: flex;
}
.scroll-panel__cord__strand {
    position: absolute;
    left: 0;
    right: 0;
    rotate: -0.7deg;
}
.scroll-panel__cord__strand--light {
    top: 0;
    height: 7px;
    background-color: #6B4526;
}
.scroll-panel__cord__strand--mid {
    top: 7px;
    height: 11px;
    background-color: #3E2716;
}
.scroll-panel__cord__strand--dark {
    top: 18px;
    height: 8px;
    background-color: #22140B;
}
.scroll-panel__cord__strand--lower-light {
    top: 60px;
    height: 7px;
    background-color: #5C3D22;
    opacity: 0.9;
    rotate: -0.5deg;
}
.scroll-panel__cord__strand--lower-dark {
    top: 67px;
    height: 7px;
    background-color: #22140B;
    opacity: 0.9;
    rotate: -0.5deg;
}

/* Каскад содержимого: общий для обеих панелей — свитка (уровня) и панели
   главы. Класс "detail-panel--revealed" висит всё время, пока панель
   открыта (ставится/снимается в OkinawaMapController и JapanMapController
   вместе с "detail-panel--open"), поэтому переход всегда успевает
   доиграть, а не срывается сменой класса на следующем кадре.
   Начальное скрытое состояние висит на ".detail-panel X", а НЕ на
   ".scroll-panel__paper X" — это и есть сама починка: у панели главы
   своей бумаги нет (она выезжает целиком, см. ".pan-stage--pushed" выше),
   а значит без этого её текст ничем не скрыт, и класс "revealed" просто
   включал бы уже видимое — правила были бы на месте, класс бы ставился,
   а каскада не было. ".detail-panel" — общий класс обеих панелей
   (корень свитка тоже несёт его, см. UXML "level-panel"), так что один
   список селекторов внизу покрывает содержимое любой из них без
   отдельного дублирования на "--scroll".
   ".detail-panel__meta" видит только панель главы (счётчик уровней под
   описанием) — свиток его не использует, но объявлен здесь же, а не в
   отдельном блоке, чтобы вся расстановка каскада жила в одном месте.
   Задержки одни и те же для обеих панелей, хотя открываются они по-разному
   (бумага разворачивается, панель главы выезжает): у свитка каскад
   стартует в середине разворота бумаги (0.20s из её 0.42s открытия —
   "в основном развернулась") и дотягивает до её конца; у панели главы
   тот же 0.20s приходится на самый хвост её более короткого 0.25s выезда,
   а хвост каскада (до 0.36s + 0.22s = 0.58s) доигрывает уже после того,
   как панель встала на место — то же ощущение "контент договаривает то,
   что начал контейнер", без отдельного набора чисел под вторую панель. */
.detail-panel .detail-panel__eyebrow,
.detail-panel .detail-panel__title,
.detail-panel .detail-panel__subtitle,
.detail-panel .detail-panel__desc,
.detail-panel .detail-panel__meta,
.detail-panel .detail-panel__cta {
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.detail-panel--revealed .detail-panel__eyebrow {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.20s;
}
.detail-panel--revealed .detail-panel__title {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.24s;
}
.detail-panel--revealed .detail-panel__subtitle {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.28s;
}
.detail-panel--revealed .detail-panel__desc {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.32s;
}
/* Между ".desc" и ".cta" в порядке чтения панели главы — свой слот, не
   переиспользует "0.28s" от ".subtitle": та задержка обязана остаться
   нетронутой ради свитка (single source of ".detail-panel__subtitle"
   правил и для него — трогать её означало бы трогать уже одобренный
   каскад свитка, что запрещено этой задачей). */
.detail-panel--revealed .detail-panel__meta {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.34s;
}
.detail-panel--revealed .detail-panel__cta {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.36s;
}
/* Приглушение заблокированной кнопки обязано пережить каскад. Голое
   ".detail-panel__cta--locked" выше по файлу имеет специфичность (0,1,0) и
   проигрывает правилу каскада прямо над этим комментарием — (0,2,0) и
   объявлено позже, — из-за чего КАЖДАЯ заблокированная панель главы (две из
   трёх) и КАЖДЫЙ заблокированный попап уровня (восемь из девяти) показывали
   свою неактивную кнопку в полную силу. Здесь та же (0,2,0), но объявлено
   ещё позже, поэтому выигрывает; объявлена ровно одна прозрачность, так что
   translate и задержка каскада продолжают приходить из правила выше, а не
   дублируются. Сторож — MapDetailPanelCascadeTests. */
.detail-panel--revealed .detail-panel__cta--locked {
    opacity: 0.5;
}

/* ---------- Japan -> Okinawa ink-fade transition ----------
   A short, simple full-stage fade (never an elaborate cinematic system).
   Ignores picking; the controller guards re-entrancy in code rather than
   relying on this overlay to block input. */
.map-transition-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--base);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-in-out;
}
.map-transition-overlay--visible {
    opacity: 1;
}

/* ---------- плывущий слой облаков ----------
   Семь элементов на экран, ребёнок той же ".pan-canvas", что арт, маркеры и
   рамка — значит, слой панится и зумится вместе с картой и клипуется
   существующим overflow:hidden у ".pan-stage". Своего клипа слой не заводит:
   двойной клип уже ломал композицию рамки.

   Объявляется в разметке ПОСЛЕ арта и ДО первого маркера, поэтому красится
   над картой, но под пинами. Облако, проходящее перед пином, задевало бы
   единственный интерактивный элемент экрана ради красоты.

   CSS-переходов здесь нет НИ ОДНОГО и быть не должно: всё движение считает
   тик MapWindLayer, а переход поверх посчитанного значения дал бы борьбу
   двух источников за одно свойство.

   opacity:0 — это состояние покоя. Тик снимает свой инлайн в
   StyleKeyword.Null, а Null отдаёт значение обратно сюда; без нуля здесь
   сброшенное облако вспыхнуло бы полностью непрозрачным. */
/* Плывущий слой скрыт целиком по решению владельца от 2026-08-24: облака на
   карте не подошли ни в каком виде — ни крупные облака рамки, ни этот
   еле заметный слой. Скрыт весь контейнер разом, а не семь его детей:
   один "display: none" вырезает из отрисовки всё поддерево.

   Элементы оставлены в дереве, чтобы решение было обратимым одной строкой.
   Вся машинерия слоя (MapWindMath, MapWindLayout, MapWindLayer и их тесты)
   тоже на месте и зелёная — она просто больше ничего не показывает. */
.map-wind-layer {
    position: absolute;
    display: none;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}
.map-wind {
    position: absolute;
    opacity: 0;
    -unity-background-scale-mode: stretch-to-fill;
}
.map-wind--left-01 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_left_01.png");
}
.map-wind--left-02 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_left_02.png");
}
.map-wind--right-01 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_right_01.png");
}
.map-wind--bottom-01 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_bottom_01.png");
}

/* ---------- Map Pass 3B decorative cloud overlay (corrected architecture) ----------
   The four sumi-e cloud PNGs, positioned/sized/rotated/opacity per
   MapCloudLayout — a child of ".pan-canvas" (the SAME transformed map
   artboard as the map art and markers, declared last inside it so it
   paints above them), never a viewport-fixed overlay, so clouds pan/zoom
   together with the map. Sized to exactly match the canvas's own box
   (inset:0, same pattern as ".map-canvas-art") so the cloud sprites'
   percentage left/top/width/height resolve against the same box
   MapCloudLayout.Apply's viewportWidth/viewportHeight argument measures.
   No overflow:hidden here (a cloud's Canva-authored bleed past the canvas
   edge is already clipped correctly by ".pan-stage"'s own overflow:hidden,
   the outer clip boundary that already governs the map art/markers at any
   pan/zoom state — an extra clip here would double-clip incorrectly once
   zoomed/panned). Opacity is per-cloud/per-state (see MapCloudLayout) —
   the CSS never hardcodes it. */
.map-cloud-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}
/* Четыре облака РАМКИ скрыты по решению владельца от 2026-08-24: крупные
   тёмные массы по углам не подошли композиции карты. Убран именно рисунок,
   а не элементы: контейнер "map-cloud-layer" и эти четыре ребёнка остаются
   в дереве, потому что на них завязано не только оформление —
   MapCloudTransitionController требует все восемь элементов ненулевыми,
   иначе переход между главами не привяжется вовсе, а picking-mode самого
   слоя работает блокировщиком ввода на время перехода.

   "display: none" вырезает их из цепочки отрисовки целиком, то есть это
   ещё и дешевле, чем прозрачность.

   Что при этом становится пустым: церемония открытия главы раздвигает
   этот слой в стороны (см. MapCeremonyController.PlayChapterUnlockRoutine)
   — двигать теперь нечего. Плывущий слой ".map-wind" не затронут. */
.map-cloud {
    position: absolute;
    display: none;
    -unity-background-scale-mode: stretch-to-fill;
}
.map-cloud--left-01 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_left_01.png");
}
.map-cloud--left-02 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_left_02.png");
}
.map-cloud--right-01 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_right_01.png");
}
.map-cloud--bottom-01 {
    background-image: url("/Assets/UI/Media/Images/Map/Clouds/cloud_bottom_01.png");
}

/* The map-local Settings modal (previously here) is retired: Settings is
   now the one shared modal for the whole app — see
   Assets/UI/Settings/Settings.uss and SettingsModalController. The
   "map-topbar-settings" / "okinawa-topbar-settings" buttons above are its
   open triggers; their own icon styling (".map-topbar__settings-*") is
   unrelated and stays here, unchanged. */

/* ---------- ink-wash при входе на карту ----------
   Пятна расходятся масштабом и гаснут прозрачностью — ни одного
   геометрического свойства.

   В покое "display: none", а НЕ "opacity: 0". Прозрачный элемент всё равно
   отдаёт геометрию в цепочку отрисовки: три пятна размером 90%x140% сцены со
   сплошным цветом фона — это около 3.8 экранов прозрачного overdraw поверх и
   без того нагруженной карты (арт, скрим экрана, четыре больших облака с
   альфой, скрим канваса), то есть ровно та цена, по которой из объёма
   выкинуты блик на море, зерно бумаги, лучи и виньетка. Из цепочки
   вырезает только "display: none". Класс "--playing" возвращает слой в
   отрисовку, и церемония добавляет класс растворения СЛЕДУЮЩИМ кадром (см.
   MapCeremonyController.PlayInkWashRoutine, "yield return null" между ними) —
   смена display и старт перехода в одном кадре как раз и не сработали бы. */
.map-inkwash {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
}
.map-inkwash--playing {
    display: flex;
}
.map-inkwash__blot {
    position: absolute;
    border-radius: 50%;
    background-color: var(--base);
    scale: 1;
    opacity: 1;
    transition-property: scale, opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}
.map-inkwash--dissolving .map-inkwash__blot {
    scale: 1.8;
    opacity: 0;
}
/* Клякса перехода между главами укорочена: играет 0.3с, а не 0.6с — иначе
   отставала бы от подмены экранов, которую маскирует. */
.map-inkwash--fast .map-inkwash__blot {
    transition-duration: 0.3s;
}
.map-inkwash__blot--a {
    left: -20%;
    top: -30%;
    width: 90%;
    height: 140%;
}
.map-inkwash__blot--b {
    left: 30%;
    top: -20%;
    width: 90%;
    height: 140%;
}
.map-inkwash__blot--c {
    left: 10%;
    top: 10%;
    width: 90%;
    height: 130%;
}

/* ---------- печать церемонии ----------
   Одна и та же печать используется и для разблокировки главы, и для штампа
   «пройдено» на маркере уровня — разница только в том, кто её вызвал. */
.map-seal {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border-width: 6px;
    border-color: var(--seal);
    opacity: 0;
    scale: 1.7;
    transition-property: scale, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}
.map-seal--stamped {
    opacity: 1;
    scale: 1;
}
