# ============================================================
# Unity .gitignore — keeps auto-generated/local files out of Git.
# Only source (Assets/, Packages/, ProjectSettings/) is shared.
# ============================================================

# Unity-generated folders (rebuilt locally on each machine)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta files MUST be kept (only ignored if their asset is ignored)
!/[Aa]ssets/**/*.meta

# IDE / solution files (regenerated by Unity)
.vs/
.vsconfig
.idea/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Crash / build artifacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Addressables build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS clutter
.DS_Store
Thumbs.db
